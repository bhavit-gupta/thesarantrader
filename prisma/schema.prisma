/**
 * ============================================================================
 * PRISMA SCHEMA - TheSaranTrader Application Database
 * ============================================================================
 * PURPOSE:
 * Defines the complete data model for the online trading education platform.
 * Includes user management, course content, social features, payments, and chat.
 * DATABASE: MongoDB
 * USED BY: Node.js/Express backend via Prisma ORM
 * KEY MODELS:
 * - User: Authentication & profile data
 * - Course: Course listings and metadata
 * - CourseVideo: Video content for each course
 * - Testimonial: User reviews (pending/approved)
 * - CommunityPost: Forum posts with comments
 * - ChatMessage: Real-time chat in course rooms
 * - Purchase: Payment tracking and verification
 * - Session: Express session storage
 * RELATIONSHIPS:
 * - Users purchase Courses (via purchasedCourseIds)
 * - Users create Testimonials, Posts, Comments, Messages
 * - Courses have Videos
 * - Posts have nested Comments
 * INDEXING:
 * Indexes are added on frequently queried fields to optimize performance:
 * - User: indexed on email for fast login lookups
 * - CommunityPost: indexed on createdAt (for feed sorting), userId (for user posts)
 * - ChatMessage: indexed on (courseId, timestamp) for chat history, userId for user messages
 * - Purchase: indexed on (userId, courseId, status) for lookups
 * - Testimonial: indexed on userId for user testimonials
 * - CommunityLike: unique constraint on (postId, userId) to prevent duplicates
 * - Session: indexed on expiresAt for TTL cleanup
 * ENUMS:
 * - UserRole: USER, ADMIN - defines user access levels
 * - PurchaseStatus: PENDING, COMPLETED, REJECTED - payment verification states
 * - TestimonialStatus: PENDING, APPROVED, REJECTED - moderation states
 * - PaymentMethod: GATEWAY, MANUAL - payment types
 * - TestimonialUserRole: user, TRADER, INVESTOR - testimonial display roles
 * SOFT DELETE:
 * - User and Course models have deletedAt field for soft delete support
 * - Preserves data for audit trail and recovery
 */

// ============================================================================
// PRISMA GENERATOR & DATA SOURCE CONFIGURATION
// ============================================================================

// Prisma Client: JavaScript/TypeScript ORM client
// Generates type-safe database client automatically
generator client {
  provider = "prisma-client-js"
}

// Data source configuration - MongoDB cloud database
// Connection string from .env file (DATABASE_URL)
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS - Type-safe status and role definitions
// ============================================================================

/**
 * UserRole Enum - Defines user access levels
 *  Added enum to enforce valid role values at schema level
 * Values:
 * - USER: Regular user/learner (default)
 * - ADMIN: Instructor/administrator with elevated privileges
 */
enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
}

/**
 * PurchaseStatus Enum - Payment verification states
 *  Added enum to enforce valid purchase status values
 * Values:
 * - PENDING: Awaiting admin review (manual payment)
 * - COMPLETED: Payment verified, user enrolled
 * - REJECTED: Payment rejected, user can re-upload proof
 */
enum PurchaseStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
}

/**
 * TestimonialStatus Enum - Moderation workflow states
 *  Added enum to enforce valid testimonial status values
 * Values:
 * - PENDING: Submitted, awaiting admin review
 * - APPROVED: Admin approved, visible to public
 * - REJECTED: Admin rejected, hidden from public
 */
enum TestimonialStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

/**
 * PaymentMethod Enum - How payment was made
 *  Added enum to validate payment method values
 * Values:
 * - GATEWAY: Automatic payment via Razorpay/Stripe
 * - MANUAL: User uploaded screenshot for verification
 */
enum PaymentMethod {
  GATEWAY @map("gateway")
  MANUAL  @map("manual")
}

/**
 * TestimonialUserRole Enum - Display role on testimonials
 *  Added enum to validate testimonial userRole values
 * Values:
 * - user: Learning user
 * - TRADER: Active trader
 * - INVESTOR: Investment-focused user
 */
enum TestimonialUserRole {
  user     @map("user")
  TRADER   @map("trader")
  INVESTOR @map("investor")
}

// ============================================================================
// USER AUTHENTICATION & PROFILE MODEL
// ============================================================================

/**


 * User Model - Stores all user account information
 * FIELDS:
 * - id: Unique MongoDB ObjectId (automatically generated)
 * - username: Login username (must be unique, cannot reuse)
 * - email: Login email (must be unique, verified for registration)
 * - phone: Contact phone number (must be unique)
 * - password: Hashed password (NEVER store plaintext)
 * NOTE:  Password length validation enforced at application level
 * - name: Full name (optional)
 * - role: User type - USER (user) or ADMIN (instructor/admin)
 * NOTE:  Uses UserRole enum for schema-level validation
 * - state & city: User location (for demographic tracking)
 * - currentSessionId: Device/session ID for single-session enforcement
 * (prevents login from multiple devices simultaneously)
 * - purchasedCourseIds: Array of Course IDs user has purchased/enrolled in
 * NOTE:  Deduplication enforced at application level
 * - deletedAt: Soft delete timestamp (null = active, set = deleted)
 * NOTE:  Added for soft delete support
 * - createdAt: Account creation timestamp (auto-set)
 * - updatedAt: Last profile update timestamp (auto-updated)
 * UNIQUENESS CONSTRAINTS:
 * Each user must have unique username, email, and phone to prevent duplicates
 * INDEXES:
 * - email: Fast login lookups 
 * USAGE:
 * - Authentication: Login with username/email/phone + password
 * - Profile: Store user metadata and location
 * - Enrollment: Track which courses user has purchased
 * - Sessions: Enforce single-device login policy
 */
model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  username           String    @unique
  email              String    @unique
  phone              String    @unique
  password           String //  Length validation at app level (bcrypt hashes are 60 chars)
  name               String?
  role               UserRole  @default(USER) //  Enum for valid roles
  state              String? // User's state/region
  city               String? // User's city
  currentSessionId   String? // Current device session ID (enforces single login per device)
  purchasedCourseIds String[]  @db.ObjectId //  Deduplication at app level
  deletedAt          DateTime? //  Soft delete timestamp (null = active)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================================================
// COURSE CONTENT MODELS
// ============================================================================

/**
 * Course Model - Stores course listings and metadata
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - title: Course name displayed to users
 * - description: Course overview/summary
 * - price: Current selling price (in rupees)
 * NOTE:  Non-negative validation enforced at application level
 * - originalPrice: Original price (for discount display)
 * - users: Count of enrolled users
 * NOTE:  Non-negative validation enforced at application level
 * - badge: Optional badge label (e.g., "Bestseller", "New")
 * NOTE:  Sanitization enforced at application level (XSS prevention)
 * - badgeColor: Badge background color (Tailwind class)
 * - icon: Emoji or icon representing course topic
 * NOTE:  Sanitization enforced at application level
 * - iconBg: Background color for icon container
 * - iconColor: Icon text color
 * - demoVideoUrl: YouTube link for course preview video
 * - zoomMeetingId: Zoom Meeting ID (numeric string)
 * - zoomPassword: Zoom Meeting Password/Passcode
 * - isLive: Boolean flag - is the course currently broadcasting live?

 * - lastLiveStartedAt: Timestamp when last live session started
 * - startDate: When course content becomes available
 * - endDate: When course access expires
 * NOTE:  Date logic (endDate >= startDate) validated at application level
 * - enrollmentDeadline: Last day users can enroll (after this: no new enrollments)
 * - deletedAt: Soft delete timestamp (null = active, set = deleted)
 * NOTE:  Added for soft delete support
 * - createdAt: When course was created
 * - updatedAt: Last modification timestamp
 * DISPLAY USAGE:
 * Course cards show: icon, title, description, price, dates, users
 * Enrollment page shows: full description, video, dates, enrollment button
 * Admin dashboard: edit form with all fields, toggle live status
 */
model Course {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  price              Int // In rupees (₹) -  App-level validation: >= 0
  originalPrice      Int // For displaying discount percentage
  users              Int       @default(0) @map("users") //  App-level validation: >= 0
  badge              String? // e.g., "Bestseller" -  Sanitized at app level
  badgeColor         String? // e.g., "blue", "red"
  icon               String? // Emoji (📚, 📊, etc.) -  Sanitized at app level
  iconBg             String? // Tailwind bg color class
  iconColor          String? // Tailwind text color class
  demoVideoUrl       String? // YouTube link for preview
  zoomMeetingId      String? // Zoom Meeting ID
  zoomPassword       String? // Zoom Meeting Password
  isLive             Boolean   @default(false) // Currently broadcasting?
  lastLiveStartedAt  DateTime? // When did current live session start?
  startDate          DateTime? // Course availability start
  endDate            DateTime? // Course availability end -  App-level validation
  enrollmentDeadline DateTime? // Last day to enroll (after this: Enrollment Closed)
  level              String?   // [New] Course categorization level
  dailyLiveTime      String?   // [New] Daily time for live class (Admin only)
  thumbnailUrl       String?   // [New] Main banner image for the course card
  isPublished        Boolean   @default(true) // [New] Show/Hide course from users
  isPromoted         Boolean   @default(false) // [New] Featured/Promoted status
  deletedAt          DateTime? //  Soft delete timestamp (null = active)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([deletedAt]) // Optimize soft-delete filtered queries
}

/**
 * CourseVideo Model - Individual video lessons for a course
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - courseId: Reference to parent Course
 * - title: Video lesson title
 * - description: Video content description
 * - youtubeUrl: YouTube video URL (embedded or linked)
 * - order: Display order in course curriculum (1, 2, 3...)
 * - createdAt: When video was added
 * - updatedAt: Last modification
 * RELATIONSHIP:
 * Multiple videos belong to one course (one-to-many)
 * Videos are displayed in order on user course page
 * UNIQUE CONSTRAINT:
 *  Each video must have unique order within its course
 * Prevents duplicate ordering ambiguity
 * FOREIGN KEY:
 *  courseId validated at application level (MongoDB/Prisma no FK support)
 * USAGE:
 * - Dashboard: Show enrolled users the video content
 * - Admin: Add/edit/delete course videos
 * - Learning: users watch videos in course after enrollment
/**
 * CourseFolder Model - Organization units for course content
 * RELATIONSHIP: Course ||--o{ CourseFolder
 */
model CourseFolder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  courseId  String   @db.ObjectId
  parentId  String?  @db.ObjectId // For nested folders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources CourseResource[]
}

enum ResourceType {
  VIDEO
  IMAGE
  DOCUMENT
}

/**
 * CourseResource Model - Individual curriculum items (Videos, Images, Docs)
 * RELATIONSHIP: Folder ||--o{ CourseResource
 */
model CourseResource {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         ResourceType
  url          String?      // For external links (e.g. YouTube)
  path         String?      // For local uploaded files (/uploads/resources/...)
  thumbnailUrl String?      // Optional thumbnail for the resource
  description  String?
  folderId     String       @db.ObjectId
  courseId     String       @db.ObjectId
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  folder       CourseFolder @relation(fields: [folderId], references: [id])
}

// ============================================================================
// SOCIAL FEATURES MODELS
// ============================================================================

/**
 * Testimonial Model - User reviews and ratings for the platform
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - userId: Reference to User who submitted testimonial
 * - userName: User's display name (cached for performance)
 * - userRole: User's role (user, Trader, etc.)
 * - message: The testimonial text (review content)
 * - rating: Star rating (1-5)
 * - status: Moderation status
 * * "pending": Awaiting admin review (hidden from public)
 * * APPROVED: Admin approved (visible on homepage & testimonials page)
 * * REJECTED: Admin rejected (hidden from public)
 * - submittedAt: When user submitted the testimonial
 * - reviewedAt: When admin approved/rejected it (null if pending)
 * WORKFLOW:
 * 1. User submits testimonial on dashboard
 * 2. Status set to PENDING (hidden)
 * 3. Admin reviews on admin panel
 * 4. Admin clicks approve → status = APPROVED (visible everywhere)
 * 5. Or admin clicks reject → status = REJECTED (hidden)
 * DISPLAY:
 * - Homepage: Show 5 most recent approved testimonials
 * - Testimonials page: Show ALL approved testimonials
 * - Dashboard: Show user's own testimonials (all statuses)
 * - Admin: Show all testimonials with status badges
 * INDEXES:
 *  userId indexed for fast user testimonial lookups
 * ENUMS:
 *  status uses TestimonialStatus enum
 *  userRole uses TestimonialUserRole enum
 * NOTES:
 *  Audit trail: reviewedAt tracks when status changed
 *  userName cached - sync at application level if user changes name
 */
model Testimonial {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  userId      String            @db.ObjectId // FK to User -  App-level validation
  userName    String //  Cached username - sync at app level
  userRole    String            @default("User") // Allowed to be any string now
  message     String // The review text
  rating      Int // 1-5 stars -  App-level range validation
  status      TestimonialStatus @default(PENDING) //  Enum for valid statuses
  isFeatured  Boolean           @default(false) // [New] Featured on homepage and pinned to top
  submittedAt DateTime          @default(now()) // When user submitted
  reviewedAt  DateTime? //  When admin approved/rejected

  @@index([status, submittedAt(sort: Desc)]) // Support admin moderation and public feeds
  @@index([userId]) //  Fast user testimonial lookups
}

/**
 * CommunityPost Model - Forum posts in community section
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - userId: Reference to User who created post
 * - userName: User's display name (cached)
 * - title: Post title (optional)
 * - content: Post text content (1000 char limit)
 * - imageUrl: Optional image attached to post
 * - likes: Total like count
 * - likedBy: Array of User IDs who liked (used to check if current user liked)
 * - comments: Nested array of Comment objects (denormalized for performance)
 * NOTE:  Large comment volumes may hit 16MB limit - consider pagination
 * - createdAt: Post creation timestamp
 * - updatedAt: Last edit or comment
 * INDEXES:
 * - createdAt: Fast feed sorting (newest first)
 * - userId:  Fast user's posts lookup
 * NESTED TYPE:
 * Comment object (embedded in post):
 * - id: Unique comment ID (UUID)
 * - userId: Who commented
 * - userName: Their display name
 * - content: Comment text
 * - createdAt: Comment timestamp
 * NOTES:
 *  content length validation (1000 chars) enforced at application level
 *  likedBy array may grow large - monitor popular posts
 *  userName cached - sync at application level if user changes name
 * USAGE:
 * - Community page: Load posts sorted by newest first
 * - Like button: Add/remove userId from likedBy array
 * - Comments: Add/remove from comments array
 * - Feed refresh: Poll every 30 seconds for new posts
 */
model CommunityPost {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId // FK to User -  App-level validation
  userName  String //  Cached for performance - sync at app level
  title     String? // Optional post title
  content   String //  App-level validation: max 1000 chars
  imageUrl  String? // Optional attached image
  likes     Int       @default(0) // Like count
  likedBy   String[]  @db.ObjectId //  May grow large - monitor
  comments  Comment[] //  Nested comments - paginate if needed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt]) // Fast feed sorting (newest first)
  @@index([userId]) //  Fast user's posts lookup
}

/**
 * Comment Type (Embedded in CommunityPost)
 * ATTRIBUTES:
 * - id: Unique comment ID (UUID - different from MongoDB ObjectId)
 * - userId: Who wrote the comment
 * - userName: Commenter's display name
 * - content: Comment text
 * - createdAt: When comment was posted
 * WHY EMBEDDED?
 * Comments are always accessed with their parent post, so embedding is
 * more efficient than storing in separate collection. Reduces database queries.
 * LIMITATION:
 * Maximum 16MB per document, but should be sufficient for reasonable comment volume
 */
type Comment {
  id        String   @default(uuid()) // Unique comment ID
  userId    String   @db.ObjectId // Foreign key to User
  userName  String // Commenter's name
  content   String // Comment text
  status    String   @default("APPROVED") // Comment moderation status
  createdAt DateTime @default(now())
}

/**
 * ChatMessage Model - Real-time chat in course rooms
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - courseId: Which course's chat room
 * - userId: Who sent the message
 * - userName: Sender's display name (cached)
 * - message: Message content
 * - imageUrl: Optional image attachment
 * - timestamp: When message was sent
 * INDEXES:
 * - (courseId, timestamp): Fast lookup of messages in a course by time
 * - userId:  Fast lookup of user's messages
 * POLLING LOGIC:
 * Client polls with: GET /api/chat/:courseId/messages?after=1708345600000
 * Server returns only messages where timestamp > 'after' value
 * This minimizes bandwidth and improves performance
 * NOTES:
 *  courseId/userId validated at application level
 *  userName cached - sync at application level if user changes name
 * USAGE:
 * - Dashboard: Load chat for enrolled course
 * - Message history: Get all messages in course (limit 100)
 * - Live chat: Get only new messages (smart polling every 3 sec)
 * - Image sharing: Store uploaded image URL in imageUrl field
 */
model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String   @db.ObjectId // FK to Course -  App-level validation
  userId    String   @db.ObjectId // FK to User -  App-level validation
  userName  String //  Sender's name (cached) - sync at app level
  message   String // Message content
  imageUrl  String? // Optional image attachment
  timestamp DateTime @default(now())

  @@index([courseId, timestamp]) // Fast retrieval by course and time
  @@index([userId]) //  Fast user's messages lookup
}

/**
 * ChatReadStatus Model - Tracks when a user last viewed a specific course chat
 * Used to calculate unread message counts in the chat directory.
 */
model ChatReadStatus {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  courseId   String   @db.ObjectId
  lastReadAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

// ============================================================================
// COMMERCE & PAYMENTS MODELS
// ============================================================================

/**
 * Purchase Model - Tracks all course enrollments and payment verification
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - userId: User making the purchase
 * - courseId: Course being purchased
 * - amount: Price paid (in rupees)
 * - transactionId: Payment gateway transaction ID (for gateway payments)
 * - paymentMethod: How was it paid
 * * "gateway": Razorpay/Stripe automatic payment
 * * "manual": User uploaded payment proof screenshot
 * - screenshotUrl: URL to payment proof image (for manual verification)
 * - status: Payment verification status
 * * "pending": Awaiting admin review of screenshot
 * * "completed": Payment verified, user enrolled in course
 * * REJECTED: Admin rejected screenshot, user can re-upload
 * - rejectionReason: Why admin rejected (shown to user)
 * - date: When purchase was created
 * WORKFLOW:
 * 1. User clicks "Enroll Now"
 * 2. Two payment options:
 * a) Pay via gateway → COMPLETED immediately
 * b) Manual: Show QR code, user uploads screenshot → PENDING
 * 3. Admin reviews pending purchases
 * 4. Admin approves → status = COMPLETED (user sees "Enrolled")
 * OR rejects → status = REJECTED (user can re-upload)
 * 5. Once completed, user added to course content
 * INDEXES:
 * Composite index on (userId, courseId, status) for fast lookups:
 * - Get user's purchase status for a course
 * - Get all pending purchases for admin review
 * ENUMS:
 *  status uses PurchaseStatus enum
 *  paymentMethod uses PaymentMethod enum
 * NOTES:
 *  userId/courseId validated at application level
 *  amount validated as non-negative at application level
 *  Audit trail: date tracks when purchase was created
 *  Uniqueness on userId+courseId should be checked at application level
 * ENROLLMENT LOGIC:
 * A user is "enrolled" if:
 * - Purchase record exists AND
 * - status = COMPLETED (verified or auto-approved)
 */
model Purchase {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @db.ObjectId // FK to User -  App-level validation
  courseId        String         @db.ObjectId // FK to Course -  App-level validation
  amount          Int // Price in rupees -  App-level validation: >= 0
  transactionId   String? // Payment gateway transaction ID
  paymentMethod   PaymentMethod  @default(GATEWAY) //  Enum for valid methods
  screenshotUrl   String? // Uploaded payment proof image URL
  status          PurchaseStatus @default(PENDING) //  Enum for valid statuses
  rejectionReason String? // Why was it rejected (shown to user)
  date            DateTime       @default(now())

  // Fast lookup by user, course, and status
  @@index([status, date(sort: Desc)]) // Support admin dashboard verification feed
  @@index([userId, courseId, status])
}

/**
 * Expense Model - Used to track business expenses that count against revenue
 */
model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  amount      Int      // Enforced as positive int at app level
  description String   // What the expense was for
  date        DateTime @default(now())
}

/**
 * CommunityLike Model - Tracks who liked which posts
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - postId: Which post was liked
 * - userId: Who liked it
 * - createdAt: When they liked it
 * UNIQUE CONSTRAINT:
 * Only one like per user per post (enforced by unique index on postId+userId)
 * Prevents user from liking the same post twice
 * WHY SEPARATE TABLE?
 * Could store likes as array in CommunityPost (likedBy), but:
 * - Separate table allows efficient queries: "Did user X like post Y?"
 * - Cleaner separation of concerns
 * - Easier to delete old likes
 * USAGE:
 * - Like button: Create new CommunityLike record
 * - Unlike button: Delete the CommunityLike record
 * - Like count: Count records where postId = X
 * - User liked?: Query if CommunityLike exists for (postId, userId)
 * NOTE:
 * Also track in CommunityPost.likedBy array (denormalized) for quick
 * client-side checks without database query
 */
model CommunityLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId // FK to CommunityPost -  App-level validation
  userId    String   @db.ObjectId // FK to User -  App-level validation
  createdAt DateTime @default(now())

  // Prevent duplicate likes: user can only like a post once
  @@unique([postId, userId])
}

/**
 * Session Model - Express session storage (for authentication)
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - sid: Session ID (unique identifier for user session)
 * - data: Serialized session data (JSON string with user info)
 * NOTE:  Using String for serialized JSON - native JSON type not supported
 * - expiresAt: When the session expires
 * HOW IT WORKS:
 * When user logs in:
 * 1. Express creates a session
 * 2. Session ID stored in browser cookie
 * 3. Session data stored in this table
 * 4. On each request, Express validates session cookie against this table
 * SINGLE-SESSION ENFORCEMENT:
 * When user logs in from a new device:
 * 1. Check if User.currentSessionId differs from incoming session
 * 2. If different: Invalidate old session by deleting from this table
 * 3. User logged out on old device
 * INDEXES:
 * - sid:  Explicit index for fast session lookups (also @unique)
 * - expiresAt:  TTL index for automatic cleanup of expired sessions
 * NOTE: Configure MongoDB TTL at database level with expireAfterSeconds: 0
 * AUTO-DELETE:
 * MongoDB TTL index removes expired sessions automatically
 * Prevents database from filling with old session records
 * USAGE:
 * - Authentication: Store serialized user info in session
 * - CSRF protection: Session data includes CSRF token
 * - Logout: Delete session record from table
 */
model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sid       String   @unique // Express session ID
  data      String //  Serialized session data (JSON string)
  expiresAt DateTime // Expiration time

  @@index([expiresAt]) //  TTL index - configure TTL at MongoDB level
}

// ============================================================================
// SITE CONFIGURATION & SETTINGS
// ============================================================================

/**
 * SiteSetting Model - Stores global site configuration
 * FIELDS:
 * - id: Unique MongoDB ObjectId
 * - key: Setting identifier (e.g., "hero_image")
 * - value: Setting value (e.g., "/uploads/settings/hero.webp")
 * USAGE:
 * - Dynamic site content that can be managed by admin
 */
model SiteSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

// ============================================================================
// END OF SCHEMA
// ============================================================================
