<!-- 
========================================
FILE: forgetPassword.ejs
PURPOSE: Password Recovery Initiation Page
========================================

DESCRIPTION:
Three-step password recovery flow:
1. Enter registered phone number (or switch to email)
2. Receive and verify OTP
3. Set new password

FEATURES:
- Phone number or email recovery options
- OTP delivery via SMS or email
- Three-step progressive disclosure UI
- Input validation (10-digit phone, 6-digit OTP)
- Success confirmation after OTP verification
- Back to login link

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- error (string, optional): Server validation error message

UI FLOW:
- Section 1: Phone/Email input (visible by default)
- Section 2: OTP input (hidden until OTP sent)
- Section 3: New password form (hidden until OTP verified)

FORM ACTIONS:
- Send OTP: Triggered by sendResetOTP() function
- Verify OTP: Triggered by verifyResetOTP() function
- Reset Password: Triggered by submitPasswordReset() function

JAVASCRIPT DEPENDENCIES:
- auth.js: OTP flow management, phone/email switching, validation
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title>Reset Password - The Saran Trader</title>
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">
    
    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    
    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">
    
    <%- include('../partials/navbar') %>

    <div class="flex-grow flex items-center justify-center p-4 pt-24">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-xl shadow-blue-500/10 border border-slate-100 overflow-hidden">
            
            <!-- Page Header -->
            <div class="p-8 text-center bg-white border-b border-slate-50">
                <h1 class="text-2xl font-bold text-slate-800">Reset Password</h1>
                <p class="text-slate-500 mt-2">Enter your registered phone number</p>
            </div>

            <!-- Form Content Area -->
            <div class="p-8 pt-6">
                
                <!-- Error Message Display (Server-Side Validation) -->
                <% if (locals.error) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                        <span class="block sm:inline"><%= error %></span>
                    </div>
                <% } %>

                <div class="space-y-5">
                    
                    <!-- ===== STEP 1: EMAIL INPUT ===== -->
                    <div id="identifier-section">
                        <label for="reset-email" class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                        
                        <!-- Email Input with Icon -->
                        <div class="relative overflow-hidden rounded-xl">
                            <span class="absolute inset-y-0 left-0 w-11 flex items-center justify-center text-slate-400 pointer-events-none">
                                <i class="fa-solid fa-envelope text-sm"></i>
                            </span>
                            <input type="email" id="reset-email"
                                class="w-full pl-10 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="your@email.com" required>
                        </div>
                        
                        <!-- Helper Text -->
                        <p class="text-xs text-slate-400 mt-2">We'll send a verification code to your registered email.</p>
                        
                        <!-- Send OTP Button -->
                        <button type="button" id="btn-send-reset-otp" onclick="sendResetOTP()"
                            class="w-full mt-4 py-3.5 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-0.5">
                            Send Reset Code
                        </button>
                    </div>

                    <!-- ===== STEP 2: OTP INPUT (Hidden by default) ===== -->
                    <div id="otp-section" class="hidden">
                        <label for="reset-otp" class="block text-sm font-medium text-slate-700 mb-1">Enter Reset Code</label>
                        
                        <!-- 6-Digit OTP Input -->
                        <input type="text" id="reset-otp" maxlength="6"
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all font-mono tracking-widest text-center text-lg"
                            placeholder="------" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        
                        <p class="text-xs text-slate-400 mt-2">Enter the 6-digit code sent to your email</p>
                        
                        <!-- Verify OTP Button -->
                        <button type="button" id="btn-verify-reset-otp" onclick="verifyResetOTP()"
                            class="w-full mt-4 py-3.5 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-0.5">
                            Verify Code
                        </button>
                    </div>

                    <!-- ===== STEP 3: NEW PASSWORD (Hidden by default) ===== -->
                    <div id="password-section" class="hidden">
                        <!-- Success Message -->
                        <div class="p-4 bg-green-50 text-green-700 rounded-xl text-center text-sm font-semibold border border-green-100 mb-4">
                            ✓ OTP Verified Successfully
                        </div>
                        
                        <!-- New Password Field -->
                        <div>
                            <label for="new-password" class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
                            <input type="password" id="new-password"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Enter new password" required>
                        </div>
                        
                        <!-- Confirm Password Field -->
                        <div class="mt-4">
                            <label for="confirm-new-password" class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
                            <input type="password" id="confirm-new-password"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Confirm new password" required>
                        </div>
                        
                        <!-- Submit Button -->
                        <button type="button" onclick="submitPasswordReset()"
                            class="w-full mt-4 py-3.5 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-0.5">
                            Reset Password
                        </button>
                    </div>
                </div>

                <!-- Back to Login Link -->
                <div class="mt-8 pt-6 border-t border-slate-50 text-center">
                    <a href="/login"
                        class="text-slate-500 hover:text-blue-600 font-medium inline-flex items-center gap-2 transition-colors">
                        <i class="fa-solid fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== JAVASCRIPT DEPENDENCIES ========== -->
    <!-- 
        - auth.js: Password recovery flow, OTP management, phone/email switching
    -->
    <script src="/javascripts/auth.js" defer></script>
</body>

</html>