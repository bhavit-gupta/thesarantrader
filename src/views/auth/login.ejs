<!-- ========================================================================== -->
<!--                        LOGIN PAGE (login.ejs)                              -->
<!-- ========================================================================== -->
<!--
    Purpose: User authentication page with flexible login options
    
    Login Methods Supported:
    1. Username (default)
    2. Email address
    3. Phone number
    
    Features:
    - Tab-based login method selector
    - Password visibility toggle (eye icon)
    - CSRF protection (hidden token)
    - Error message display (server-side validation failures)
    - "Forgot Password" link
    - Link to signup page for new users
    
    Expected Variables:
    - csrfToken: string - CSRF protection token (from viewData middleware)
    - error: string | undefined - Server-side error message (if login failed)
    
    Form Submission:
    - Action: /auth/login (POST)
    - Handler: auth.controller.js → loginUser()
    - Rate Limited: 5 requests per minute
    
    Client-Side JavaScript:
    - /javascripts/auth.js - Handles tab switching and password toggle
-->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Login - The Saran Trader</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">
    
    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    
    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">
    
    <%- include('../partials/navbar') %>
    
    <!-- ========== LOGIN FORM CONTAINER ========== -->
    <div class="flex-grow flex items-center justify-center p-4 pt-24">
        <div
            class="w-full max-w-md bg-white rounded-2xl shadow-xl shadow-blue-500/10 border border-slate-100 overflow-hidden">
                
                <!-- Page Header -->
                <div class="p-8 text-center bg-white border-b border-slate-50">
                    <h1 class="text-2xl font-bold text-slate-800">Welcome Back</h1>
                    <p class="text-slate-500 mt-2">Sign in to continue learning</p>
                </div>
                
                <!-- Form Content Area -->
                <div class="p-8 pt-6">
                    
                    <!-- Error Message Display (Server-Side Validation) -->
                    <% if (locals.error) { %>
                        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4"
                            role="alert">
                            <span class="block sm:inline">
                                <%= error %>
                            </span>
                        </div>
                    <% } %>
                    
                    <!-- ===== LOGIN FORM ===== -->
                    <form action="/auth/login" method="POST" class="space-y-5">
                        
                        <!-- CSRF Token (Security) -->
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        
                        <!-- Login Method Selector -->
                        <div>
                            <!-- Tab Buttons: Username | Email | Phone -->
                            <!-- JavaScript in auth.js handles tab switching -->
                            <div class="flex gap-4 mb-4 text-sm font-medium text-slate-500">
                                <button type="button" id="btn-username"
                                    class="text-blue-600 border-b-2 border-blue-600 pb-1">Username</button>
                                <button type="button" id="btn-email"
                                    class="hover:text-blue-600 pb-1">Email</button>
                                <button type="button" id="btn-phone" 
                                    class="hover:text-blue-600 pb-1">Phone</button>
                            </div>
                            
                            <!-- Dynamic Label (Changes based on selected tab) -->
                            <label for="login-input" id="login-label"
                                class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                            
                            <!-- Hidden Field: Tracks which login method is active -->
                            <input type="hidden" name="loginType" id="login-type" value="username">
                            
                            <!-- Login Input Field (Multi-purpose: username/email/phone) -->
                            <input type="text" id="login-input" name="loginIdentifier"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Enter your username" required>
                        </div>
                        
                        <!-- Password Field with Visibility Toggle -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
                            </div>
                            
                            <!-- Password Input with Eye Icon Toggle -->
                            <div class="relative flex">
                                <input type="password" id="password" name="password"
                                    class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all pr-12"
                                    placeholder="••••••••" required>
                                
                                <!-- Toggle Button: Shows/hides password -->
                                <button type="button"
                                    class="absolute right-4 text-slate-400 hover:text-blue-600 transition-colors h-full py-auto toggle-password-btn"
                                    data-target="password">
                                    <div class="icon-placeholder"><i class="fa-solid fa-eye"></i></div>
                                </button>
                            </div>
                            
                            <!-- Forgot Password Link -->
                            <div class="text-right mt-1">
                                <a href="/forgetPassword"
                                    class="text-sm text-blue-600 font-semibold hover:text-blue-700">Forgot password?</a>
                            </div>
                        </div>
                        
                        <!-- Submit Button -->
                        <button type="submit"
                            class="w-full py-3.5 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-0.5">
                            Sign In
                        </button>
                    </form>
                    
                    <!-- Signup Link for New Users -->
                    <div class="mt-8 pt-6 border-t border-slate-50 text-center">
                        <p class="text-slate-600 text-sm">
                            Don't have an account?
                            <a href="/signup" class="text-blue-600 font-bold hover:text-blue-700">Sign up</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    
    <!-- ========== JAVASCRIPT DEPENDENCIES ========== -->
    <!-- 
        - main.js: Global utilities
        - auth.js: Login tab switching, password visibility toggle
    -->
    <script src="/javascripts/main.js" defer></script>
    <script src="/javascripts/auth.js" defer></script>
</body>

</html>