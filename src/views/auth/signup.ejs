<!-- 
========================================
FILE: signup.ejs
PURPOSE: User Registration Page
========================================

DESCRIPTION:
User registration form with email and phone OTP verification.
Supports form field persistence on validation errors.

REGISTRATION FIELDS:
- Personal Info: Full name, username
- Contact: Email (with OTP), phone (with OTP)
- Location: State, city
- Password: Password, confirm password (with visibility toggles)

FEATURES:
- Dual OTP verification (email + phone)
- Real-time OTP request buttons
- Password strength validation
- CSRF protection
- Form data persistence on error
- Responsive grid layout
- Password visibility toggles

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- error (string, optional): Server validation error message
- formData (object, optional): Previous form values on validation error
  - name, username, email, phone, state, city

FORM SUBMISSION:
- Action: POST /auth/register
- Rate Limited: 5 requests per 15 minutes per IP
- On success: Redirects to verify-otp page
- On error: Re-renders with error message and preserved data

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- auth.js: OTP request handlers, password toggle, form validation
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Sign Up - The Saran Trader</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">
    
    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    
    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">
    
    <%- include('../partials/navbar') %>
    
    <div class="flex justify-center p-4 pt-24">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-xl shadow-blue-500/10 border border-slate-100 overflow-hidden">
            
            <!-- Page Header -->
            <div class="p-8 text-center bg-white border-b border-slate-50">
                <h1 class="text-2xl font-bold text-slate-800">Create Account</h1>
                <p class="text-slate-500 mt-2">Start your trading journey today</p>
            </div>
            
            <!-- Form Content Area -->
            <div class="p-8 pt-6 w-full">
                
                <!-- Error Message Display (Server-Side Validation) -->
                <% if (locals.error) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                        <span class="block sm:inline"><%= error %></span>
                    </div>
                <% } %>
                
                <!-- ===== REGISTRATION FORM ===== -->
                <form action="/auth/register" method="POST" class="space-y-5 w-full">
                    
                    <!-- CSRF Token (Security) -->
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    
                    <!-- Personal Information Row (Name + Username) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Full Name Field -->
                        <div>
                            <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                            <input type="text" id="name" name="name"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Kundan Raj" value="<%= locals.formData ? formData.name : '' %>" required>
                        </div>
                        
                        <!-- Username Field (Unique identifier) -->
                        <div>
                            <label for="username" class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                            <input type="text" id="username" name="username"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="kundan_raj" value="<%= locals.formData ? formData.username : '' %>" required>
                        </div>
                    </div>
                    
                    <!-- Email with OTP Verification -->
                    <div class="w-full">
                        <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                        <div class="flex items-center w-full gap-2">
                            <!-- Email Input (75% width) -->
                            <input type="email" name="email" id="email"
                                class="w-[calc(75%-4px)] px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 border-r-0 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="kundan@example.com" value="<%= locals.formData ? formData.email : '' %>" required>
                            
                            <!-- OTP Request Button (25% width) -->
                            <button type="button" id="btn-send-email-otp"
                                class="w-[calc(25%-4px)] px-4 py-3 bg-blue-100 text-blue-600 font-semibold rounded-xl hover:bg-blue-200 transition-colors whitespace-nowrap text-sm border border-l-0 border-blue-100">
                                Get OTP
                            </button>
                        </div>
                    </div>
                    
                    <!-- Email OTP Input (Hidden until OTP sent) -->
                    <div id="otp-container" class="hidden">
                        <label for="otp" class="block text-sm font-medium text-slate-700 mb-1">Enter Email OTP</label>
                        <input type="text" id="otp" name="otp"
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                            placeholder="123456" maxlength="6">
                    </div>
                    
                    <!-- Phone Number (Collected for profile, no OTP) -->
                    <div class="w-full">
                        <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
                        <input type="tel" id="phone" name="phone"
                            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                            placeholder="9876543210" maxlength="10" value="<%= locals.formData ? formData.phone : '' %>" required>
                    </div>
                    
                    <!-- Location Information (State + City) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- State Field -->
                        <div>
                            <label for="state" class="block text-sm font-medium text-slate-700 mb-1">State</label>
                            <input type="text" id="state" name="state"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Bihar" value="<%= locals.formData ? formData.state : '' %>" required>
                        </div>
                        
                        <!-- City Field -->
                        <div>
                            <label for="city" class="block text-sm font-medium text-slate-700 mb-1">City</label>
                            <input type="text" id="city" name="city"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
                                placeholder="Patna" value="<%= locals.formData ? formData.city : '' %>" required>
                        </div>
                    </div>
                    
                    <!-- Password Field with Visibility Toggle -->
                    <div>
                        <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                        <div class="relative flex">
                            <input type="password" id="password" name="password"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all pr-12"
                                placeholder="Create a password" required>
                            
                            <!-- Toggle Button: Shows/hides password -->
                            <button type="button"
                                class="absolute right-4 text-slate-400 hover:text-blue-600 transition-colors h-full py-auto toggle-password-btn"
                                data-target="password">
                                <div class="icon-placeholder"><i class="fa-solid fa-eye"></i></div>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Confirm Password Field with Visibility Toggle -->
                    <div>
                        <label for="confirm-password" class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
                        <div class="relative">
                            <input type="password" id="confirm-password" name="confirm-password"
                                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all pr-12"
                                placeholder="Re-enter your password" required>
                            
                            <!-- Toggle Button: Shows/hides confirm password -->
                            <button type="button"
                                class="absolute right-4 text-slate-400 hover:text-blue-600 transition-colors h-full py-auto toggle-password-btn"
                                data-target="confirm-password">
                                <div class="icon-placeholder"><i class="fa-solid fa-eye"></i></div>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Terms of Service Agreement -->
                    <div class="text-xs text-slate-500 leading-relaxed">
                        By clicking Sign Up, you agree to our 
                        <a href="#" class="text-blue-600 hover:text-blue-700">Terms of Service</a> and
                        <a href="#" class="text-blue-600 hover:text-blue-700">Privacy Policy</a>.
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit"
                        class="w-full py-3.5 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-0.5">
                        Sign Up
                    </button>
                    
                </form>
                
                <!-- Login Link for Existing Users -->
                <div class="mt-8 pt-6 border-t border-slate-50 text-center">
                    <p class="text-slate-600 text-sm">
                        Already have an account? 
                        <a href="/login" class="text-blue-600 font-bold hover:text-blue-700">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- ========== JAVASCRIPT DEPENDENCIES ========== -->
    <!-- 
        - main.js: Global utilities
        - auth.js: OTP request handlers, password visibility toggle, form validation
    -->
    <script src="/javascripts/main.js" defer></script>
    <script src="/javascripts/auth.js" defer></script>
</body>

</html>