                             <button id="crop-confirm-btn" class="px-5 py-2.5 rounded-xl bg-brand-navy hover:bg-brand-navy/90 text-white font-bold text-sm shadow-lg shadow-brand-navy/25 transition-all hover:-translate-y-0.5">
