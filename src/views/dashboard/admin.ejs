<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Admin Dashboard - The Saran Trader</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">
    <link rel="stylesheet" href="/stylesheets/output.css">
    <!-- ... -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
</head>
<!-- 
    Tailwind Safelist for Dynamic Classes (Do not remove):
    bg-blue-50 bg-indigo-50 bg-green-50 bg-purple-50 bg-orange-50 bg-red-50 bg-yellow-50 bg-teal-50
    text-blue-500 text-indigo-500 text-green-500 text-purple-500 text-orange-500 text-red-500 text-yellow-500 text-teal-500
    bg-blue-100 text-blue-700 bg-green-100 text-green-700 bg-purple-100 text-purple-700 bg-orange-100 text-orange-700
-->

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <% const liveSessions=typeof locals.liveSessions !=='undefined' ? locals.liveSessions : {}; %>
    <% /* Defensive initialization to prevent crashes if backend data is missing */ const safeStats=typeof stats
        !=='undefined' ? stats : { totalusers: 0, totalRevenue: 0, totalUsers: 0, totalPaidUsers: 0 }; const
        safeOngoing=typeof ongoingCourses !=='undefined' ? ongoingCourses : []; const safeUpcoming=typeof
        upcomingCourses !=='undefined' ? upcomingCourses : []; const safeExpired=typeof expiredCourses
        !=='undefined' ? expiredCourses : []; const safeCourses=typeof courses !=='undefined' ? courses : []; %>

    <%- include('../partials/layout_wrapper_top', { pageTitle: 'Admin Panel' }) %>

            <main class="flex-grow pb-12">
                <!-- Top Navbar replacement/Spacer for Desktop if needed, but we'll use padding -->
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-10">

                        <!-- ---------------- ADMIN HEADER ---------------- -->
                        <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h1 class="text-3xl font-bold text-slate-800">Admin Control Center 🛡️</h1>
                                <p class="text-slate-500 mt-1">Manage your platform and live sessions.</p>
                            </div>
                             <div class="flex gap-2">
                                 <span class="px-4 py-2 rounded-lg bg-brand-gold/10 text-brand-gold font-bold text-sm border border-brand-gold/20">
                                     v1.0.0
                                 </span>
                             </div>
                        </div>

                        <!-- ---------------- CONTROL GRID ---------------- -->

                        <!-- ---------------- PENDING VERIFICATIONS ---------------- -->
                        <% const safePending=typeof pendingPurchases !=='undefined' ? pendingPurchases : []; %>
                            <% if (safePending.length> 0) { %>
                                <div
                                    class="mb-8 bg-white rounded-2xl shadow-sm border border-orange-200 overflow-hidden">
                                    <div
                                        class="p-6 border-b border-orange-100 bg-orange-50 flex items-center justify-between">
                                        <h2 class="text-lg font-bold text-orange-800 flex items-center gap-2">
                                            <i class="fa-solid fa-circle-exclamation"></i> Pending Verifications
                                            <span
                                                class="bg-white text-orange-600 px-2.5 py-0.5 rounded-full text-xs box-border border border-orange-200">
                                                <%= safePending.length %>
                                            </span>
                                        </h2>
                                    </div>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left text-sm text-slate-600">
                                            <thead
                                                class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider text-xs border-b border-slate-200">
                                                <tr>
                                                    <th class="px-6 py-4">User</th>
                                                    <th class="px-6 py-4">Course</th>
                                                    <th class="px-6 py-4">Amount</th>
                                                    <th class="px-6 py-4">Date</th>
                                                    <th class="px-6 py-4">Proof</th>
                                                    <th class="px-6 py-4 text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                <% safePending.forEach(purchase=> { %>
                                                    <tr class="hover:bg-slate-50 transition-colors">
                                                        <td class="px-6 py-4">
                                                            <div class="font-bold text-slate-800">
                                                                <%= purchase.user ? (purchase.user.name ||
                                                                    purchase.user.username) : 'Unknown User' %>
                                                            </div>
                                                            <div class="text-xs text-slate-400">
                                                                <%= purchase.user ? purchase.user.email : '' %>
                                                            </div>
                                                        </td>
                                                        <td class="px-6 py-4">
                                                            <div class="font-medium text-slate-700">
                                                                <%= purchase.course ? purchase.course.title
                                                                    : 'Unknown Course' %>
                                                            </div>
                                                        </td>
                                                        <td class="px-6 py-4 font-bold text-slate-800">
                                                            ₹<%= purchase.amount %>
                                                        </td>
                                                        <td class="px-6 py-4 text-slate-500">
                                                            <%= formatDate(purchase.date) %>
                                                        </td>
                                                        <td class="px-6 py-4">
                                                            <% if (purchase.screenshotUrl) { %>
                                                                 <a href="<%= purchase.screenshotUrl %>" target="_blank"
                                                                     class="inline-flex items-center gap-1 text-brand-gold hover:text-brand-accent font-medium text-xs bg-brand-gold/10 px-2 py-1 rounded border border-brand-gold/20 transition-colors">
                                                                     <i class="fa-solid fa-image"></i> View
                                                                 </a>
                                                                <% } else { %>
                                                                    <span class="text-slate-400 text-xs">No Image</span>
                                                                    <% } %>
                                                        </td>
                                                        <td class="px-6 py-4 text-right">
                                                            <div class="flex items-center justify-end gap-2">
                                                                <button data-purchase-id="<%= purchase.id %>"
                                                                    class="approve-payment-btn p-2 rounded-lg text-green-600 hover:bg-green-50 border border-transparent hover:border-green-200 transition-all"
                                                                    title="Approve">
                                                                    <i class="fa-solid fa-check"></i>
                                                                </button>
                                                                <button data-purchase-id="<%= purchase.id %>"
                                                                    class="reject-payment-btn p-2 rounded-lg text-red-600 hover:bg-red-50 border border-transparent hover:border-red-200 transition-all"
                                                                    title="Reject">
                                                                    <i class="fa-solid fa-xmark"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <% } %>

                                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

                                        <!-- ---------------- LIVE SESSION CONTROLS ---------------- -->
                                        <div class="lg:col-span-2 space-y-6">
                                            <div class="flex items-center justify-between">
                                                <h2 class="text-xl font-bold text-slate-800">Live Session Controls</h2>
                                                <span
                                                    class="text-sm text-slate-500 bg-slate-200 px-3 py-1 rounded-full">
                                                    <%= safeCourses.length %> Courses
                                                </span>
                                            </div>

                                            <!-- ---------------- ONGOING COURSES ---------------- -->
                                            <div class="mb-8">
                                                <h3
                                                    class="text-lg font-bold text-slate-700 mb-4 flex items-center gap-2">
                                                    <i class="fa-solid fa-play-circle text-green-500"></i> Ongoing &
                                                     Courses
                                                    <span
                                                        class="text-xs font-normal text-slate-500 bg-slate-100 px-2 py-1 rounded-full">
                                                        <%= safeOngoing.length %>
                                                    </span>
                                                </h3>

                                                <% if (safeOngoing.length===0) { %>
                                                    <div
                                                        class="bg-white rounded-xl p-8 text-center border border-slate-200 border-dashed">
                                                        <div
                                                            class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-400">
                                                            <i class="fa-solid fa-box-open text-xl"></i>
                                                        </div>
                                                        <p class="text-slate-500 font-medium">No ongoing courses right
                                                            now.</p>
                                                    </div>
                                                    <% } else { %>
                                                        <div class="grid grid-cols-1 gap-4">
                                                            <% safeOngoing.forEach(course=> {
                                                                const session = liveSessions[course.id] || { isLive:
                                                                false,
                                                                startTime:
                                                                null
                                                                };
                                                                const isLive = session.isLive;
                                                                const hasLink = course.zoomMeetingId &&
                                                                course.zoomMeetingId.trim().length >
                                                                0;
                                                                %>
                                                                <div id="course-meta-<%= course.id %>"
                                                                    onclick="if (!event.target.closest('button')) window.location.href='/admin/courses/<%= course.id %>/videos'"
                                                                    class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col xl:flex-row items-center justify-between gap-6 cursor-pointer group/card">
                                                                    <div class="flex items-center gap-4 flex-1">
                                                                        <div
                                                                            class="flex w-12 h-12 rounded-lg bg-<%= course.iconBg %> text-<%= course.iconColor %> items-center justify-center text-2xl shrink-0 group-hover/card:scale-110 transition-transform">
                                                                            <%= course.icon %>
                                                                        </div>
                                                                        <div>
                                                                             <h3
                                                                                 class="font-bold text-slate-800 text-lg group-hover/card:text-brand-gold transition-colors">
                                                                                 <%= course.title %>
                                                                             </h3>
                                                                            <div
                                                                                class="flex items-center gap-3 text-sm mt-1">
                                                                                <span class="text-slate-500"><i
                                                                                        class="fa-solid fa-users mr-1"></i>
                                                                                    <%= course.users %> users
                                                                                </span>
                                                                                <% if (isLive) { %>
                                                                                    <span
                                                                                        class="text-green-600 font-semibold flex items-center gap-1">
                                                                                        <span
                                                                                            class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                                                                                        Live Now
                                                                                    </span>
                                                                                    <span id="timer-<%= course.id %>"
                                                                                        class="text-slate-400 font-mono live-timer"
                                                                                        data-start="<%= session.startTime %>">00:00:00</span>
                                                                                    <% } else { %>
                                                                                        <span
                                                                                            class="text-slate-400">Offline</span>
                                                                                        <% } %>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex flex-wrap gap-2 shrink-0 w-full xl:w-auto xl:justify-end">

                                                                        <button data-course-id="<%= course.id %>" <% if (!hasLink) { %> disabled title="Add Zoom details first" <% } %>
                                                                                class="toggle-live-btn relative px-4 py-2 rounded-full font-bold text-sm transition-all focus:outline-none shrink-0 flex-1 xl:flex-none <%= isLive ? 'bg-red-50 text-red-600 hover:bg-red-100 border border-red-200' : (hasLink ? 'bg-brand-navy text-white hover:bg-brand-navy/90 border border-white/10 shadow-lg shadow-brand-navy/20' : 'bg-slate-300 text-slate-500 cursor-not-allowed') %>">
                                                                            <% if (isLive) { %>
                                                                                <i class="fa-solid fa-stop mr-1.5"></i>End Live
                                                                            <% } else { %>
                                                                                <i class="fa-solid fa-satellite-dish mr-1.5"></i>Go Live
                                                                            <% } %>
                                                                        </button>
                                                                        <% if (hasLink) { %>
                                                                        <a href="/live-meeting?id=<%= course.zoomMeetingId %>&pwd=<%= course.zoomPassword %>" 
                                                                           class="px-4 py-2 rounded-full bg-brand-gold text-brand-navy font-bold text-xs text-center hover:bg-brand-gold/90 transition-all shadow-lg shadow-brand-gold/20 flex items-center justify-center gap-1 shrink-0 flex-1 xl:flex-none">
                                                                            <i class="fa-solid fa-desktop"></i> Launch Console
                                                                        </a>
                                                                        <% } %>

                                                                    </div>
                                                                </div>
                                                                <% }); %>
                                                        </div>
                                                        <% } %>
                                            </div>

                                            <!-- ---------------- UPCOMING COURSES ---------------- -->
                                            <div>
                                                <h3
                                                    class="text-lg font-bold text-slate-700 mb-4 flex items-center gap-2">
                                                    <i class="fa-solid fa-calendar-alt text-blue-500"></i> Upcoming
                                                    Courses
                                                    <span
                                                        class="text-xs font-normal text-slate-500 bg-slate-100 px-2 py-1 rounded-full">
                                                        <%= safeUpcoming.length %>
                                                    </span>
                                                </h3>

                                                <% if (safeUpcoming.length===0) { %>
                                                    <div
                                                        class="bg-white rounded-xl p-8 text-center border border-slate-200 border-dashed">
                                                        <div
                                                            class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-400">
                                                            <i class="fa-regular fa-calendar text-xl"></i>
                                                        </div>
                                                        <p class="text-slate-500 font-medium">No upcoming courses
                                                            scheduled.</p>
                                                    </div>
                                                    <% } else { %>
                                                        <div class="grid grid-cols-1 gap-4">
                                                            <% safeUpcoming.forEach(course=> {
                                                                let formattedDate = "TBA";
                                                                if (course.startDate) {
                                                                formattedDate = formatDate(course.startDate);
                                                                }
                                                                %>
                                                                <div onclick="if (!event.target.closest('button')) window.location.href='/admin/courses/<%= course.id %>/videos'"
                                                                    class="bg-slate-50 rounded-xl p-6 border border-slate-200 transition-all flex flex-col xl:flex-row items-center justify-between gap-6 opacity-90 hover:opacity-100 cursor-pointer group/card">
                                                                    <div class="flex items-center gap-4 flex-1">
                                                                        <div
                                                                            class="flex w-12 h-12 rounded-lg bg-white border border-slate-100 text-slate-400 items-center justify-center text-2xl shrink-0 grayscale opacity-70 group-hover/card:scale-110 group-hover/card:grayscale-0 group-hover/card:opacity-100 transition-all">
                                                                            <%= course.icon %>
                                                                        </div>
                                                                        <div>
                                                                             <h3
                                                                                 class="font-bold text-slate-700 text-lg group-hover/card:text-brand-gold transition-colors">
                                                                                 <%= course.title %>
                                                                             </h3>
                                                                            <div
                                                                                class="flex items-center gap-3 text-sm mt-1">
                                                                                 <span
                                                                                     class="text-brand-gold font-medium bg-brand-gold/10 px-2 py-0.5 rounded text-xs group-hover/card:bg-brand-gold/20 transition-colors">
                                                                                     <i
                                                                                         class="fa-regular fa-clock mr-1"></i>Starts
                                                                                     <%= formattedDate %>
                                                                                 </span>
                                                                                <span class="text-slate-400 text-xs">
                                                                                    <i
                                                                                        class="fa-solid fa-users mr-1"></i>
                                                                                    <%= course.users %> Enrolled
                                                                                </span>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="flex gap-2 w-full xl:w-auto xl:justify-end">

                                                                        <button disabled
                                                                            class="px-6 py-2.5 rounded-full font-bold text-sm bg-slate-100 text-slate-400 cursor-not-allowed border border-slate-200 shrink-0 flex-1 xl:flex-none flex items-center justify-center">
                                                                            <i class="fa-solid fa-clock mr-2"></i>Wait
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <% }); %>
                                                        </div>
                                                        <% } %>
                                            </div>
                                        </div>

                                        <!-- ---------------- QUICK STATS ---------------- -->
                                        <div class="space-y-4">
                                            <!-- Total users -->
                                            <div
                                                class="bg-white rounded-2xl border border-slate-200 p-6 flex items-center gap-4 shadow-sm">
                                                 <div
                                                     class="w-12 h-12 rounded-xl bg-brand-gold/10 flex items-center justify-center text-brand-gold text-xl">
                                                     <i class="fa-solid fa-user-graduate"></i>
                                                 </div>
                                                <div>
                                                    <p class="text-sm text-slate-500 font-medium">Total Members</p>
                                                    <h3 class="text-2xl font-bold text-slate-800">
                                                        <%= safeStats.totalPaidUsers %>
                                                    </h3>
                                                </div>
                                            </div>


                                            <!--  Now -->
                                            <div
                                                class="bg-white rounded-2xl border border-slate-200 p-6 flex items-center gap-4 shadow-sm">
                                                <div
                                                    class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600 text-xl">
                                                    <i class="fa-solid fa-globe"></i>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-slate-500 font-medium">Total Users</p>
                                                    <h3 class="text-2xl font-bold text-slate-800">
                                                        <%= safeStats.totalUsers %>
                                                    </h3>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- ---------------- QUICK ACTIONS ---------------- -->
                                        <div class="space-y-4">
                                            <h2 class="text-xl font-bold text-slate-800">Quick Actions</h2>
                                            <a href="/admin/testimonials"
                                                class="bg-white rounded-2xl border border-slate-200 p-6 flex items-center gap-4 shadow-sm hover:shadow-md transition-all group">
                                                 <div
                                                     class="w-12 h-12 rounded-xl bg-brand-navy/5 text-brand-navy flex items-center justify-center text-xl group-hover:bg-brand-navy group-hover:text-white transition-all">
                                                     <i class="fa-solid fa-comments"></i>
                                                 </div>
                                                <div class="flex-1">
                                                    <h3 class="font-bold text-slate-800 line-clamp-1">Manage
                                                        Testimonials</h3>
                                                    <p class="text-xs text-slate-500">Approve or reject reviews</p>
                                                </div>
                                                 <i
                                                     class="fa-solid fa-chevron-right text-slate-300 group-hover:text-brand-navy transition-colors"></i>
                                            </a>

                                            <!-- Manage Users -->
                                            <a href="/admin/users"
                                                class="bg-white rounded-2xl border border-slate-200 p-6 flex items-center gap-4 shadow-sm hover:shadow-md transition-all group">
                                                <div
                                                    class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl group-hover:bg-purple-600 group-hover:text-white transition-all">
                                                    <i class="fa-solid fa-users"></i>
                                                </div>
                                                <div class="flex-1">
                                                    <h3 class="font-bold text-slate-800">Manage Users</h3>
                                                    <p class="text-xs text-slate-500">View all user profiles & activity
                                                    </p>
                                                </div>
                                                <i
                                                    class="fa-solid fa-chevron-right text-slate-300 group-hover:text-purple-500 transition-colors"></i>
                                            </a>

                                            <a href="/admin/courses"
                                                class="bg-white rounded-2xl border border-slate-200 p-6 flex items-center gap-4 shadow-sm hover:shadow-md transition-all group">
                                                <div
                                                    class="w-12 h-12 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl group-hover:bg-orange-600 group-hover:text-white transition-all">
                                                    <i class="fa-solid fa-book"></i>
                                                </div>
                                                <div class="flex-1">
                                                    <h3 class="font-bold text-slate-800">Course Catalog</h3>
                                                    <p class="text-xs text-slate-500">Add or edit all courses</p>
                                                </div>
                                                <i
                                                    class="fa-solid fa-chevron-right text-slate-300 group-hover:text-orange-500 transition-colors"></i>
                                            </a>
                                        </div>

                                        <!-- ---------------- HOMEPAGE SETTINGS ---------------- -->
                                        <div class="space-y-4">
                                            <h2 class="text-xl font-bold text-slate-800">Homepage Settings</h2>
                                            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                                                <div class="flex items-center gap-4 mb-4">
                                                    <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                                        <i class="fa-solid fa-image"></i>
                                                    </div>
                                                    <div>
                                                        <h3 class="font-bold text-slate-800">Hero Image</h3>
                                                        <p class="text-xs text-slate-500">Update the main home page photo</p>
                                                    </div>
                                                </div>
                                                
                                                <div class="relative group bg-slate-100 rounded-xl mb-4 overflow-hidden border border-slate-100 flex items-center justify-center">
                                                    <img id="hero-preview" src="<%= typeof heroImage !== 'undefined' ? heroImage : '/images/hero-image.png' %>" 
                                                         alt="Hero Preview" class="max-w-full h-auto block max-h-[400px]">
                                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                                        <button id="hero-upload-btn" class="px-4 py-2 bg-white text-slate-800 rounded-lg font-bold text-sm shadow-xl hover:scale-105 transition-transform">
                                                            <i class="fa-solid fa-cloud-arrow-up mr-2"></i>Change Photo
                                                        </button>
                                                    </div>
                                                </div>
                                                <input type="file" id="hero-image-input" class="hidden" accept="image/jpeg,image/png,image/webp">
                                                <p class="text-[10px] text-slate-400 text-center italic">Recommended: 800x400px, Under 2MB</p>
                                            </div>
                                        </div>
                                    </div>

                    </div>
                </main>

                <!-- ---------------- EDIT COURSE MODAL ---------------- -->
                <div id="editCourseModal"
                    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                    <div
                        class="bg-white rounded-2xl shadow-xl w-full max-w-lg transform transition-all scale-100 flex flex-col max-h-[85vh]">
                        <div
                            class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50 flex-none rounded-t-2xl">
                            <h3 class="text-lg font-bold text-slate-800">Edit Course</h3>
                            <button onclick="closeEditModal()"
                                class="text-slate-400 hover:text-slate-600 transition-colors">
                                <i class="fa-solid fa-times text-xl"></i>
                            </button>
                        </div>

                        <div class="overflow-y-auto custom-scrollbar flex-grow">
                            <form id="editCourseForm" method="POST" class="p-6 space-y-4 pb-12">
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Course Title</label>
                                    <input type="text" name="title" id="edit-title" required
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                                    <textarea name="description" id="edit-description" required rows="3"
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-sm font-semibold text-slate-700">Zoom Meeting Details</label>
                                        <button type="button" onclick="showLinkHelper()" 
                                                class="text-[10px] text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-1">
                                            <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-fill from Link
                                        </button>
                                    </div>
                                    
                                    <!-- Hidden Helper Input -->
                                    <div id="link-helper-container" class="hidden mb-3">
                                        <input type="text" id="zoom-link-helper" 
                                               placeholder="Paste full Zoom URL here..."
                                               oninput="autoFillZoomDetails(this.value)"
                                               class="w-full px-4 py-1.5 text-xs rounded-lg border border-blue-200 bg-blue-50 focus:ring-1 focus:ring-blue-500 outline-none transition-all italic">
                                    </div>

                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="relative">
