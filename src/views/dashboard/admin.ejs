<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
    <title>Admin Dashboard - The Saran Trader</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">
    <link rel="stylesheet" href="/stylesheets/output.css">
    <!-- ... -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
</head>
<!-- 
    Tailwind Safelist for Dynamic Classes (Do not remove):
    bg-blue-50 bg-indigo-50 bg-green-50 bg-purple-50 bg-orange-50 bg-red-50 bg-yellow-50 bg-teal-50
    text-blue-500 text-indigo-500 text-green-500 text-purple-500 text-orange-500 text-red-500 text-yellow-500 text-teal-500
    bg-blue-100 text-blue-700 bg-green-100 text-green-700 bg-purple-100 text-purple-700 bg-orange-100 text-orange-700
-->

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <% 
        const liveSessions = typeof locals.liveSessions !== 'undefined' ? locals.liveSessions : {}; 
        const safeStats = typeof stats !== 'undefined' ? stats : { totalUsers: 0, totalRevenue: 0, totalPaidUsers: 0 }; 
        const safeOngoing = typeof ongoingCourses !== 'undefined' ? ongoingCourses : []; 
        const safeUpcoming = typeof upcomingCourses !== 'undefined' ? upcomingCourses : []; 
        const safeExpired = typeof expiredCourses !== 'undefined' ? expiredCourses : []; 
        const safeCourses = typeof courses !== 'undefined' ? courses : [];
        const safePending = typeof pendingPurchases !== 'undefined' ? pendingPurchases : [];
    %>

            <%- include('../partials/layout_wrapper_top', { pageTitle: 'Admin Panel' }) %>

                <main class="flex-grow pb-20">
                    <div class="max-w-[1500px] mx-auto px-6 lg:px-10 pt-6">

                        <!-- ---------------- HEADER ---------------- -->
                        <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
                            <div>
                                <h1 class="text-4xl font-bold text-slate-900 tracking-tight leading-none">Hi <%= user.name %>,</h1>
                                <p class="text-lg text-slate-500 mt-3 font-semibold flex items-center gap-2">
                                    Admin Command Center 
                                    <span class="inline-flex h-2 w-2 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]"></span>
                                </p>
                            </div>
                            <div class="hidden md:flex flex-col items-end gap-1.5">
                                <span class="text-[9px] font-bold uppercase tracking-[0.3em] text-slate-400">System Activity</span>
                                <div class="px-4 py-2 bg-slate-100/50 border border-slate-200 rounded-xl text-[10px] font-bold text-slate-800 italic">
                                    v<%= typeof APP_VERSION !== 'undefined' ? APP_VERSION : '2.4.0' %>
                                </div>
                            </div>
                        </div>

                        <!-- ---------------- BROADCAST & MONITORING ---------------- -->
                        <div class="mb-10">
                            <div class="card-premium p-6 sm:p-8 bg-slate-900 border-none shadow-2xl relative overflow-hidden group">
                                <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-gold/5 blur-[100px] rounded-full"></div>
                                <div class="absolute right-0 top-0 p-8 opacity-10">
                                    <i class="fa-solid fa-tower-broadcast text-8xl text-brand-gold"></i>
                                </div>
                                
                                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
                                    <div class="flex items-center gap-6">
                                        <div class="w-16 h-16 rounded-2xl bg-brand-gold/10 text-brand-gold flex items-center justify-center text-3xl shadow-lg shadow-brand-gold/5">
                                            <i class="fa-solid fa-satellite-dish"></i>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-3 mb-1">
                                                <h2 class="text-2xl font-black text-white tracking-tight">Broadcast Studio</h2>
                                                <% const activeSessions = Object.values(liveSessions).filter(s => s.isLive).length; %>
                                                <span class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-black uppercase tracking-widest text-emerald-400">
                                                    <span class="w-1.5 h-1.5 rounded-full <%= activeSessions > 0 ? 'bg-emerald-500 animate-pulse' : 'bg-slate-600' %>"></span>
                                                    <%= activeSessions > 0 ? 'Live Now' : 'Standby' %>
                                                </span>
                                            </div>
                                            <p class="text-slate-400 text-sm font-medium">Control and monitor your real-time trading sessions</p>
                                        </div>
                                    </div>
                                    
                                    <div class="flex flex-col sm:flex-row items-center gap-4">
                                        <div class="px-6 py-3 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-sm hidden lg:block">
                                            <div class="text-[9px] font-black text-slate-500 uppercase tracking-[0.2em] mb-0.5">Active Streams</div>
                                            <div class="text-lg font-black text-white">
                                                <%= activeSessions %> session<%= activeSessions !== 1 ? 's' : '' %>
                                            </div>
                                        </div>
                                        <button onclick="window.location.href='/admin/live'" class="w-full sm:w-auto py-4 px-8 rounded-2xl bg-brand-gold text-slate-950 font-black text-xs uppercase tracking-widest hover:scale-[1.02] active:scale-98 transition-all shadow-xl shadow-brand-gold/20 flex items-center justify-center gap-3">
                                            <i class="fa-solid fa-video"></i>
                                            Go Live Studio
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ---------------- PLATFORM PULSE (4-COLUMN STATS) ---------------- -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-10">
                            <!-- Stats Card: Traders -->
                            <div class="card-stat p-4 sm:p-7 flex flex-col justify-between">
                                <div class="flex items-center justify-between mb-4 sm:mb-6">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-brand-gold/10 text-brand-gold flex items-center justify-center text-lg sm:text-xl">
                                        <i class="fa-solid fa-users text-sm sm:text-lg"></i>
                                    </div>
                                    <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-brand-gold/60">Traders</span>
                                </div>
                                <div>
                                    <h4 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight"><%= safeStats.totalPaidUsers %></h4>
                                    <div class="mt-1 flex items-center gap-1.5 text-[9px] sm:text-[10px] font-semibold text-green-500">
                                        <i class="fa-solid fa-arrow-trend-up text-[8px] sm:text-[10px]"></i>
                                        Managed
                                    </div>
                                </div>
                            </div>

                            <!-- Stats Card: Revenue -->
                            <div class="card-stat p-4 sm:p-7 bg-emerald-50/30 border-emerald-100/50 flex flex-col justify-between">
                                <div class="flex items-center justify-between mb-4 sm:mb-6">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-100/30 text-emerald-600 flex items-center justify-center text-lg sm:text-xl">
                                        <i class="fa-solid fa-indian-rupee-sign text-sm sm:text-lg"></i>
                                    </div>
                                    <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-emerald-600/60">Revenue</span>
                                </div>
                                <div>
                                    <h4 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">₹<%= Number(safeStats.totalRevenue || 0).toLocaleString('en-IN') %></h4>
                                    <div class="mt-1 flex items-center gap-1.5 text-[9px] sm:text-[10px] font-semibold text-emerald-600">
                                        <i class="fa-solid fa-shield-check text-[8px] sm:text-[10px]"></i>
                                        Verified
                                    </div>
                                </div>
                            </div>

                            <!-- Stats Card: Total Users -->
                            <div class="card-stat p-4 sm:p-7 bg-slate-50 border-slate-100 flex flex-col justify-between">
                                <div class="flex items-center justify-between mb-4 sm:mb-6">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-lg sm:text-xl border border-slate-100">
                                        <i class="fa-solid fa-earth-asia text-slate-400 text-sm sm:text-lg"></i>
                                    </div>
                                    <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-slate-400">Reach</span>
                                </div>
                                <div>
                                    <h4 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight"><%= safeStats.totalUsers %></h4>
                                    <div class="mt-1 flex items-center gap-1.5 text-[9px] sm:text-[10px] font-semibold text-slate-400">
                                        <i class="fa-solid fa-user-plus text-[8px] sm:text-[10px]"></i>
                                        Registered
                                    </div>
                                </div>
                            </div>

                            <!-- Stats Card: Management Hub (Control Center) -->
                            <div class="card-stat p-4 sm:p-7 bg-indigo-50/50 border-indigo-100/50 flex flex-col justify-between cursor-pointer hover:border-brand-gold/40 hover:-translate-y-1 transition-all group" 
                                 onclick="window.location.href='/admin/management'">
                                <div class="flex items-center justify-between mb-4 sm:mb-6">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-lg sm:text-xl shadow-lg shadow-indigo-500/10 group-hover:bg-brand-gold group-hover:text-slate-950 transition-colors">
                                        <i class="fa-solid fa-screwdriver-wrench text-sm sm:text-lg"></i>
                                    </div>
                                    <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-indigo-600/60">Controls</span>
                                </div>
                                <div>
                                    <h4 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">System</h4>
                                    <div class="mt-1 flex items-center gap-1.5 text-[9px] sm:text-[10px] font-semibold text-indigo-600/60">
                                        <i class="fa-solid fa-circle-dot animate-pulse"></i>
                                        Management Hub
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ---------------- MAIN CONTENT GRID ---------------- -->
                        <div class="grid grid-cols-1 xl:grid-cols-4 gap-8">

                            <!-- LEFT: HUB & QUEUE (3/4 Width) -->
                            <div class="xl:col-span-3 space-y-8">

                                <!-- ---------------- OUR OFFERINGS (NEW LAYOUT) ---------------- -->
                                <div class="card-premium p-6 sm:p-10 relative overflow-hidden">
                                    <div class="absolute -right-20 -top-20 w-48 h-48 bg-brand-gold/5 blur-[80px] rounded-full"></div>
                                    
                                    <div class="mb-10 relative z-10">
                                        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Platform Ecosystem</h2>
                                    </div>

                                    <!-- 2x2 Grid -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
                                        
                                        <!-- Card: Academy Architect -->
                                        <div class="p-8 rounded-3xl bg-white border border-slate-100 transition-all cursor-pointer hover:border-brand-gold/40 hover:-translate-y-1 hover:shadow-xl group" onclick="window.location.href='/admin/courses'">
                                            <div class="flex items-start gap-5 mb-6">
                                                <div class="w-14 h-14 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-500 text-xl flex-shrink-0 transition-all group-hover:bg-emerald-500 group-hover:text-white">
                                                    <i class="fa-solid fa-book-open-reader"></i>
                                                </div>
                                                <div class="flex flex-col pt-1">
                                                    <h3 class="text-xl font-bold text-slate-900 leading-none">Academy Architect</h3>
                                                    <span class="text-[11px] font-semibold text-slate-400 mt-2">
                                                        <%= courses.length %> <%= courses.length === 1 ? 'Program' : 'Programs' %> Live
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="text-slate-500 text-sm font-medium leading-relaxed">
                                                Design premium educational programs, manage curriculum modules, and monitor student enrollment.
                                            </p>
                                            <div class="mt-8 flex items-center gap-2 text-emerald-500 font-bold text-sm transition-transform group-hover:translate-x-1">
                                                Manage Academy <i class="fa-solid fa-arrow-right"></i>
                                            </div>
                                        </div>
 
                                        <!-- Card: Brand Hub -->
                                        <div class="p-8 rounded-3xl bg-white border border-slate-100 transition-all cursor-pointer hover:border-brand-gold/40 hover:-translate-y-1 hover:shadow-xl group" onclick="window.location.href='/admin/landing-page'">
                                            <div class="flex items-start gap-5 mb-6">
                                                <div class="w-14 h-14 rounded-full bg-sky-50 flex items-center justify-center text-sky-500 text-xl flex-shrink-0 transition-all group-hover:bg-sky-500 group-hover:text-white">
                                                    <i class="fa-solid fa-palette"></i>
                                                </div>
                                                <div class="flex flex-col pt-1">
                                                    <h3 class="text-xl font-bold text-slate-900 leading-none">Brand Hub</h3>
                                                    <span class="text-[11px] font-semibold text-slate-400 mt-2">Homepage Identity</span>
                                                </div>
                                            </div>
                                            <p class="text-slate-500 text-sm font-medium leading-relaxed">
                                                Sculpt your brand's digital identity. Update hero imagery, manages site branding, and refine your narrative.
                                            </p>
                                            <div class="mt-8 flex items-center gap-2 text-sky-500 font-bold text-sm transition-transform group-hover:translate-x-1">
                                                Manage Appearance <i class="fa-solid fa-arrow-right"></i>
                                            </div>
                                        </div>

                                        <!-- Card: Test Portal -->
                                        <div class="p-8 rounded-3xl bg-white border border-slate-100 transition-all cursor-pointer" onclick="window.location.href='#'">
                                            <div class="flex items-start gap-5 mb-6">
                                                <div class="w-14 h-14 rounded-full bg-sky-50 flex items-center justify-center text-sky-500 text-xl flex-shrink-0 transition-transform">
                                                    <i class="fa-solid fa-clipboard-list"></i>
                                                </div>
                                                <div class="flex flex-col pt-1">
                                                    <h3 class="text-xl font-bold text-slate-900 leading-none">Test Portal</h3>
                                                    <span class="text-[11px] font-semibold text-slate-400 mt-2">No Test Created</span>
                                                </div>
                                            </div>
                                            <p class="text-slate-500 text-sm font-medium leading-relaxed">
                                                Design rigorous assessments for trader certification.
                                            </p>
                                            <div class="mt-8 flex items-center gap-2 text-sky-500 font-bold text-sm transition-transform">
                                                Create Test <i class="fa-solid fa-arrow-right"></i>
                                            </div>
                                        </div>

                                        <!-- Card: Campaign -->
                                        <div class="p-8 rounded-3xl bg-white border border-slate-100 transition-all cursor-pointer" onclick="window.location.href='#'">
                                            <div class="flex items-start gap-5 mb-6">
                                                <div class="w-14 h-14 rounded-full bg-sky-50 flex items-center justify-center text-sky-500 text-xl flex-shrink-0 transition-transform">
                                                    <i class="fa-solid fa-bullhorn"></i>
                                                </div>
                                                <div class="flex flex-col pt-1">
                                                    <h3 class="text-xl font-bold text-slate-900 leading-none">Campaign</h3>
                                                    <span class="text-[11px] font-semibold text-slate-400 mt-2">No Campaign Created</span>
                                                </div>
                                            </div>
                                            <p class="text-slate-500 text-sm font-medium leading-relaxed">
                                                Orchestrate strategic marketing and community outreach.
                                            </p>
                                            <div class="mt-8 flex items-center gap-2 text-sky-500 font-bold text-sm transition-transform">
                                                Explore Campaign <i class="fa-solid fa-arrow-right"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- VERIFICATION QUEUE (Sleeker Version) -->
                                <% if (safePending.length > 0) { %>
                                    <div class="card-premium overflow-hidden">
                                        <div class="p-8 border-b border-slate-50 flex items-center justify-between">
                                            <h2 class="text-2xl font-black text-slate-900 flex items-center gap-3">
                                                <i class="fa-solid fa-circle-check text-brand-gold text-lg"></i> Verification
                                            </h2>
                                            <span class="px-4 py-1.5 bg-orange-500/10 text-orange-600 rounded-full text-[9px] font-black tracking-widest uppercase">
                                                Action Required
                                            </span>
                                        </div>
                                        <div class="overflow-x-auto">
                                            <table class="w-full text-left">
                                                <thead class="bg-slate-50 text-slate-400 font-black uppercase tracking-widest text-[9px] border-b border-slate-100">
                                                    <tr>
                                                        <th class="px-8 py-5">Trader</th>
                                                        <th class="px-8 py-5">Course</th>
                                                        <th class="px-8 py-5">Amount</th>
                                                        <th class="px-8 py-5 text-right">Verification</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-50">
                                                    <% safePending.forEach(purchase => { %>
                                                        <tr class="hover:bg-slate-50/50 transition-all">
                                                            <td class="px-8 py-6">
                                                                <div class="font-black text-slate-900 text-sm"><%= purchase.user ? (purchase.user.name || purchase.user.username) : 'Unknown User' %></div>
                                                                <div class="text-[10px] text-slate-400 font-bold uppercase mt-0.5"><%= purchase.user ? purchase.user.email : '' %></div>
                                                            </td>
                                                            <td class="px-8 py-6">
                                                                <div class="font-bold text-slate-700 text-xs leading-tight"><%= purchase.course ? purchase.course.title : 'Unknown Course' %></div>
                                                            </td>
                                                            <td class="px-8 py-6 font-black text-slate-900 text-lg">
                                                                ₹<%= purchase.amount %>
                                                            </td>
                                                            <td class="px-8 py-6 text-right">
                                                                <div class="flex items-center justify-end gap-3">
                                                                    <% if (purchase.screenshotUrl) { %>
                                                                        <a href="<%= purchase.screenshotUrl %>" target="_blank" class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center hover:bg-brand-gold transition-all">
                                                                            <i class="fa-solid fa-image text-xs"></i>
                                                                        </a>
                                                                    <% } %>
                                                                    <div class="h-6 w-px bg-slate-200 mx-1"></div>
                                                                    <button data-purchase-id="<%= purchase.id %>" class="approve-payment-btn w-9 h-9 rounded-xl bg-emerald-500 text-white hover:scale-105 transition-all flex items-center justify-center">
                                                                        <i class="fa-solid fa-check text-xs"></i>
                                                                    </button>
                                                                    <button data-purchase-id="<%= purchase.id %>" class="reject-payment-btn w-9 h-9 rounded-xl bg-red-500 text-white hover:scale-105 transition-all flex items-center justify-center">
                                                                        <i class="fa-solid fa-xmark text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <!-- RIGHT: MISSION CONTROL (1/4 Width) -->
                            <div class="space-y-8">



                                <!-- ADMIN DAILY SCHEDULE -->
                                <div class="card-premium p-8 relative" id="admin-schedule-block">
                                    <div class="flex items-center justify-between mb-6">
                                        <div>
                                            <h2 class="text-xl font-black text-slate-900 tracking-tight">Daily Schedule</h2>
                                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mt-0.5">Your Live Timetable</p>
                                        </div>
                                        <button onclick="openAddScheduleEvent()"
                                            class="w-8 h-8 rounded-xl bg-amber-400 text-slate-900 flex items-center justify-center hover:bg-amber-500 transition-all shadow-md shadow-amber-400/20 hover:scale-110"
                                            title="Add custom event">
                                            <i class="fa-solid fa-plus text-xs"></i>
                                        </button>
                                    </div>

                                    <div id="schedule-list" class="space-y-2">
                                        <% const safeSchedule = typeof adminSchedule !== 'undefined' ? adminSchedule : []; %>
                                        <% if (safeSchedule.length === 0) { %>
                                            <div id="schedule-empty" class="py-6 text-center rounded-2xl bg-slate-50 border border-dashed border-slate-200">
                                                <i class="fa-regular fa-calendar text-slate-300 text-xl mb-2"></i>
                                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">No schedule yet</p>
                                                <p class="text-[8px] text-slate-300 mt-1">Set live times on courses or add a YouTube stream</p>
                                            </div>
                                        <% } else { %>
                                            <% safeSchedule.forEach(item => { %>
                                                <div class="schedule-item flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-amber-50 border border-transparent hover:border-amber-100 transition-all group" data-id="<%= item.id %>" data-type="<%= item.type %>">
                                                    <div class="w-8 h-8 rounded-lg bg-white border border-slate-100 flex items-center justify-center text-sm flex-none shadow-sm">
                                                        <%= item.icon %>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-[11px] font-black text-slate-900 truncate uppercase tracking-tight"><%= item.label %></p>
                                                        <p class="text-[9px] font-bold text-amber-500 uppercase tracking-wider mt-0.5 flex items-center gap-1">
                                                            <i class="fa-solid fa-clock text-[7px]"></i> <%= item.time %>
                                                        </p>
                                                    </div>
                                                    <% if (item.type !== 'course') { %>
                                                        <button onclick="deleteScheduleEvent('<%= item.id %>')"
                                                            class="opacity-0 group-hover:opacity-100 w-6 h-6 rounded-lg bg-red-50 text-red-400 hover:bg-red-500 hover:text-white flex items-center justify-center transition-all flex-none"
                                                            title="Remove">
                                                            <i class="fa-solid fa-times text-[9px]"></i>
                                                        </button>
                                                    <% } else { %>
                                                        <a href="/admin/courses" class="opacity-0 group-hover:opacity-100 w-6 h-6 rounded-lg bg-slate-100 text-slate-400 hover:bg-slate-200 flex items-center justify-center transition-all flex-none" title="Edit in courses">
                                                            <i class="fa-solid fa-arrow-right text-[9px]"></i>
                                                        </a>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </main>

                <!-- ---------------- EDIT COURSE MODAL ---------------- -->
                <div id="editCourseModal"
                    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                    <div
                        class="bg-white rounded-2xl shadow-xl w-full max-w-lg transform transition-all scale-100 flex flex-col max-h-[85vh]">
                        <div
                            class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50 flex-none rounded-t-2xl">
                            <h3 class="text-lg font-bold text-slate-800">Edit Course</h3>
                            <button onclick="closeEditModal()"
                                class="text-slate-400 hover:text-slate-600 transition-colors">
                                <i class="fa-solid fa-times text-xl"></i>
                            </button>
                        </div>

                        <div class="overflow-y-auto custom-scrollbar flex-grow">
                            <form id="editCourseForm" method="POST" class="p-6 space-y-4 pb-12">
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Course Title</label>
                                    <input type="text" name="title" id="edit-title" required
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                                    <textarea name="description" id="edit-description" required rows="3"
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-sm font-semibold text-slate-700">Zoom Meeting
                                            Details</label>
                                        <button type="button" onclick="showLinkHelper()"
                                            class="text-[10px] text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-1">
                                            <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-fill from Link
                                        </button>
                                    </div>

                                    <!-- Hidden Helper Input -->
                                    <div id="link-helper-container" class="hidden mb-3">
                                        <input type="text" id="zoom-link-helper"
                                            placeholder="Paste full Zoom URL here..."
                                            oninput="autoFillZoomDetails(this.value)"
                                            class="w-full px-4 py-1.5 text-xs rounded-lg border border-blue-200 bg-blue-50 focus:ring-1 focus:ring-blue-500 outline-none transition-all italic">
                                    </div>

                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="relative">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                                <i class="fa-solid fa-hashtag text-slate-400"></i>
                                            </div>
                                            <input type="text" name="zoomMeetingId" id="edit-zoomMeetingId"
                                                placeholder="Meeting ID"
                                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                        </div>
                                        <div class="relative">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                                <i class="fa-solid fa-key text-slate-400"></i>
                                            </div>
                                            <input type="text" name="zoomPassword" id="edit-zoomPassword"
                                                placeholder="Password"
                                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                        </div>
                                    </div>
                                    <div class="mt-3 relative">
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Daily Live Schedule (Admin Only)</label>
                                        <div class="relative">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                                <i class="fa-solid fa-clock text-slate-400"></i>
                                            </div>
                                            <input type="text" name="dailyLiveTime" id="edit-dailyLiveTime"
                                                placeholder="e.g. 10:30 AM Everyday"
                                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                        </div>
                                    </div>
                                </div>



                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Start
                                            Date</label>
                                        <input type="date" name="startDate" id="edit-startDate"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">End Date</label>
                                        <input type="date" name="endDate" id="edit-endDate"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Enrollment
                                        Deadline</label>
                                    <input type="date" name="enrollmentDeadline" id="edit-enrollmentDeadline"
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    <p class="text-xs text-slate-400 mt-1">Users cannot enroll after this date</p>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Price (₹)</label>
                                        <input type="number" name="price" id="edit-price" required min="0"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Original Price
                                            (₹)</label>
                                        <input type="number" name="originalPrice" id="edit-originalPrice" required
                                            min="0"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="relative">
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Icon
                                            Emoji</label>
                                        <input type="hidden" name="icon" id="edit-icon-input">

                                        <!-- Dropdown Trigger -->
                                        <button type="button" id="edit-icon-dropdown-trigger"
                                            class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 flex items-center justify-center">
                                                    <span id="edit-selected-icon-display"
                                                        class="text-2xl leading-none">📚</span>
                                                </div>
                                                <span id="edit-selected-icon-label"
                                                    class="text-sm font-semibold text-slate-700">Books</span>
                                            </div>
                                            <i
                                                class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div id="icon-dropdown-menu-edit"
                                            class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                            <div class="grid grid-cols-2 gap-2">
                                                <% const editIcons=[ { emoji: '📚' , label: 'Books' }, { emoji: '📈' ,
                                                    label: 'Chart Up' }, { emoji: '📉' , label: 'Chart Down' }, {
                                                    emoji: '💰' , label: 'Money' }, { emoji: '🎓' , label: 'Graduation'
                                                    }, { emoji: '💎' , label: 'Premium' }, { emoji: '🚀' ,
                                                    label: 'Growth' }, { emoji: '📊' , label: 'Analysis' }, {
                                                    emoji: '🧠' , label: 'Psychology' }, { emoji: '🎯' , label: 'Target'
                                                    }, { emoji: '💡' , label: 'Idea' }, { emoji: '⭐' , label: 'Featured'
                                                    } ]; %>
                                                    <% editIcons.forEach(item=> { %>
                                                        <button type="button"
                                                            onclick="selectEditIcon(this, '<%= item.emoji %>', '<%= item.label %>')"
                                                            data-icon="<%= item.emoji %>" data-label="<%= item.label %>"
                                                            class="edit-icon-btn w-full flex items-center justify-start gap-2 px-1 py-2 rounded-lg border border-slate-100 hover:bg-blue-50 hover:border-blue-200 transition-all group/btn bg-white">
                                                            <span
                                                                class="text-2xl transition-transform group-hover/btn:scale-110 text-slate-400 grayscale group-hover/btn:grayscale-0">
                                                                <%= item.emoji %>
                                                            </span>
                                                            <span
                                                                class="text-sm font-medium text-slate-700 group-hover/btn:text-slate-900">
                                                                <%= item.label %>
                                                            </span>
                                                        </button>
                                                        <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="relative">
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Color
                                            Theme</label>
                                        <input type="hidden" name="colorTheme" id="edit-color-input">

                                        <!-- Dropdown Trigger -->
                                        <button type="button" id="edit-color-dropdown-trigger"
                                            class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                            <div class="flex items-center gap-3">
                                                <div id="edit-selected-color-preview"
                                                    class="w-8 h-8 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center border border-blue-100">
                                                    <div class="w-4 h-4 rounded-full bg-current"></div>
                                                </div>
                                                <span id="edit-selected-color-label"
                                                    class="text-sm font-semibold text-slate-700">Blue</span>
                                            </div>
                                            <i
                                                class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div id="color-dropdown-menu-edit"
                                            class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                            <div class="grid grid-cols-2 gap-2">
                                                <% const colors=[ { value: 'blue' , label: 'Blue' , bg: 'bg-blue-50' ,
                                                    text: 'text-blue-500' }, { value: 'indigo' , label: 'Indigo' ,
                                                    bg: 'bg-indigo-50' , text: 'text-indigo-500' }, { value: 'purple' ,
                                                    label: 'Purple' , bg: 'bg-purple-50' , text: 'text-purple-500' }, {
                                                    value: 'green' , label: 'Green' , bg: 'bg-green-50' ,
                                                    text: 'text-green-500' }, { value: 'red' , label: 'Red' ,
                                                    bg: 'bg-red-50' , text: 'text-red-500' }, { value: 'yellow' ,
                                                    label: 'Yellow' , bg: 'bg-yellow-50' , text: 'text-yellow-500' }, {
                                                    value: 'orange' , label: 'Orange' , bg: 'bg-orange-50' ,
                                                    text: 'text-orange-500' }, { value: 'teal' , label: 'Teal' ,
                                                    bg: 'bg-teal-50' , text: 'text-teal-500' } ]; %>
                                                    <% colors.forEach(item=> { %>
                                                        <button type="button"
                                                            onclick="selectEditColor(this, '<%= item.value %>', '<%= item.label %>', '<%= item.bg %>', '<%= item.text %>')"
                                                            data-color="<%= item.value %>"
                                                            data-label="<%= item.label %>" data-bg="<%= item.bg %>"
                                                            data-text="<%= item.text %>"
                                                            class="edit-color-btn w-full flex items-center justify-start gap-2 px-2 py-2 rounded-lg border border-slate-100 hover:bg-slate-50 transition-all group/btn bg-white">
                                                            <div
                                                                class="w-8 h-8 rounded-full <%= item.bg %> <%= item.text %> flex items-center justify-center border border-slate-100">
                                                                <div class="w-4 h-4 rounded-full bg-current"></div>
                                                            </div>
                                                            <span class="text-sm font-medium text-slate-700">
                                                                <%= item.label %>
                                                            </span>
                                                        </button>
                                                        <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="p-6 border-t border-slate-100 bg-slate-50 flex-none rounded-b-2xl">
                            <div class="flex gap-3">
                                <button type="button" onclick="closeEditModal()"
                                    class="flex-1 py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-colors">
                                    Cancel
                                </button>
                                <button type="submit" form="editCourseForm"
                                    class="flex-1 py-2.5 px-4 bg-brand-navy hover:bg-brand-navy/90 text-white font-bold rounded-xl shadow-lg shadow-brand-navy/20 transition-all transform hover:-translate-y-0.5">
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ======== HERO IMAGE CROP MODAL ======== -->
                <div id="cropModal"
                    class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
                    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl flex flex-col overflow-hidden"
                        style="max-height:90vh">
                        <!-- Header -->
                        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-none">
                            <div>
                                <h3 class="text-lg font-bold text-slate-800">Adjust Hero Image</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Drag to reposition · Scroll to zoom</p>
                            </div>
                            <button id="crop-cancel-btn"
                                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100 text-slate-500 transition-colors">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Cropper area -->
                        <div class="flex-1 bg-slate-900 overflow-hidden" style="min-height:300px;max-height:55vh">
                            <img id="crop-image" src="" alt="Crop preview" style="display:block;max-width:100%">
                        </div>

                        <!-- Aspect ratio selector -->
                        <div class="px-6 py-3 border-b border-slate-100 flex items-center gap-3 flex-none">
                            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Ratio</span>
                            <button onclick="setCropRatio(16/9)"
                                class="crop-ratio-btn px-3 py-1 rounded-lg text-sm font-bold bg-brand-navy text-white">16:9</button>
                            <button onclick="setCropRatio(2/1)"
                                class="crop-ratio-btn px-3 py-1 rounded-lg text-sm font-bold bg-slate-100 text-slate-700">2:1</button>
                            <button onclick="setCropRatio(4/3)"
                                class="crop-ratio-btn px-3 py-1 rounded-lg text-sm font-bold bg-slate-100 text-slate-700">4:3</button>
                            <button onclick="setCropRatio(NaN)"
                                class="crop-ratio-btn px-3 py-1 rounded-lg text-sm font-bold bg-slate-100 text-slate-700">Free</button>
                        </div>

                        <!-- Footer actions -->
                        <div class="px-6 py-4 flex justify-end gap-3 flex-none">
                            <button id="crop-cancel-btn2"
                                class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm transition-colors">Cancel</button>
                            <button id="crop-confirm-btn"
                                class="px-5 py-2.5 rounded-xl bg-brand-navy hover:bg-brand-navy/90 text-white font-bold text-sm shadow-lg shadow-brand-navy/25 transition-all hover:-translate-y-0.5">
                                <i class="fa-solid fa-crop mr-1.5"></i>Crop &amp; Upload
                            </button>
                        </div>
                    </div>
                </div>
                </main>
                <%- include('../partials/layout_wrapper_bottom', { hideFooter: true }) %>

                    <script src="/javascripts/main.js"></script>
                    <div id="admin-data" data-live-sessions='<%- JSON.stringify(locals.liveSessions || {}) %>'
                        data-courses='<%- JSON.stringify(safeCourses) %>'></div>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
                    <script src="/javascripts/admin.js"></script>
                    <!-- Custom Scripts for Zoom Management -->
                    <script>
                        function showLinkHelper() {
                            const container = document.getElementById('link-helper-container');
                            container.classList.toggle('hidden');
                            if (!container.classList.contains('hidden')) {
                                document.getElementById('zoom-link-helper').focus();
                            }
                        }

                        function autoFillZoomDetails(url) {
                            if (!url) return;

                            // Extract ID: looks for /j/ followed by numbers
                            const idMatch = url.match(/\/j\/(\d+)/);
                            if (idMatch && idMatch[1]) {
                                document.getElementById('edit-zoomMeetingId').value = idMatch[1];
                            }

                            // Extract Password: looks for pwd= followed by non-ampersand chars
                            const pwdMatch = url.match(/pwd=([^&]+)/);
                            if (pwdMatch && pwdMatch[1]) {
                                document.getElementById('edit-zoomPassword').value = pwdMatch[1];
                            }

                            // Optional: Auto-hide helper and clear it if both found
                            if (idMatch && pwdMatch) {
                                setTimeout(() => {
                                    document.getElementById('link-helper-container').classList.add('hidden');
                                    document.getElementById('zoom-link-helper').value = '';
                                }, 800);
                            }
                        }
                    </script>
</body>


</html>