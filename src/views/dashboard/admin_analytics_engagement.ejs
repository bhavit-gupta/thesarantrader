<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
    <title>Engagement Analytics — The Saran Trader</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="stylesheet" href="/stylesheets/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="font-sans antialiased text-slate-700 bg-slate-50 min-h-screen">
<%- include('../partials/layout_wrapper_top', { pageTitle: 'Engagement' }) %>

<main class="flex-grow pb-24">
<div class="max-w-[1500px] mx-auto px-4 lg:px-8 pt-6">

    <!-- Header -->
    <div class="mb-8 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/admin/analytics" class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-brand-gold/10 hover:text-brand-gold transition-all"><i class="fa-solid fa-arrow-left text-xs"></i></a>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight leading-none">Engagement Analytics</h1>
                <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-0.5">Community • Chat • Testimonials</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/admin/analytics" class="flex items-center gap-2 px-4 py-2 rounded-xl text-[11px] font-bold uppercase tracking-widest text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all"><i class="fa-solid fa-gauge-high text-xs"></i> Overview</a>
            <a href="/admin/analytics/revenue" class="flex items-center gap-2 px-4 py-2 rounded-xl text-[11px] font-bold uppercase tracking-widest text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all"><i class="fa-solid fa-indian-rupee-sign text-xs"></i> Revenue</a>
            <a href="/admin/analytics/courses" class="flex items-center gap-2 px-4 py-2 rounded-xl text-[11px] font-bold uppercase tracking-widest text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all"><i class="fa-solid fa-book-open text-xs"></i> Courses</a>
            <a href="/admin/analytics/users" class="flex items-center gap-2 px-4 py-2 rounded-xl text-[11px] font-bold uppercase tracking-widest text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all"><i class="fa-solid fa-users text-xs"></i> Users</a>
            <a href="/admin/analytics/engagement" class="flex items-center gap-2 px-4 py-2 rounded-xl text-[11px] font-bold uppercase tracking-widest bg-brand-gold/10 text-brand-gold"><i class="fa-solid fa-heart text-xs"></i> Engagement</a>
        </div>
    </div>

    <!-- Tab Switcher -->
    <div class="flex gap-2 mb-6 flex-wrap">
        <a href="?tab=community" class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all <%= tab === 'community' ? 'bg-violet-500 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-500 hover:border-violet-300' %>">
            <i class="fa-solid fa-newspaper mr-1"></i> Community (<%= totalPosts %>)
        </a>
        <a href="?tab=chat" class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all <%= tab === 'chat' ? 'bg-cyan-500 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-500 hover:border-cyan-300' %>">
            <i class="fa-solid fa-comments mr-1"></i> Chat (<%= totalChat %>)
        </a>
        <a href="?tab=testimonials" class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all <%= tab === 'testimonials' ? 'bg-yellow-500 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-500 hover:border-yellow-300' %>">
            <i class="fa-solid fa-star mr-1"></i> Testimonials (<%= approvedTests.length + pendingTests.length + rejectedTests.length %>)
        </a>
    </div>

    <!-- ── COMMUNITY TAB ── -->
    <% if (tab === 'community') { %>
    <!-- Community KPIs -->
    <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3 mb-8">
        <% [
            { label:'Total Posts',        val: totalPosts,          color:'violet', icon:'fa-newspaper' },
            { label:'Total Comments',     val: totalComments,       color:'purple', icon:'fa-comment' },
            { label:'Total Likes',        val: totalLikes,          color:'pink',   icon:'fa-heart' },
            { label:'Posts w/ Images',    val: postsWithImages,     color:'sky',    icon:'fa-image' },
            { label:'Avg Comments/Post',  val: avgCommentsPerPost,  color:'indigo', icon:'fa-calculator' },
            { label:'Avg Likes/Post',     val: avgLikesPerPost,     color:'rose',   icon:'fa-chart-bar' },
            { label:'Top Poster',         val: topPoster ? topPoster.name.substring(0,12) : 'N/A', color:'amber', icon:'fa-crown' },
            { label:'Top Poster Count',   val: topPoster ? topPoster.count + ' posts' : '—', color:'orange', icon:'fa-fire' }
        ].forEach(k => { %>
        <div class="bg-white border border-slate-100 rounded-2xl p-3 shadow-sm">
            <div class="w-7 h-7 rounded-lg bg-<%= k.color %>-100 text-<%= k.color %>-600 flex items-center justify-center text-[10px] mb-2"><i class="fa-solid <%= k.icon %>"></i></div>
            <p class="text-base font-black text-slate-900 truncate"><%= k.val %></p>
            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wide mt-0.5"><%= k.label %></p>
        </div>
        <% }) %>
    </div>

    <!-- Community Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <h3 class="font-black text-slate-900 mb-1">Posts per Month</h3>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">Community Activity Trend</p>
            <canvas id="postsTrendChart" height="100"></canvas>
        </div>
        <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <h3 class="font-black text-slate-900 mb-1">Most Liked Posts</h3>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">Top 5 by Likes</p>
            <canvas id="topPostsChart" height="100"></canvas>
        </div>
    </div>

    <!-- Top Posts Table -->
    <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
        <div class="p-5 border-b border-slate-50 flex items-center gap-3">
            <h3 class="font-black text-slate-900">Top Community Posts</h3>
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Sorted by Likes</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 text-slate-400 font-black uppercase tracking-widest text-[9px] border-b border-slate-100">
                    <tr><th class="px-6 py-4">Author</th><th class="px-6 py-4">Content</th><th class="px-6 py-4">Likes</th><th class="px-6 py-4">Comments</th><th class="px-6 py-4">Has Image</th><th class="px-6 py-4">Posted</th></tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% if (allPosts.length === 0) { %>
                        <tr><td colspan="6" class="px-6 py-10 text-center text-slate-400 font-semibold">No community posts yet</td></tr>
                    <% } %>
                    <% allPosts.slice(0,20).forEach(p => { %>
                    <tr class="hover:bg-slate-50/70 transition-all">
                        <td class="px-6 py-4 font-bold text-slate-800 text-sm"><%= p.userName %></td>
                        <td class="px-6 py-4 text-sm text-slate-600 max-w-[250px] truncate"><%= p.title || p.content.substring(0,60) %>...</td>
                        <td class="px-6 py-4 font-black text-pink-500"><i class="fa-solid fa-heart text-xs mr-1"></i><%= p.likes %></td>
                        <td class="px-6 py-4 font-bold text-slate-600"><%= p.comments ? p.comments.length : 0 %></td>
                        <td class="px-6 py-4"><span class="text-[9px] font-black uppercase tracking-widest <%= p.imageUrl ? 'text-emerald-500' : 'text-slate-300' %>"><%= p.imageUrl ? '✓ Yes' : '— No' %></span></td>
                        <td class="px-6 py-4 text-[11px] text-slate-400 font-semibold"><%= new Date(p.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <!-- ── CHAT TAB ── -->
    <% if (tab === 'chat') { %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <% [
            { label:'Total Messages', val: totalChat, color:'cyan',  icon:'fa-comments' },
            { label:'Image Messages', val: chatImages, color:'sky',   icon:'fa-image' },
            { label:'Text Messages',  val: totalChat - chatImages, color:'blue',  icon:'fa-message' },
            { label:'Active Rooms',   val: activeRoomsCount, color:'teal',  icon:'fa-door-open' }
        ].forEach(k => { %>
        <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-<%= k.color %>-100 text-<%= k.color %>-600 flex items-center justify-center text-xs mb-3"><i class="fa-solid <%= k.icon %>"></i></div>
            <p class="text-xl font-black text-slate-900"><%= k.val %></p>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wide mt-1"><%= k.label %></p>
        </div>
        <% }) %>
    </div>

    <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm mb-8">
        <h3 class="font-black text-slate-900 mb-1">Messages per Course Room</h3>
        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">Activity Distribution</p>
        <canvas id="chatPerCourseChart" height="<%= Math.max(80, enrichedChatGroups.length * 30) %>"></canvas>
    </div>

    <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
        <div class="p-5 border-b border-slate-50"><h3 class="font-black text-slate-900">Chat Activity by Course Room</h3></div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 text-slate-400 font-black uppercase tracking-widest text-[9px] border-b border-slate-100">
                    <tr><th class="px-6 py-4">Rank</th><th class="px-6 py-4">Course</th><th class="px-6 py-4">Messages</th><th class="px-6 py-4">Share</th></tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% enrichedChatGroups.forEach((g, i) => { %>
                    <tr class="hover:bg-slate-50/70 transition-all">
                        <td class="px-6 py-4 font-black text-slate-400 text-sm">#<%= i+1 %></td>
                        <td class="px-6 py-4"><div class="flex items-center gap-3"><span class="text-xl"><%= g.icon %></span><span class="font-bold text-slate-800 text-sm"><%= g.title %></span></div></td>
                        <td class="px-6 py-4 font-black text-cyan-600"><%= g.count %></td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden"><div class="h-full bg-cyan-400 rounded-full" style="width:<%= totalChat > 0 ? Math.round((g.count/totalChat)*100) : 0 %>%"></div></div>
                                <span class="text-[10px] font-black text-slate-400"><%= totalChat > 0 ? Math.round((g.count/totalChat)*100) : 0 %>%</span>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (enrichedChatGroups.length === 0) { %>
                        <tr><td colspan="4" class="px-6 py-10 text-center text-slate-400 font-semibold">No chat messages yet</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <!-- ── TESTIMONIALS TAB ── -->
    <% if (tab === 'testimonials') { %>
    <!-- Testimonial KPIs -->
    <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3 mb-8">
        <% [
            { label:'Approved',      val: approvedTests.length, color:'emerald', icon:'fa-circle-check' },
            { label:'Pending',       val: pendingTests.length,  color:'amber',   icon:'fa-clock' },
            { label:'Rejected',      val: rejectedTests.length, color:'red',     icon:'fa-ban' },
            { label:'Approval Rate', val: approvalRate + '%',   color:'green',   icon:'fa-percent' },
            { label:'Avg Rating',    val: avgRating + '★',      color:'yellow',  icon:'fa-star' },
            { label:'Featured',      val: featuredCount,        color:'brand',   icon:'fa-crown' },
            { label:'Total',         val: approvedTests.length + pendingTests.length + rejectedTests.length, color:'slate', icon:'fa-layer-group' }
        ].forEach(k => { %>
        <div class="bg-white border border-slate-100 rounded-2xl p-3 shadow-sm">
            <div class="w-7 h-7 rounded-lg bg-<%= k.color === 'brand' ? 'yellow' : k.color %>-100 text-<%= k.color === 'brand' ? 'yellow' : k.color %>-600 flex items-center justify-center text-[10px] mb-2"><i class="fa-solid <%= k.icon %>"></i></div>
            <p class="text-base font-black text-slate-900"><%= k.val %></p>
            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wide mt-0.5"><%= k.label %></p>
        </div>
        <% }) %>
    </div>

    <!-- Testimonial Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <h3 class="font-black text-slate-900 mb-1">Rating Distribution</h3>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">1★ to 5★ (Approved only)</p>
            <canvas id="ratingBarChart" height="100"></canvas>
        </div>
        <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm">
            <h3 class="font-black text-slate-900 mb-1">Status Funnel</h3>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">Pending → Approved / Rejected</p>
            <canvas id="testStatusChart" height="100"></canvas>
        </div>
    </div>

    <!-- Pending Testimonials Quick Action -->
    <% if (pendingTests.length > 0) { %>
    <div class="bg-amber-50 border border-amber-200 rounded-2xl overflow-hidden mb-6">
        <div class="p-5 border-b border-amber-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center text-sm"><i class="fa-solid fa-clock"></i></div>
                <h3 class="font-black text-slate-900">Pending Review (<%= pendingTests.length %>)</h3>
            </div>
            <a href="/admin/testimonials" class="text-[10px] font-black text-amber-600 uppercase tracking-widest hover:underline">Manage All →</a>
        </div>
        <div class="divide-y divide-amber-100">
            <% pendingTests.slice(0,5).forEach(t => { %>
            <div class="px-6 py-4 flex items-start gap-4">
                <div class="w-9 h-9 rounded-full bg-amber-200 text-amber-700 flex items-center justify-center text-xs font-black flex-shrink-0"><%= t.userName.charAt(0).toUpperCase() %></div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-bold text-slate-800 text-sm"><%= t.userName %></span>
                        <div class="flex items-center gap-0.5">
                            <% for(let s=1;s<=5;s++){ %><i class="fa-<%= s <= t.rating ? 'solid' : 'regular' %> fa-star text-[10px] <%= s <= t.rating ? 'text-amber-400' : 'text-slate-200' %>"></i><% } %>
                        </div>
                    </div>
                    <p class="text-sm text-slate-600 truncate"><%= t.message.substring(0,100) %><%= t.message.length > 100 ? '...' : '' %></p>
                </div>
                <span class="text-[10px] text-slate-400 font-semibold flex-shrink-0"><%= new Date(t.submittedAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></span>
            </div>
            <% }) %>
        </div>
        <% if (pendingTests.length > 5) { %>
        <div class="px-6 py-3 text-center"><a href="/admin/testimonials" class="text-[10px] font-black text-amber-600 uppercase tracking-widest hover:underline">+ <%= pendingTests.length - 5 %> more → Manage All</a></div>
        <% } %>
    </div>
    <% } %>

    <!-- Approved Testimonials -->
    <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
        <div class="p-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-black text-slate-900">Approved Testimonials</h3>
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest"><%= approvedTests.length %> total</span>
        </div>
        <div class="divide-y divide-slate-50">
            <% if (approvedTests.length === 0) { %>
                <div class="px-6 py-10 text-center text-slate-400 font-semibold">No approved testimonials</div>
            <% } %>
            <% approvedTests.slice(0,10).forEach(t => { %>
            <div class="px-6 py-4 flex items-start gap-4">
                <div class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-black flex-shrink-0"><%= t.userName.charAt(0).toUpperCase() %></div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-bold text-slate-800 text-sm"><%= t.userName %></span>
                        <% if (t.isFeatured) { %><span class="px-1.5 py-0.5 rounded-md text-[8px] font-black uppercase tracking-widest bg-brand-gold/20 text-brand-gold">★ Featured</span><% } %>
                        <div class="flex items-center gap-0.5">
                            <% for(let s=1;s<=5;s++){ %><i class="fa-<%= s <= t.rating ? 'solid' : 'regular' %> fa-star text-[10px] <%= s <= t.rating ? 'text-amber-400' : 'text-slate-200' %>"></i><% } %>
                        </div>
                    </div>
                    <p class="text-sm text-slate-600"><%= t.message.substring(0,120) %><%= t.message.length > 120 ? '...' : '' %></p>
                </div>
                <span class="text-[10px] text-slate-400 font-semibold flex-shrink-0"><%= new Date(t.submittedAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
            </div>
            <% }) %>
        </div>
        <% if (approvedTests.length > 10) { %>
        <div class="px-6 py-3 border-t border-slate-50 text-center"><a href="/admin/testimonials" class="text-[10px] font-black text-brand-gold uppercase tracking-widest hover:underline">View All <%= approvedTests.length %> Testimonials →</a></div>
        <% } %>
    </div>
    <% } %>

</div>
</main>
<%- include('../partials/layout_wrapper_bottom', { hideFooter: true }) %>
    <script src="/javascripts/main.js"></script>
    <script src="/javascripts/admin.js"></script>
    <script>
    const monthlyPosts = <%- JSON.stringify(monthlyPosts) %>;
    const ratingDist = <%- JSON.stringify(ratingDist) %>;
    const allPosts = <%- JSON.stringify(allPosts.slice(0,5).map(p => ({ userName: p.userName, likes: p.likes, content: (p.title || p.content).substring(0,30) }))) %>;
    const enrichedChatGroups = <%- JSON.stringify(enrichedChatGroups) %>;
    const approvedCount = <%= approvedTests.length %>;
    const pendingCount = <%= pendingTests.length %>;
    const rejectedCount = <%= rejectedTests.length %>;

    const labels12 = Object.keys(monthlyPosts).map(k => {
        const [y,m] = k.split('-');
        return new Date(y,m-1).toLocaleDateString('en-IN',{month:'short',year:'2-digit'});
    });

    // Community: Posts trend
    if (document.getElementById('postsTrendChart')) {
        new Chart(document.getElementById('postsTrendChart'), {
            type: 'bar',
            data: { labels: labels12, datasets: [{ label: 'Posts', data: Object.values(monthlyPosts),
                backgroundColor: 'rgba(139,92,246,0.8)', borderRadius: 6, borderSkipped: false }] },
            options: { responsive: true, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1, font:{size:10} }, grid:{color:'#f1f5f9'} }, x: { ticks:{font:{size:10}}, grid:{display:false} } } }
        });
    }

    // Community: Top posts
    if (document.getElementById('topPostsChart')) {
        new Chart(document.getElementById('topPostsChart'), {
            type: 'bar',
            data: { labels: allPosts.map(p => p.userName + ': ' + p.content.substring(0,20)),
                datasets: [{ label: 'Likes', data: allPosts.map(p => p.likes),
                    backgroundColor: '#ec4899', borderRadius: 6, borderSkipped: false }] },
            options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { stepSize: 1, font:{size:10} }, grid:{color:'#f1f5f9'} }, y: { ticks:{font:{size:10}}, grid:{display:false} } } }
        });
    }

    // Chat per course
    if (document.getElementById('chatPerCourseChart')) {
        new Chart(document.getElementById('chatPerCourseChart'), {
            type: 'bar',
            data: { labels: enrichedChatGroups.map(g => g.icon + ' ' + g.title.substring(0,20)),
                datasets: [{ label: 'Messages', data: enrichedChatGroups.map(g => g.count),
                    backgroundColor: '#06b6d4', borderRadius: 6, borderSkipped: false }] },
            options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { stepSize: 1, font:{size:10} }, grid:{color:'#f1f5f9'} }, y: { ticks:{font:{size:10}}, grid:{display:false} } } }
        });
    }

    // Rating distribution
    if (document.getElementById('ratingBarChart')) {
        new Chart(document.getElementById('ratingBarChart'), {
            type: 'bar',
            data: { labels: ['1★','2★','3★','4★','5★'],
                datasets: [{ label: 'Reviews', data: ratingDist.map(r => r.count),
                    backgroundColor: ['#ef4444','#f97316','#f59e0b','#84cc16','#10b981'], borderRadius: 6, borderSkipped: false }] },
            options: { responsive: true, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1, font:{size:10} }, grid:{color:'#f1f5f9'} }, x: { ticks:{font:{size:11,weight:'bold'}}, grid:{display:false} } } }
        });
    }

    // Testimonial status donut
    if (document.getElementById('testStatusChart')) {
        new Chart(document.getElementById('testStatusChart'), {
            type: 'doughnut',
            data: { labels: ['Approved','Pending','Rejected'],
                datasets: [{ data: [approvedCount, pendingCount, rejectedCount],
                    backgroundColor: ['#10b981','#f59e0b','#ef4444'], borderWidth: 2, borderColor: '#fff' }] },
            options: { responsive: true, cutout: '60%', plugins: { legend: { position: 'bottom', labels: { font:{size:10}, padding:8 } } } }
        });
    }
    </script>
</body>
</html>
