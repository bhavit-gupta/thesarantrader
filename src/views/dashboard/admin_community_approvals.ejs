<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Community Moderation - Admin</title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <%- include('../partials/layout_wrapper_top', { pageTitle: 'Community Moderation' }) %>

        <main class="flex-grow pb-12">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-10">

                <!-- Header -->
                <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-slate-800">Community Moderation 🛡️</h1>
                        <p class="text-slate-500 mt-1">Review and manage community discussions and comments</p>
                    </div>
                    <a href="/admin/dashboard"
                        class="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition-colors">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Dashboard
                    </a>
                </div>

                <!-- Statistics Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                    <!-- Pending Comments Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600 text-xl">
                                <i class="fa-solid fa-comments"></i>
                            </div>
                            <div>
                                <p class="text-2xl font-bold text-slate-800"><%= stats.pendingCommentsCount %></p>
                                <p class="text-sm text-slate-500">Pending Comments</p>
                            </div>
                        </div>
                    </div>

                    <!-- Approved Total Card -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-600 text-xl">
                                <i class="fa-solid fa-check-double"></i>
                            </div>
                            <div>
                                <p class="text-2xl font-bold text-slate-800"><%= stats.approvedCommentsCount %></p>
                                <p class="text-sm text-slate-500">Total Approved Comments</p>
                            </div>
                        </div>
                    </div>
                </div>



                <!-- Pending Comments Section -->
                <div>
                    <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-comment-dots text-orange-600"></i>
                        Pending User Comments
                    </h2>

                    <% if (pendingComments.length === 0) { %>
                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                            <div class="text-5xl mb-4">✨</div>
                            <h3 class="text-xl font-bold text-slate-800 mb-2">No pending comments</h3>
                            <p class="text-slate-500">All community comments have been reviewed.</p>
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% pendingComments.forEach(item => { %>
                            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-all flex flex-col" data-comment-id="<%= item.comment.id %>">
                                <div class="flex items-start justify-between mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white font-bold text-sm">
                                            <%= (item.comment.userName && item.comment.userName.length > 0) ? item.comment.userName.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold text-slate-800"><%= item.comment.userName %></p>
                                            <p class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">On Post: <%= item.post.title || 'Official Update' %></p>
                                        </div>
                                    </div>
                                    <span class="px-2 py-1 rounded-full bg-orange-100 text-orange-700 text-[10px] font-bold uppercase tracking-wider">Pending</span>
                                </div>

                                <div class="bg-slate-50 rounded-xl p-4 mb-6 border border-slate-100 flex-grow">
                                    <p class="text-slate-700 text-sm italic leading-relaxed">"<%= item.comment.content %>"</p>
                                </div>

                                <div class="flex gap-2">
                                    <button onclick="reviewItem('comment', '<%= item.comment.id %>', 'approve', '<%= item.post.id %>')" 
                                        class="flex-1 px-4 py-2 rounded-lg bg-green-600 text-white font-semibold text-sm hover:bg-green-700 transition-colors">
                                        <i class="fa-solid fa-check mr-1"></i> Approve
                                    </button>
                                    <button onclick="reviewItem('comment', '<%= item.comment.id %>', 'reject', '<%= item.post.id %>')" 
                                        class="flex-1 px-4 py-2 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors border border-red-200">
                                        <i class="fa-solid fa-times mr-1"></i> Reject
                                    </button>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

            </div>
        </main>

    <%- include('../partials/layout_wrapper_bottom', { hideFooter: true }) %>

    <script src="/javascripts/main.js" defer></script>
    <script>
        /**
         * Review Endpoint Handler
         * Matches functionality from admin_testimonials for consistency
         */
        function reviewItem(type, itemId, action, postId = null) {
            if(!confirm(`Are you sure you want to ${action} this ${type}?`)) return;

            const endpoint = type === 'post' 
                ? `/api/admin/community/posts/${itemId}/review`
                : `/api/admin/community/posts/${postId}/comments/${itemId}/review`;
            
            // Set loading state if needed
            
            fetch(endpoint, {
                method: 'PUT',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ 
                    action, 
                    _csrf: document.querySelector('meta[name="csrf-token"]').content 
                })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    // Use the global toast system if available, otherwise fallback
                    if (window.showToast) window.showToast(data.message, 'success');
                    else alert(data.message);

                    const selector = type === 'post' ? `[data-post-id="${itemId}"]` : `[data-comment-id="${itemId}"]`;
                    const element = document.querySelector(selector);
                    if (element) {
                        element.style.opacity = '0';
                        element.style.transform = 'scale(0.95)';
                        setTimeout(() => element.remove(), 300);
                    }
                } else {
                    if (window.showToast) window.showToast(data.message || 'Error', 'error');
                    else alert(data.message || 'Error');
                }
            })
            .catch(err => {
                console.error('Moderation error:', err);
                if (window.showToast) window.showToast('Server connection failed', 'error');
            });
        }
    </script>
</body>

</html>
