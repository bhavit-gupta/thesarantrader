<!-- 
========================================
FILE: admin_course_videos.ejs
PURPOSE: Admin Course Video Management
========================================

DESCRIPTION:
Complete video lesson management interface for a specific course.
Allows admin to add, edit, delete, and preview YouTube video lessons.

FEATURES:
- Add new video lessons with metadata
- Edit existing videos (title, description, YouTube URL)
- Delete videos with confirmation
- Preview videos in modal player
- YouTube thumbnail display
- Drag-and-drop reordering (if implemented)
- Empty state for courses with no videos

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- course (object): Course being managed
  - id, title
- videos (array): Course video lessons
  - id, title, description, youtubeUrl, order, createdAt

VIDEO FORM FIELDS:
- Title (required): Lesson name
- Description (optional): Lesson overview
- YouTube URL (required): Valid YouTube video link

MODALS:
1. Add Video Modal - Form to create new lesson
2. Edit Video Modal - Form to update existing lesson
3. Player Modal - YouTube iframe player for preview
4. Delete Confirmation - Confirm video removal

YOUTUBE URL VALIDATION:
Supports these YouTube URL formats:
- youtube.com/watch?v=VIDEO_ID
- youtu.be/VIDEO_ID
- youtube.com/embed/VIDEO_ID
- youtube.com/v/VIDEO_ID
- youtube.com/shorts/VIDEO_ID

Extracts video ID using regex pattern:
/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/

ACCESS CONTROL:
- Admin only

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- admin.js: Video CRUD operations, modal management, YouTube API

FEATURES:
- YouTube thumbnail fetch
- Video ID extraction and validation
- Player modal with responsive iframe
- Click-to-play thumbnail preview
- Course context display
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage Videos - <%= course.title %>
    </title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <div class="flex min-h-screen">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px]">
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 bg-brand-navy border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
                <button id="sidebar-toggle" class="p-2 text-slate-400 hover:text-white transition-colors" aria-label="Open sidebar">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>
                <div class="ml-4 flex items-center gap-2">
                    <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded-md">
                    <span class="text-white font-bold text-sm tracking-tight uppercase">Admin Panel</span>
                </div>
            </header>

            <main class="flex-grow pb-12">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-10">
                <!-- ========================================
                     PAGE HEADER SECTION
                     ======================================== -->
                <!-- Contains page title, course context, and add video button -->
                <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <!-- Back navigation link to admin dashboard -->
                        <a href="/admin/dashboard"
                            class="text-sm font-semibold text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1 mb-2">
                            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                        </a>

                        <!-- Page title -->
                        <h1 class="text-3xl font-bold text-slate-800">Manage Videos 📺</h1>

                        <!-- Display current course title for context -->
                        <p class="text-slate-500 mt-1 flex items-center gap-2">
                            Course: <span class="font-semibold text-slate-700">
                                <%= course.title %>
                            </span>
                            <span
                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold border border-blue-100">
                                <i class="fa-solid fa-users"></i>
                                <%= course.users || 0 %> Members
                            </span>
                        </p>
                    </div>

                    <!-- Button to open add video modal -->
                    <button onclick="openAddModal()"
                        class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all transform hover:-translate-y-0.5">
                        <i class="fa-solid fa-plus"></i> Add New Video
                    </button>
                </div>

                <!-- ========================================
                     VIDEO LIST SECTION
                     ======================================== -->
                <!-- Displays all video lessons for this course -->
                <div class="space-y-4">
                    <!-- Check if course has no videos yet -->
                    <% if (videos.length===0) { %>
                        <!-- Empty state: Show when no videos exist -->
                        <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 border-dashed">
                            <!-- Empty state icon -->
                            <div
                                class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-300">
                                <i class="fa-solid fa-film text-3xl"></i>
                            </div>

                            <!-- Empty state message -->
                            <h3 class="text-lg font-bold text-slate-700 mb-1">No videos yet</h3>
                            <p class="text-slate-500 max-w-sm mx-auto">Start adding lessons by clicking the button
                                above.</p>
                        </div>
                        <% } else { %>
                            <!-- Loop through each video lesson -->
                            <% videos.forEach(video=> {
                                // Extract YouTube video ID from URL using regex
                                // Supports multiple YouTube URL formats (watch, embed, youtu.be, shorts)
                                const youtubeRegex =
                                /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
                                const match = video.youtubeUrl.match(youtubeRegex);
                                const videoId = match ? match[1] : "";
                                %>

                                <!-- Video card container -->
                                <div
                                    class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow">

                                    <!-- ========================================
                                         VIDEO THUMBNAIL WITH PLAY OVERLAY
                                         ======================================== -->
                                    <!-- Clickable thumbnail that opens video player modal -->
                                    <div onclick="openPlayerModal('<%= videoId %>')"
                                        class="w-full md:w-64 aspect-video rounded-xl bg-slate-100 overflow-hidden flex-shrink-0 relative group cursor-pointer shadow-sm hover:shadow-md transition-all transform hover:-translate-y-0.5">

                                        <!-- Display custom thumbnail if it exists, otherwise YouTube thumbnail -->
                                        <% if (video.thumbnailUrl) { %>
                                            <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover"
                                                alt="<%= video.title %>">
                                            <% } else if (videoId) { %>
                                                <!-- Display default YouTube thumbnail -->
                                                <img src="https://img.youtube.com/vi/<%= videoId %>/mqdefault.jpg"
                                                    class="w-full h-full object-cover" alt="<%= video.title %>">
                                                <% } else { %>
                                                    <!-- Error state: Invalid YouTube URL and no thumbnail -->
                                                    <div
                                                        class="w-full h-full flex items-center justify-center text-slate-400 p-4 text-center">
                                                        <i class="fa-solid fa-triangle-exclamation text-2xl mb-2"></i>
                                                        <p class="text-xs">Invalid YouTube URL</p>
                                                    </div>
                                                    <% } %>

                                                        <!-- Play button overlay (shows on hover) -->
                                                        <div
                                                            class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                                                            <!-- Centered play button -->
                                                            <div
                                                                class="w-12 h-12 bg-white/90 rounded-full flex items-center justify-center text-blue-600 shadow-xl transform group-hover:scale-110 transition-transform">
                                                                <i class="fa-solid fa-play text-xl ml-1"></i>
                                                            </div>
                                                        </div>
                                    </div>

                                    <!-- ========================================
                                         VIDEO METADATA AND ACTIONS
                                         ======================================== -->
                                    <div class="flex-grow">
                                        <!-- Video title -->
                                        <h3 class="text-xl font-bold text-slate-800 mb-2">
                                            <%= video.title %>
                                        </h3>

                                        <!-- Video description (or default message if empty) -->
                                        <p class="text-sm text-slate-600 mb-4 italic">
                                            <%= video.description || "No description provided." %>
                                        </p>

                                        <!-- Action buttons for edit and delete -->
                                        <div class="flex items-center gap-3 mt-auto">
                                            <!-- Edit button: Opens edit modal with video data pre-filled -->
                                            <button
                                                onclick="openEditModal('<%= video.id %>', '<%= video.title %>', '<%= video.description %>', '<%= video.youtubeUrl %>', '<%= video.thumbnailUrl %>')"
                                                class="text-sm font-bold text-blue-600 hover:text-blue-800 transition-colors uppercase tracking-wider">
                                                Edit
                                            </button>

                                            <!-- Delete button: Confirms before deleting video -->
                                            <button onclick="deleteVideo('<%= video.id %>')"
                                                class="text-sm font-bold text-red-600 hover:text-red-700 transition-colors uppercase tracking-wider">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
                </div>
            </div>
        </main>

        <!-- ========================================
             VIDEO PLAYER MODAL
             ========================================
             Fullscreen modal for playing YouTube videos
             Opened when user clicks on video thumbnail -->
        <div id="videoPlayerModal"
            class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/95 backdrop-blur-md p-4 sm:p-8 [&:not(.hidden)]:flex">

            <!-- Close button (top right) -->
            <button onclick="closePlayerModal()"
                class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl transition-colors z-[110]">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Video container with 16:9 aspect ratio -->
            <div class="w-full max-w-5xl aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl relative">
                <!-- YouTube iframe player
                     - src is populated dynamically by openPlayerModal() function
                     - autoplay=1 starts video immediately when modal opens -->
                <iframe id="playerIframe" class="w-full h-full" src="" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>

        <!-- ========================================
             ADD VIDEO MODAL
             ========================================
             Form modal for creating a new video lesson
             Opened by clicking "Add New Video" button -->
        <div id="addVideoModal"
            class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm p-4 [&:not(.hidden)]:flex">

            <!-- Modal card -->
            <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg transform transition-all scale-100 p-6">
                <h3 class="text-xl font-bold text-slate-800 mb-6">Add New Video Lesson</h3>

                <!-- Add video form (handled by JavaScript submit event) -->
                <form id="addVideoForm" class="space-y-4">

                    <!-- Video Title Field (Required) -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Video Title</label>
                        <input type="text" name="title" id="add-title" required
                            placeholder="e.g. Introduction to Risk Management"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                    </div>

                    <!-- Description Field (Optional) -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="add-description" rows="2"
                            placeholder="Briefly describe what this video covers..."
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                    </div>

                    <!-- YouTube URL Field (Required)
                         Accepts any valid YouTube URL format
                         Regex extraction handles URL parsing -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">YouTube URL</label>
                        <input type="url" name="youtubeUrl" id="add-youtubeUrl" required
                            placeholder="https://www.youtube.com/watch?v=..."
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                    </div>

                    <!-- Custom Thumbnail Field (Optional) -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Custom Thumbnail
                            (Optional)</label>
                        <input type="file" name="thumbnail" id="add-thumbnail" accept="image/*"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all file:mr-4 file:py-1 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        <p class="text-[10px] text-slate-400 mt-1">Leave empty to use default YouTube thumbnail.</p>
                    </div>

                    <!-- Action buttons -->
                    <div class="flex gap-3 pt-4">
                        <!-- Cancel button - closes modal without saving -->
                        <button type="button" onclick="closeAddModal()"
                            class="flex-1 py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-colors">
                            Cancel
                        </button>

                        <!-- Submit button - triggers form submit event -->
                        <button type="submit"
                            class="flex-1 py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all">
                            Save Video
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ========================================
             EDIT VIDEO MODAL
             ========================================
             Form modal for updating existing video lesson
             Opened by clicking "Edit" button on video card
             Pre-populated with existing video data -->
        <div id="editVideoModal"
            class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm p-4 [&:not(.hidden)]:flex">

            <!-- Modal card -->
            <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg transform transition-all scale-100 p-6">
                <h3 class="text-xl font-bold text-slate-800 mb-6">Edit Video Lesson</h3>

                <!-- Edit video form (handled by JavaScript submit event) -->
                <form id="editVideoForm" class="space-y-4">

                    <!-- Hidden field stores video ID for update API call -->
                    <input type="hidden" id="edit-videoId">

                    <!-- Video Title Field (Required)
                         Pre-filled by openEditModal() function -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Video Title</label>
                        <input type="text" name="title" id="edit-title" required
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                    </div>

                    <!-- Description Field (Optional)
                         Pre-filled by openEditModal() function -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="edit-description" rows="2"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                    </div>

                    <!-- YouTube URL Field (Required)
                         Pre-filled by openEditModal() function -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">YouTube URL</label>
                        <input type="url" name="youtubeUrl" id="edit-youtubeUrl" required
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                    </div>

                    <!-- Custom Thumbnail Field (Optional) -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Custom Thumbnail
                            (Optional)</label>
                        <div id="edit-thumbnail-preview-container" class="hidden mb-2">
                            <img id="edit-thumbnail-preview" src=""
                                class="w-32 aspect-video rounded-lg object-cover border border-slate-200 shadow-sm"
                                alt="Current Thumbnail">
                            <p class="text-[10px] text-slate-400 mt-1">Current custom thumbnail</p>
                        </div>
                        <input type="file" name="thumbnail" id="edit-thumbnail" accept="image/*"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all file:mr-4 file:py-1 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        <p class="text-[10px] text-slate-400 mt-1">Select a new image to replace current thumbnail.</p>
                    </div>

                    <!-- Action buttons -->
                    <div class="flex gap-3 pt-4">
                        <!-- Cancel button - closes modal without saving changes -->
                        <button type="button" onclick="closeEditModal()"
                            class="flex-1 py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-colors">
                            Cancel
                        </button>

                        <!-- Submit button - triggers form submit event -->
                        <button type="submit"
                            class="flex-1 py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all">
                            Update Video
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            /* ========================================
               JAVASCRIPT INITIALIZATION
               ========================================
               Sets up global variables and event handlers */

            // Get current course ID from server-side EJS variable
            const courseId = '<%= course.id %>';

            // Get CSRF token from meta tag for secure API requests
            const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

            /* ========================================
               VIDEO PLAYER MODAL FUNCTIONS
               ========================================
               Handle opening/closing the fullscreen video player */

            /**
             * Opens the video player modal with specified YouTube video
             * @param {string} videoId - YouTube video ID (11 characters)
             */
            function openPlayerModal(videoId) {
                // Validate video ID exists
                if (!videoId) return;

                // Get iframe element and set source to YouTube embed URL
                // autoplay=1 parameter starts video immediately
                const iframe = document.getElementById('playerIframe');
                iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

                // Show modal by removing 'hidden' class
                document.getElementById('videoPlayerModal').classList.remove('hidden');

                // Disable body scrolling while modal is open
                document.body.style.overflow = 'hidden';
            }

            /**
             * Closes the video player modal and stops video playback
             */
            function closePlayerModal() {
                // Get iframe and clear source (stops video)
                const iframe = document.getElementById('playerIframe');
                iframe.src = '';

                // Hide modal by adding 'hidden' class
                document.getElementById('videoPlayerModal').classList.add('hidden');

                // Re-enable body scrolling
                document.body.style.overflow = '';
            }

            /* ========================================
               ADD VIDEO MODAL FUNCTIONS
               ======================================== */

            /**
             * Opens the add video modal
             */
            function openAddModal() {
                document.getElementById('addVideoModal').classList.remove('hidden');
            }

            /**
             * Closes the add video modal
             */
            function closeAddModal() {
                document.getElementById('addVideoModal').classList.add('hidden');
            }

            /* ========================================
               EDIT VIDEO MODAL FUNCTIONS
               ======================================== */

            /**
             * Opens the edit video modal with pre-filled data
             * @param {string} id - Video database ID
             * @param {string} title - Current video title
             * @param {string} description - Current video description
             * @param {string} url - Current YouTube URL
             */
            function openEditModal(id, title, description, url, thumbnailUrl) {
                // Populate form fields with existing video data
                document.getElementById('edit-videoId').value = id;
                document.getElementById('edit-title').value = title;
                document.getElementById('edit-description').value = description || "";
                document.getElementById('edit-youtubeUrl').value = url;

                // Handle thumbnail preview
                const previewContainer = document.getElementById('edit-thumbnail-preview-container');
                const previewImg = document.getElementById('edit-thumbnail-preview');
                if (thumbnailUrl && thumbnailUrl !== 'null' && thumbnailUrl !== 'undefined' && thumbnailUrl !== '') {
                    previewImg.src = thumbnailUrl;
                    previewContainer.classList.remove('hidden');
                } else {
                    previewContainer.classList.add('hidden');
                }

                // Show modal
                document.getElementById('editVideoModal').classList.remove('hidden');
            }

            /**
             * Closes the edit video modal
             */
            function closeEditModal() {
                document.getElementById('editVideoModal').classList.add('hidden');
            }

            /* ========================================
               ADD VIDEO FORM SUBMISSION HANDLER
               ========================================
               Handles creating a new video lesson via API */

            // Listen for form submission event
            document.getElementById('addVideoForm').addEventListener('submit', async (e) => {
                // Prevent default form submission (page reload)
                e.preventDefault();

                // Get submit button and disable it to prevent double-submission
                const btn = e.target.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Saving...';

                // Create FormData for multipart/form-data upload
                const formData = new FormData();
                formData.append('title', document.getElementById('add-title').value);
                formData.append('description', document.getElementById('add-description').value);
                formData.append('youtubeUrl', document.getElementById('add-youtubeUrl').value);

                const thumbnailFile = document.getElementById('add-thumbnail').files[0];
                if (thumbnailFile) {
                    formData.append('thumbnail', thumbnailFile);
                }

                try {
                    // Make POST request to create video API endpoint
                    const response = await fetch(`/api/admin/courses/${courseId}/videos`, {
                        method: 'POST',
                        headers: {
                            'CSRF-Token': csrfToken  // Include CSRF token for security
                            // Note: Do NOT set Content-Type header with FormData, browser will do it with boundary
                        },
                        body: formData
                    });

                    // Parse JSON response
                    const data = await response.json();

                    if (data.success) {
                        // Success: Reload page to show new video in list
                        window.location.reload();
                    } else {
                        // Error: Show error message and re-enable button
                        alert(data.message || "Failed to add video");
                        btn.disabled = false;
                        btn.innerHTML = 'Save Video';
                    }
                } catch (error) {
                    // Network or parse error
                    console.error("Error:", error);
                    alert("An error occurred. Please try again.");
                    btn.disabled = false;
                    btn.innerHTML = 'Save Video';
                }
            });

            /* ========================================
               UPDATE VIDEO FORM SUBMISSION HANDLER
               ========================================
               Handles updating existing video lesson via API */

            // Listen for edit form submission event
            document.getElementById('editVideoForm').addEventListener('submit', async (e) => {
                // Prevent default form submission (page reload)
                e.preventDefault();

                // Get video ID from hidden field
                const videoId = document.getElementById('edit-videoId').value;

                // Get submit button and disable it to prevent double-submission
                const btn = e.target.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Updating...';

                // Create FormData for multipart/form-data upload
                const formData = new FormData();
                formData.append('title', document.getElementById('edit-title').value);
                formData.append('description', document.getElementById('edit-description').value);
                formData.append('youtubeUrl', document.getElementById('edit-youtubeUrl').value);

                const thumbnailFile = document.getElementById('edit-thumbnail').files[0];
                if (thumbnailFile) {
                    formData.append('thumbnail', thumbnailFile);
                }

                try {
                    // Make POST request to update video API endpoint
                    const response = await fetch(`/api/admin/courses/${courseId}/videos/${videoId}/update`, {
                        method: 'POST',
                        headers: {
                            'CSRF-Token': csrfToken  // Include CSRF token for security
                        },
                        body: formData
                    });

                    // Parse JSON response
                    const data = await response.json();

                    if (data.success) {
                        // Success: Reload page to show updated video data
                        window.location.reload();
                    } else {
                        // Error: Show error message and re-enable button
                        alert(data.message || "Failed to update video");
                        btn.disabled = false;
                        btn.innerHTML = 'Update Video';
                    }
                } catch (error) {
                    // Network or parse error
                    console.error("Error:", error);
                    alert("An error occurred. Please try again.");
                    btn.disabled = false;
                    btn.innerHTML = 'Update Video';
                }
            });

            /* ========================================
               DELETE VIDEO FUNCTION
               ========================================
               Handles permanent deletion of video lesson via API
               Requires user confirmation before proceeding */

            /**
             * Deletes a video lesson from the course
             * @param {string} videoId - Video database ID to delete
             */
            async function deleteVideo(videoId) {
                // Show confirmation dialog before deletion
                // Returns false if user clicks "Cancel"
                if (!confirm("Are you sure you want to delete this video lesson?")) return;

                try {
                    // Make DELETE request to remove video API endpoint
                    const response = await fetch(`/api/admin/courses/${courseId}/videos/${videoId}`, {
                        method: 'DELETE',
                        headers: {
                            'CSRF-Token': csrfToken  // Include CSRF token for security
                        }
                    });

                    // Parse JSON response
                    const data = await response.json();

                    if (data.success) {
                        // Success: Reload page to show updated video list
                        window.location.reload();
                    } else {
                        // Error: Show error message
                        alert(data.message || "Failed to delete video");
                    }
                } catch (error) {
                    // Network or parse error
                    console.error("Error:", error);
                    alert("An error occurred. Please try again.");
                }
            }
        </script>

        <%- include('../partials/footer') %>
    </div>
</div>
</body>

</html>