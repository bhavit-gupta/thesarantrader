<!-- 
========================================
FILE: admin_courses.ejs
PURPOSE: Admin Course Management Page
========================================

DESCRIPTION:
Complete CRUD interface for managing courses including creation, editing,
deletion, and video content management.

FEATURES:
- Create new courses with full details (title, price, dates, icon, etc.)
- Edit existing courses (inline editing)
- Delete courses with confirmation
- Manage course videos (add/edit/delete)
- Course status indicators (ongoing, upcoming, expired)
- Live session link configuration
- Icon and color customization
- Badge management (Bestseller, New, etc.)

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- courses (array): All courses in system
  - id, title, description, price, originalPrice, icon, iconBg, iconColor,
    startDate, endDate, liveLink, badge, badgeColor

ADMIN ACTIONS:
- Create course: Fill form and submit
- Edit course: Click edit, modify fields, save
- Delete course: Click delete with confirmation
- Manage videos: Navigate to video management per course

FORM FIELDS:
- Title, description (required)
- Price, original price (numbers)
- Start date, end date (optional, date pickers)
- Live session link (URL)
- Icon (emoji), icon background color, icon text color
- Badge text, badge color

ACCESS CONTROL:
- Admin only

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- admin.js: Course CRUD operations, form handling, delete confirmations
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
    <title>Manage Courses - Admin Dashboard</title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
    <style>
        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background-color: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <div class="flex min-h-screen">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px]">
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 bg-brand-navy border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
                <button id="sidebar-toggle" class="p-2 text-slate-400 hover:text-white transition-colors" aria-label="Open sidebar">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>
                <div class="ml-4 flex items-center gap-2">
                    <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded-md">
                    <span class="text-white font-bold text-sm tracking-tight uppercase">Admin Panel</span>
                </div>
            </header>

            <main class="flex-grow pb-12 bg-[#f8fafc]">
                <div class="max-w-[1600px] mx-auto px-8 lg:px-12 pt-12">

                    <!-- BRANDED PREMIUM HEADER -->
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
                        <div>
                            <div class="flex items-center gap-4">
                                <div class="w-1.5 h-8 bg-amber-400 rounded-full shadow-[0_0_15px_rgba(251,191,36,0.3)]"></div>
                                <h1 class="text-4xl font-black text-slate-900 tracking-tight">Management Hub</h1>
                            </div>
                            <p class="text-slate-500 font-bold mt-2 text-sm flex items-center gap-2">
                                Operating <span class="text-amber-500"><%= courses.length %> Programs</span> 
                                <span class="w-1 h-1 bg-slate-300 rounded-full"></span> 
                                <span class="text-slate-400">Manage curriculum & enrollment</span>
                            </p>
                        </div>
                        
                        <div class="flex items-center gap-3">
                            <button onclick="openAddModal()" class="px-7 py-3.5 bg-amber-400 hover:bg-amber-500 text-[#0a0f1e] font-black rounded-2xl shadow-xl shadow-amber-400/20 transition-all transform hover:-translate-y-1 flex items-center gap-2.5 border border-amber-500/20 uppercase tracking-tighter text-sm">
                                <i class="fa-solid fa-plus text-xs"></i> New Course
                            </button>
                        </div>
                    </div>

                    <!-- BRANDED TOOLBAR -->
                    <div class="bg-white border border-slate-200 p-2 rounded-2xl mb-10 shadow-sm flex flex-col lg:flex-row items-center gap-2">
                        <div class="flex-grow relative w-full lg:w-auto">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fa-solid fa-magnifying-glass text-slate-300 text-sm"></i>
                            </div>
                            <input type="text" id="course-search" placeholder="Quick find by name..." 
                                class="w-full pl-11 pr-4 py-2.5 bg-transparent border-none focus:ring-0 outline-none font-semibold text-slate-700 placeholder:text-slate-300">
                        </div>
                        
                        <div class="flex items-center gap-2 w-full lg:w-auto border-t lg:border-t-0 lg:border-l border-slate-100 pt-2 lg:pt-0 lg:pl-2">
                            <div class="relative w-full lg:w-[220px]">
                                <select id="course-sort" class="w-full pl-3 pr-10 py-2.5 bg-transparent border-none appearance-none focus:ring-0 outline-none font-bold text-slate-500 text-sm cursor-pointer hover:text-amber-500 transition-colors">
                                    <option value="newest">Sort: Recently Added</option>
                                    <option value="price-low">Price: Lowest first</option>
                                    <option value="price-high">Price: Highest first</option>
                                    <option value="name">Alpha: Name A-Z</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-chevron-down text-slate-300 text-[10px]"></i>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- COURSE MANAGEMENT GRID -->
                    <div id="course-list-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        <% if (courses.length === 0) { %>
                            <div class="col-span-full bg-white rounded-[2rem] p-24 text-center border border-dashed border-slate-200">
                                <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-8">
                                    <i class="fa-solid fa-layer-group text-4xl text-slate-300"></i>
                                </div>
                                <h3 class="text-2xl font-black text-slate-800 tracking-tight text-brand-navy">Ecosystem is Empty</h3>
                                <p class="text-slate-400 max-w-sm mx-auto mt-3 font-medium">No programs found in your current view. Start adding courses to grow your brand.</p>
                                <button onclick="openAddModal()" class="mt-10 px-10 py-4 bg-amber-400 text-[#0a0f1e] font-black rounded-2xl hover:bg-amber-500 transition-all shadow-xl shadow-amber-400/20">
                                    Add First Course
                                </button>
                            </div>
                        <% } %>

                        <% courses.forEach(course => { %>
                            <div class="course-card bg-white rounded-2xl border border-slate-200/60 shadow-sm hover:shadow-2xl hover:shadow-amber-500/5 transition-all duration-500 group flex flex-col relative" 
                                 data-title="<%= course.title.toLowerCase() %>" 
                                 data-price="<%= course.price %>" 
                                 data-date="<%= course.createdAt %>">
                                
                                <!-- Card Media (Brand Placeholder) -->
                                <div class="relative aspect-[16/10] overflow-hidden bg-slate-50 rounded-t-2xl">
                                    <% if (course.thumbnailUrl) { %>
                                        <img src="<%= course.thumbnailUrl %>" alt="<%= course.title %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                    <% } else { %>
                                        <div class="w-full h-full bg-gradient-to-br from-[#0a0f1e] via-[#1a2544] to-[#0a0f1e] flex flex-col items-center justify-center text-white/10 gap-4 group-hover:via-amber-500/10 transition-all duration-700">
                                            <div class="w-16 h-16 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 flex items-center justify-center transform transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3 shadow-2xl">
                                                <span class="text-4xl transition-all duration-500 filter group-hover:drop-shadow-[0_0_8px_rgba(251,191,36,0.5)]">
                                                    <%= course.icon || '📚' %>
                                                </span>
                                            </div>
                                            <span class="text-[9px] font-black uppercase tracking-[0.3em] text-amber-500/40 group-hover:text-amber-500 transition-all">Platform Program</span>
                                        </div>
                                    <% } %>



                                    <!-- Quick Actions Floating Layer (MUST have highest z-index) -->
                                    <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 invisible group-hover:visible transition-all duration-300 flex items-center justify-center gap-2 z-50 backdrop-blur-[2px]">
                                        <button onclick="openAdminCoursesEditModal('<%= course.id %>')" class="w-10 h-10 rounded-xl bg-amber-400 text-[#0a0f1e] flex items-center justify-center hover:bg-amber-500 transition-all transform scale-90 group-hover:scale-100 shadow-xl relative z-50" title="Configure">
                                            <i class="fa-solid fa-wrench text-xs pointer-events-none"></i>
                                        </button>
                                        <button onclick="deleteCourse('<%= course.id %>', this)" class="w-10 h-10 rounded-xl bg-white text-red-500 flex items-center justify-center hover:bg-red-500 hover:text-white transition-all transform scale-90 delay-75 group-hover:scale-100 shadow-xl relative z-50 text-xs" title="Remove">
                                            <i class="fa-solid fa-trash-can pointer-events-none"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Card Bio -->
                                <div class="p-6 flex flex-col flex-grow">
                                    <div class="flex items-center justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-2">
                                            <div class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-[10px] font-black">
                                                ID
                                            </div>
                                            <span class="text-[10px] font-black text-slate-300 uppercase tracking-tighter">#<%= course.id.slice(-6) %></span>
                                        </div>
                                        <span class="px-2 py-0.5 bg-slate-50 text-slate-400 text-[8px] font-black uppercase rounded"><%= course.level || 'Mastery' %></span>
                                    </div>

                                    <a href="/courses/<%= course.id %>/view" class="group/title relative z-20">
                                        <h3 class="text-xl font-black text-slate-800 tracking-tight group-hover/card:text-blue-600 transition-colors">
                                            <%= course.title %>
                                        </h3>
                                    </a>

                                    <p class="text-[11px] font-bold text-slate-400 line-clamp-1 mb-5 opacity-70">
                                        Program Lead: <span class="text-slate-600">The Saran Trader</span>
                                    </p>

                                    <!-- Footer Stats -->
                                    <div class="mt-auto pt-5 border-t border-slate-100 flex items-end justify-between">
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest leading-none">Net Tuition</span>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xl font-black text-slate-900">₹<%= course.price %></span>
                                                <% if (course.originalPrice > course.price) { %>
                                                    <span class="text-[10px] text-slate-300 line-through font-bold">₹<%= course.originalPrice %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="flex flex-col items-end gap-1">
                                            <div class="flex items-center -space-x-1.5">
                                                <div class="w-5 h-5 rounded-full border border-white bg-slate-100 flex items-center justify-center text-[7px] font-black text-slate-400">JK</div>
                                                <div class="w-5 h-5 rounded-full border border-white bg-amber-100 flex items-center justify-center text-[7px] font-black text-amber-600">+<%= course.users %></div>
                                            </div>
                                            <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Enrollment</span>
                                        </div>
                                    </div> <!-- Close Footer Stats -->
                                </div> <!-- Close Bio -->
                            </div> <!-- Close Course Card -->
                        <% }) %>
                    </div> <!-- Close Grid -->
                </div> <!-- Close Max-Width Container -->
            </main>
        </div>
    </div>

    <!-- Add/Edit Course Modal (Unified Overlay) -->
    <div id="courseModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 [&:not(.hidden)]:flex">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl transform transition-all scale-100 flex flex-col max-h-[90vh] overflow-hidden border border-white/20">
            <!-- Modal Header -->
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50 flex-none">
                <div>
                    <h3 id="modalTitle" class="text-xl font-bold text-slate-900">Create New Course</h3>
                    <p id="modalSubttile" class="text-xs text-slate-400 font-semibold uppercase tracking-wider mt-0.5">Define your program parameters</p>
                </div>
                <button onclick="closeModal()" class="w-10 h-10 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-900 transition-all flex items-center justify-center">
                    <i class="fa-solid fa-times text-lg"></i>
                </button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="overflow-y-auto overflow-x-hidden custom-scrollbar flex-grow bg-white">
                <!-- SUBMISSION FORM -->
                <form id="courseForm" action="/admin/courses/add" method="POST" enctype="multipart/form-data" class="space-y-8 p-8">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="courseId" id="form-courseId">

                    <!-- Basic Information Section -->
                    <div class="space-y-6">
                        <div class="flex items-center gap-3 pb-2 border-b border-slate-50">
                            <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center text-xs"><i class="fa-solid fa-info"></i></span>
                            <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">General Details</h4>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-6">
                                <div>
                                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">
                                        Course Title <span class="text-amber-500">*</span>
                                    </label>
                                    <input type="text" name="title" id="form-title" required placeholder="e.g. Price Action Mastery 2.0"
                                        class="w-full px-5 py-3 rounded-xl border border-slate-200 focus:ring-4 focus:ring-amber-500/10 focus:border-amber-400 outline-none transition-all font-bold text-slate-900">
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Program Thumbnail</label>
                                    <div class="relative group">
                                        <input type="file" name="thumbnailUrl" id="thumbnailInput" accept="image/*"
                                            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                                        <div class="w-full px-5 py-3 bg-white border-2 border-dashed border-slate-200 rounded-xl flex items-center gap-4 group-hover:border-amber-400 transition-all">
                                            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center">
                                                <i class="fa-solid fa-image"></i>
                                            </div>
                                            <div class="flex-grow overflow-hidden">
                                                <p class="text-[10px] font-black text-slate-600 uppercase truncate" id="fileNamePlaceholder">Select Image File</p>
                                                <p class="text-[8px] font-bold text-slate-400">JPG, PNG, WebP (Max 2MB)</p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Preview Area -->
                                    <div id="thumbnailPreview" class="hidden mt-4 relative aspect-video rounded-xl overflow-hidden border border-slate-100 bg-slate-50 group/preview">
                                        <img src="" class="w-full h-full object-cover">
                                        <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover/preview:opacity-100 transition-all flex items-center justify-center">
                                            <span class="text-[10px] font-black text-white uppercase tracking-widest">Current Image</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">
                                    Program Bio <span class="text-amber-500">*</span>
                                </label>
                                <textarea name="description" id="form-description" required rows="6" placeholder="Explain what traders will learn in this program..."
                                    class="w-full px-5 py-3 rounded-xl border border-slate-200 focus:ring-4 focus:ring-amber-500/10 focus:border-amber-400 outline-none transition-all font-medium text-slate-700"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Platform & Visibility Section -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 pb-2 border-b border-slate-50">
                                <span class="w-8 h-8 rounded-lg bg-orange-50 text-orange-500 flex items-center justify-center text-xs"><i class="fa-solid fa-eye"></i></span>
                                <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Visibility</h4>
                            </div>
                            <div class="space-y-4">
                                <label class="flex items-center gap-3 p-4 rounded-2xl border border-slate-100 cursor-pointer hover:bg-slate-50 transition-colors group">
                                    <input type="checkbox" name="isPublished" id="form-isPublished" class="w-5 h-5 rounded border-slate-300 text-sky-500 focus:ring-sky-500/20" checked>
                                    <div class="flex flex-col">
                                        <span class="text-sm font-bold text-slate-900">Publish Course</span>
                                        <span class="text-[10px] font-medium text-slate-400">Make it visible to all prospective students</span>
                                    </div>
                                </label>

                            </div>
                        </div>
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 pb-2 border-b border-slate-50">
                                <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-500 flex items-center justify-center text-xs"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                                <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Pricing</h4>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5 ml-1">
                                        Current ₹ <span class="text-amber-500">*</span>
                                    </label>
                                    <input type="number" name="price" id="form-price" required min="0" placeholder="2999"
                                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-4 focus:ring-sky-500/10 outline-none font-bold text-slate-900">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5 ml-1">
                                        Original ₹ <span class="text-amber-500">*</span>
                                    </label>
                                    <input type="number" name="originalPrice" id="form-originalPrice" required min="0" placeholder="5999"
                                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-4 focus:ring-sky-500/10 outline-none font-medium text-slate-400">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Course Meta (Level & Badges) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-4">
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Program Level</label>
                            <select name="level" id="form-level"
                                class="w-full px-5 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-semibold text-slate-700">
                                <option value="">General (No Level)</option>
                                <option value="Learn Step 1">Learn Step 1</option>
                                <option value="Nifty Zoom Live Session">Nifty Zoom Live Session</option>
                                <option value="Nifty+Zoom+Commodity">Nifty+Zoom+Commodity</option>
                            </select>
                        </div>
                        <div class="space-y-4">
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Promotional Badge</label>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                <input type="text" name="badge" id="form-badge" placeholder="e.g. New"
                                    class="sm:col-span-2 px-5 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-semibold text-slate-700">
                                <select name="badgeColor" id="form-badgeColor"
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-semibold text-slate-700">
                                    <option value="blue">Blue</option>
                                    <option value="green">Green</option>
                                    <option value="orange">Orange</option>
                                    <option value="red">Red</option>
                                    <option value="emerald">Emerald</option>
                                    <option value="amber">Amber</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Zoom Setup -->
                    <div class="space-y-6">
                        <div class="flex items-center gap-3 pb-2 border-b border-slate-50">
                            <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-500 flex items-center justify-center text-xs"><i class="fa-solid fa-video"></i></span>
                            <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Zoom Integration</h4>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-hashtag text-slate-300"></i>
                                </div>
                                <input type="text" name="zoomMeetingId" id="form-zoomMeetingId" placeholder="Meeting ID"
                                    class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium">
                            </div>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-key text-slate-300"></i>
                                </div>
                                <input type="text" name="zoomPassword" id="form-zoomPassword" placeholder="Passcode"
                                    class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium">
                            </div>
                        </div>
                        <div class="mt-4 relative">
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Daily Live Schedule (Admin Only)</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-clock text-slate-300"></i>
                                </div>
                                <input type="text" name="dailyLiveTime" id="form-dailyLiveTime" placeholder="e.g. 10:30 AM Everyday"
                                    class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium">
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="flex items-center gap-3 pb-2 border-b border-slate-50">
                            <span class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500 flex items-center justify-center text-xs"><i class="fa-solid fa-calendar-alt"></i></span>
                            <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Timings & Schedule</h4>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Start Date</label>
                                <input type="date" name="startDate" id="form-startDate" required
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium">
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center justify-between ml-1">
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">End Date</label>
                                    <label class="flex items-center gap-1.5 cursor-pointer group">
                                        <input type="checkbox" id="noEndDateToggle" class="w-3.5 h-3.5 rounded border-slate-300 text-amber-500 focus:ring-amber-500/20">
                                        <span class="text-[9px] font-black text-slate-400 group-hover:text-amber-500 transition-colors uppercase tracking-tight">Unlimited</span>
                                    </label>
                                </div>
                                <input type="date" name="endDate" id="form-endDate" required
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium disabled:opacity-50 disabled:bg-slate-50 disabled:cursor-not-allowed">
                                <input type="hidden" name="noEndDate" id="form-noEndDate" value="false">
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center justify-between ml-1">
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Enrollment Deadline</label>
                                    <label class="flex items-center gap-1.5 cursor-pointer group">
                                        <input type="checkbox" id="noEnrollmentDeadlineToggle" class="w-3.5 h-3.5 rounded border-slate-300 text-amber-500 focus:ring-amber-500/20">
                                        <span class="text-[9px] font-black text-slate-400 group-hover:text-amber-500 transition-colors uppercase tracking-tight">Unlimited</span>
                                    </label>
                                </div>
                                <input type="date" name="enrollmentDeadline" id="form-enrollmentDeadline" required
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-sky-500 outline-none font-medium disabled:opacity-50 disabled:bg-slate-50 disabled:cursor-not-allowed">
                                <input type="hidden" name="noEnrollmentDeadline" id="form-noEnrollmentDeadline" value="false">
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer (Actions) -->
            <div class="p-8 border-t border-slate-50 bg-slate-50/50 flex flex-col sm:flex-row gap-4 flex-none">
                <button onclick="closeModal()" class="flex-1 py-3 px-6 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold rounded-2xl transition-all">
                    Cancel
                </button>
                <button type="submit" form="courseForm" id="submitBtn"
                    class="flex-[2] py-3 px-6 bg-slate-900 hover:bg-black text-white font-bold rounded-2xl shadow-xl shadow-slate-900/20 transition-all transform hover:-translate-y-0.5">
                    Create Course
                </button>
            </div>
        </div>
    </div>

    <!-- Pass Courses Data Safely & Define Logic -->
    <script>
        // Data Injection
        const rawCoursesData = "<%- encodeURIComponent(JSON.stringify(courses)) %>";
        window.allCourses = JSON.parse(decodeURIComponent(rawCoursesData));

        // --- Modal Logic ---
        function formatToDateInput(dateString) {
            if (!dateString) return '';
            const d = new Date(dateString);
            if (isNaN(d.getTime())) return '';
            return d.toISOString().split('T')[0];
        }

        function openAddModal() {
            const modal = document.getElementById('courseModal');
            const form = document.getElementById('courseForm');
            const title = document.getElementById('modalTitle');
            const submitBtn = document.getElementById('submitBtn');

            form.reset();
            form.action = '/admin/courses/add';
            form.method = 'POST';
            document.getElementById('form-courseId').value = '';
            
            title.innerText = 'Create New Course';
            submitBtn.innerText = 'Create Course';
            
            // Default states
            document.getElementById('form-isPublished').checked = true;
            document.getElementById('form-isPromoted').checked = false;
            document.getElementById('thumbnailInput').value = '';
            document.getElementById('thumbnailPreview').classList.add('hidden');
            document.getElementById('fileNamePlaceholder').textContent = 'Select Image File';

            // Reset Dates
            document.getElementById('form-startDate').value = '';
            document.getElementById('form-endDate').value = '';
            document.getElementById('form-enrollmentDeadline').value = '';

            // Reset Unlimited Toggles
            document.getElementById('noEndDateToggle').checked = false;
            document.getElementById('noEnrollmentDeadlineToggle').checked = false;
            document.getElementById('form-endDate').disabled = false;
            document.getElementById('form-endDate').required = true;
            document.getElementById('form-enrollmentDeadline').disabled = false;
            document.getElementById('form-enrollmentDeadline').required = true;
            document.getElementById('form-noEndDate').value = "false";
            document.getElementById('form-noEnrollmentDeadline').value = "false";

            modal.classList.remove('hidden');
        }

        async function openAdminCoursesEditModal(courseId) {
            const modal = document.getElementById('courseModal');
            const form = document.getElementById('courseForm');
            const title = document.getElementById('modalTitle');
            const submitBtn = document.getElementById('submitBtn');

            title.innerText = 'Edit Course Details';
            submitBtn.innerText = 'Save Changes';
            form.action = `/admin/courses/edit/${courseId}`;
            
            try {
                // Fetch fresh course data
                const response = await fetch(`/admin/courses/api/${courseId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const course = await response.json();

                if (course) {
                    document.getElementById('form-courseId').value = course.id;
                    document.getElementById('form-title').value = course.title || '';
                    document.getElementById('form-description').value = course.description || '';
                    document.getElementById('form-price').value = course.price || 0;
                    document.getElementById('form-originalPrice').value = course.originalPrice || 0;
                    document.getElementById('form-level').value = course.level || '';
                    document.getElementById('form-badge').value = course.badge || '';
                    document.getElementById('form-badgeColor').value = course.badgeColor || 'blue';
                    document.getElementById('form-zoomMeetingId').value = course.zoomMeetingId || '';
                    document.getElementById('form-zoomPassword').value = course.zoomPassword || '';
                    document.getElementById('form-dailyLiveTime').value = course.dailyLiveTime || '';

                    // Date population
                    document.getElementById('form-startDate').value = formatToDateInput(course.startDate);
                    
                    // Handle End Date & Unlimited Toggle
                    const noEndDate = !course.endDate;
                    document.getElementById('form-endDate').value = formatToDateInput(course.endDate);
                    document.getElementById('noEndDateToggle').checked = noEndDate;
                    document.getElementById('form-endDate').disabled = noEndDate;
                    document.getElementById('form-endDate').required = !noEndDate;
                    document.getElementById('form-noEndDate').value = noEndDate ? "true" : "false";

                    // Handle Enrollment Deadline & Unlimited Toggle
                    const noEnrollmentDeadline = !course.enrollmentDeadline;
                    document.getElementById('form-enrollmentDeadline').value = formatToDateInput(course.enrollmentDeadline);
                    document.getElementById('noEnrollmentDeadlineToggle').checked = noEnrollmentDeadline;
                    document.getElementById('form-enrollmentDeadline').disabled = noEnrollmentDeadline;
                    document.getElementById('form-enrollmentDeadline').required = !noEnrollmentDeadline;
                    document.getElementById('form-noEnrollmentDeadline').value = noEnrollmentDeadline ? "true" : "false";
                    
                    // Boolean logic for checkboxes
                    document.getElementById('form-isPublished').checked = course.isPublished !== false;

                    // Handle Thumbnail Preview
                    const thumbnailPreview = document.getElementById('thumbnailPreview');
                    const fileNamePlaceholder = document.getElementById('fileNamePlaceholder');
                    
                    if (course.thumbnailUrl) {
                        thumbnailPreview.classList.remove('hidden');
                        thumbnailPreview.querySelector('img').src = course.thumbnailUrl;
                        fileNamePlaceholder.textContent = 'Existing: ' + course.thumbnailUrl.split('/').pop();
                    } else {
                        thumbnailPreview.classList.add('hidden');
                        fileNamePlaceholder.textContent = 'Select Image File';
                    }

                    modal.classList.remove('hidden');
                }
            } catch (error) {
                console.error('Error fetching course:', error);
                alert('Failed to load course details. Check console for details.');
            }
        }

        // Preview Logic for Thumbnail Upload
        document.getElementById('thumbnailInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const preview = document.getElementById('thumbnailPreview');
            const placeholder = document.getElementById('fileNamePlaceholder');
            
            if (file) {
                placeholder.textContent = 'Ready: ' + file.name;
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.classList.remove('hidden');
                    preview.querySelector('img').src = e.target.result;
                }
                reader.readAsDataURL(file);
            } else {
                placeholder.textContent = 'Select Image File';
                preview.classList.add('hidden');
            }
        });

        function closeModal() {
            document.getElementById('courseModal').classList.add('hidden');
        }

        // Close modal on outside click
        window.onclick = function(event) {
            const modal = document.getElementById('courseModal');
            if (event.target == modal) {
                closeModal();
            }
        }

        // --- AJAX Form Submission to prevent redirection ---
        document.getElementById('courseForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerText;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Saving...';
            submitBtn.disabled = true;

            try {
                const formData = new FormData(this);
                const csrfToken = formData.get('_csrf'); // Extract CSRF token from FormData

                const response = await fetch(this.action, {
                    method: this.method || 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                        'X-CSRF-Token': csrfToken // Explicitly set CSRF header
                    },
                    body: formData
                });

                const contentType = response.headers.get('content-type');
                let result = {};
                if (contentType && contentType.includes('application/json')) {
                    result = await response.json();
                }

                if (response.ok && result.success) {
                    closeModal();
                    // Show success toast or alert
                    alert(result.message || 'Course saved successfully!');
                    // Force reload to show new data
                    window.location.reload();
                } else {
                    // Handle failure
                    let errorMessage = result.message || 'Error saving course. Please check inputs.';
                    
                    // Specific check for CSRF errors or Login redirects
                    if (response.redirected && response.url.includes('/login')) {
                        errorMessage = 'Your session has expired. Please refresh the page and login again.';
                    } else if (response.status === 403) {
                        errorMessage = 'Security validation failed (CSRF). Please refresh the page.';
                    }

                    alert(errorMessage);
                }
            } catch (error) {
                console.error('Save error:', error);
                alert('Network error while saving course. Please try again.');
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        // --- Search & Filter Logic ---
        const searchInput = document.getElementById('course-search');
        const sortSelect = document.getElementById('course-sort');
        const grid = document.getElementById('course-list-grid');

        function filterAndSort() {
            const query = searchInput.value.toLowerCase();
            const sortBy = sortSelect.value;
            const cards = Array.from(document.querySelectorAll('.course-card'));

            // Real-time filtering
            cards.forEach(card => {
                const title = card.dataset.title;
                card.classList.toggle('hidden', !title.includes(query));
            });

            // Sorting engine
            const visibleCards = cards.filter(c => !c.classList.contains('hidden'));
            visibleCards.sort((a, b) => {
                if (sortBy === 'name') return a.dataset.title.localeCompare(b.dataset.title);
                if (sortBy === 'price-low') return parseInt(a.dataset.price) - parseInt(b.dataset.price);
                if (sortBy === 'price-high') return parseInt(b.dataset.price) - parseInt(a.dataset.price);
                if (sortBy === 'newest') return new Date(b.dataset.date) - new Date(a.dataset.date);
                return 0;
            });

            // Re-render in grid
            visibleCards.forEach(card => grid.appendChild(card));
        }

        if (searchInput) searchInput.addEventListener('input', filterAndSort);
        if (sortSelect) sortSelect.addEventListener('change', filterAndSort);

        // --- Unlimited Deadline Toggle Logic ---
        function setupDeadlineToggle(checkboxId, inputId, hiddenId) {
            const checkbox = document.getElementById(checkboxId);
            const input = document.getElementById(inputId);
            const hidden = document.getElementById(hiddenId);

            if (checkbox && input) {
                checkbox.addEventListener('change', function() {
                    input.disabled = this.checked;
                    input.required = !this.checked;
                    if (this.checked) input.value = '';
                    if (hidden) hidden.value = this.checked ? "true" : "false";
                });
            }
        }

        setupDeadlineToggle('noEndDateToggle', 'form-endDate', 'form-noEndDate');
        setupDeadlineToggle('noEnrollmentDeadlineToggle', 'form-enrollmentDeadline', 'form-noEnrollmentDeadline');
    </script>

    <script src="/javascripts/main.js" defer></script>
    <script src="/javascripts/admin.js" defer></script>
</body>
</html>