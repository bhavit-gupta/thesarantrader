<!-- 
========================================
FILE: admin_courses.ejs
PURPOSE: Admin Course Management Page
========================================

DESCRIPTION:
Complete CRUD interface for managing courses including creation, editing,
deletion, and video content management.

FEATURES:
- Create new courses with full details (title, price, dates, icon, etc.)
- Edit existing courses (inline editing)
- Delete courses with confirmation
- Manage course videos (add/edit/delete)
- Course status indicators (ongoing, upcoming, expired)
- Live session link configuration
- Icon and color customization
- Badge management (Bestseller, New, etc.)

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- courses (array): All courses in system
  - id, title, description, price, originalPrice, icon, iconBg, iconColor,
    startDate, endDate, liveLink, badge, badgeColor

ADMIN ACTIONS:
- Create course: Fill form and submit
- Edit course: Click edit, modify fields, save
- Delete course: Click delete with confirmation
- Manage videos: Navigate to video management per course

FORM FIELDS:
- Title, description (required)
- Price, original price (numbers)
- Start date, end date (optional, date pickers)
- Live session link (URL)
- Icon (emoji), icon background color, icon text color
- Badge text, badge color

ACCESS CONTROL:
- Admin only

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- admin.js: Course CRUD operations, form handling, delete confirmations
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage Courses - Admin Dashboard</title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
    <style>
        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background-color: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background-color: #94a3b8;
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <div class="flex min-h-screen">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px]">
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 bg-brand-navy border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
                <button id="sidebar-toggle" class="p-2 text-slate-400 hover:text-white transition-colors" aria-label="Open sidebar">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>
                <div class="ml-4 flex items-center gap-2">
                    <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded-md">
                    <span class="text-white font-bold text-sm tracking-tight uppercase">Admin Panel</span>
                </div>
            </header>

            <main class="flex-grow pb-12">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-10">

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <!-- Left Column: Add New Course Form -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 sticky top-24">
                        <div class="p-6 border-b border-slate-100">
                            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-plus-circle text-blue-600"></i> Add New Course
                            </h2>
                        </div>
                        <div class="p-6">
                            <form action="/admin/courses/add" method="POST" class="space-y-4 pb-12">
                                <input type="hidden" name="_csrf"
                                    value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Course Title</label>
                                    <input type="text" name="title" required
                                        placeholder="e.g. Advanced Options Strategy"
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                                    <textarea name="description" required rows="3"
                                        placeholder="Brief summary of the course..."
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Live Class Link
                                        (Zoom/Meet)</label>
                                    <div class="relative">
                                        <div
                                            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <i class="fa-solid fa-link text-slate-400"></i>
                                        </div>
                                        <input type="url" name="liveLink" placeholder="https://zoom.us/j/..."
                                            class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <p class="text-xs text-slate-400 mt-1">Leave empty if not applicable</p>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">YouTube Demo Video
                                        URL</label>
                                    <div class="relative">
                                        <div
                                            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <i class="fa-brands fa-youtube text-red-400"></i>
                                        </div>
                                        <input type="url" name="demoVideoUrl"
                                            placeholder="https://www.youtube.com/watch?v=..."
                                            class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-400 focus:border-red-400 outline-none transition-all">
                                    </div>
                                    <p class="text-xs text-slate-400 mt-1">Shown to users on the enroll page as a
                                        preview</p>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Start
                                            Date</label>
                                        <input type="date" name="startDate"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">End Date</label>
                                        <input type="date" name="endDate"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-slate-700 mb-1">Enrollment
                                        Deadline</label>
                                    <input type="date" name="enrollmentDeadline"
                                        class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    <p class="text-xs text-slate-400 mt-1">Users cannot enroll after this date</p>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Price (₹)</label>
                                        <input type="number" name="price" required min="0" placeholder="2999"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Original Price
                                            (₹)</label>
                                        <input type="number" name="originalPrice" required min="0" placeholder="5999"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Badge
                                            Text</label>
                                        <input type="text" name="badge" placeholder="e.g. New, Bestseller"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Badge
                                            Color</label>
                                        <select name="badgeColor"
                                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                            <option value="blue">Blue</option>
                                            <option value="green" selected>Green</option>
                                            <option value="orange">Orange</option>
                                            <option value="red">Red</option>
                                            <option value="purple">Purple</option>
                                            <option value="indigo">Indigo</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="relative">
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Icon
                                            Emoji</label>
                                        <input type="hidden" name="icon" id="icon-input" value="📚">

                                        <!-- Dropdown Trigger -->
                                        <button type="button" id="icon-dropdown-trigger"
                                            class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 flex items-center justify-center">
                                                    <span id="selected-icon-display"
                                                        class="text-2xl leading-none">📚</span>
                                                </div>
                                                <span id="selected-icon-label"
                                                    class="text-sm font-semibold text-slate-700">Books</span>
                                            </div>
                                            <i
                                                class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div id="icon-dropdown-menu-add"
                                            class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                            <div class="grid grid-cols-2 gap-2">
                                                <% const icons=[ { emoji: '📚' , label: 'Books' }, { emoji: '📈' ,
                                                    label: 'Chart Up' }, { emoji: '📉' , label: 'Chart Down' }, {
                                                    emoji: '💰' , label: 'Money' }, { emoji: '🎓' , label: 'Graduation'
                                                    }, { emoji: '💎' , label: 'Premium' }, { emoji: '🚀' ,
                                                    label: 'Growth' }, { emoji: '📊' , label: 'Analysis' }, {
                                                    emoji: '🧠' , label: 'Psychology' }, { emoji: '🎯' , label: 'Target'
                                                    }, { emoji: '💡' , label: 'Idea' }, { emoji: '⭐' , label: 'Featured'
                                                    } ]; %>
                                                    <% icons.forEach(item=> { %>
                                                        <button type="button"
                                                            onclick="selectIcon(this, '<%= item.emoji %>', '<%= item.label %>')"
                                                            class="icon-btn w-full flex items-center justify-start gap-2 px-1 py-2 rounded-lg border border-slate-100 hover:bg-blue-50 hover:border-blue-200 transition-all group/btn <%= item.emoji === '📚' ? 'bg-blue-50 border-blue-500' : 'bg-white' %>">
                                                            <span
                                                                class="text-2xl transition-transform group-hover/btn:scale-110 <%= item.emoji === '📚' ? '' : 'grayscale group-hover/btn:grayscale-0' %>">
                                                                <%= item.emoji %>
                                                            </span>
                                                            <span
                                                                class="text-sm font-medium text-slate-700 group-hover/btn:text-slate-900">
                                                                <%= item.label %>
                                                            </span>
                                                        </button>
                                                        <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="relative">
                                        <label class="block text-sm font-semibold text-slate-700 mb-1">Color
                                            Theme</label>
                                        <input type="hidden" name="colorTheme" id="color-input" value="blue">

                                        <!-- Dropdown Trigger -->
                                        <button type="button" id="color-dropdown-trigger"
                                            class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                            <div class="flex items-center gap-3">
                                                <div id="selected-color-preview"
                                                    class="w-8 h-8 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center border border-blue-100">
                                                    <div class="w-4 h-4 rounded-full bg-current"></div>
                                                </div>
                                                <span id="selected-color-label"
                                                    class="text-sm font-semibold text-slate-700">Blue</span>
                                            </div>
                                            <i
                                                class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                                        </button>

                                        <!-- Dropdown Menu -->
                                        <div id="color-dropdown-menu-add"
                                            class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                            <div class="grid grid-cols-2 gap-2">
                                                <% const colors=[ { value: 'blue' , label: 'Blue' , bg: 'bg-blue-50' ,
                                                    text: 'text-blue-500' }, { value: 'indigo' , label: 'Indigo' ,
                                                    bg: 'bg-indigo-50' , text: 'text-indigo-500' }, { value: 'green' ,
                                                    label: 'Green' , bg: 'bg-green-50' , text: 'text-green-500' }, {
                                                    value: 'purple' , label: 'Purple' , bg: 'bg-purple-50' ,
                                                    text: 'text-purple-500' }, { value: 'orange' , label: 'Orange' ,
                                                    bg: 'bg-orange-50' , text: 'text-orange-500' }, { value: 'red' ,
                                                    label: 'Red' , bg: 'bg-red-50' , text: 'text-red-500' } ]; %>
                                                    <% colors.forEach(item=> { %>
                                                        <button type="button"
                                                            onclick="selectColor(this, '<%= item.value %>', '<%= item.label %>', '<%= item.bg %>', '<%= item.text %>')"
                                                            class="color-btn w-full flex items-center justify-start gap-2 px-2 py-2 rounded-lg border border-slate-100 hover:bg-slate-50 transition-all group/btn <%= item.value === 'blue' ? 'bg-slate-50 border-blue-500' : 'bg-white' %>">
                                                            <div
                                                                class="w-8 h-8 rounded-full <%= item.bg %> <%= item.text %> flex items-center justify-center border border-slate-100">
                                                                <div class="w-4 h-4 rounded-full bg-current"></div>
                                                            </div>
                                                            <span class="text-sm font-medium text-slate-700">
                                                                <%= item.label %>
                                                            </span>
                                                        </button>
                                                        <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit"
                                    class="w-full py-3 px-4 bg-slate-900 hover:bg-black text-white font-bold rounded-xl shadow-lg shadow-slate-900/10 transition-all transform hover:-translate-y-0.5 mt-4">
                                    Create Course
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Existing Courses List -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xl font-bold text-slate-800">Existing Courses</h2>
                        <span class="bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full">
                            <%= courses.length %> Total
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-4">
                        <% if (courses.length===0) { %>
                            <div class="bg-white rounded-xl p-12 text-center border border-dashed border-slate-300">
                                <div class="text-4xl mb-3">📭</div>
                                <h3 class="text-lg font-bold text-slate-700">No courses available</h3>
                                <p class="text-slate-500">Add your first course to get started.</p>
                            </div>
                            <% } %>

                                <% var safeClasses={ blue: { bg: 'bg-blue-50' , text: 'text-blue-500' ,
                                    badgeBg: 'bg-blue-100' , badgeText: 'text-blue-700' }, indigo: { bg: 'bg-indigo-50'
                                    , text: 'text-indigo-500' , badgeBg: 'bg-indigo-100' , badgeText: 'text-indigo-700'
                                    }, green: { bg: 'bg-green-50' , text: 'text-green-500' , badgeBg: 'bg-green-100' ,
                                    badgeText: 'text-green-700' }, purple: { bg: 'bg-purple-50' ,
                                    text: 'text-purple-500' , badgeBg: 'bg-purple-100' , badgeText: 'text-purple-700' },
                                    orange: { bg: 'bg-orange-50' , text: 'text-orange-500' , badgeBg: 'bg-orange-100' ,
                                    badgeText: 'text-orange-700' }, red: { bg: 'bg-red-50' , text: 'text-red-500' ,
                                    badgeBg: 'bg-red-100' , badgeText: 'text-red-700' } }; safeClasses['default']={
                                    bg: 'bg-slate-100' , text: 'text-slate-500' , badgeBg: 'bg-slate-100' ,
                                    badgeText: 'text-slate-700' }; %>

                                    <% courses.forEach(course=> {
                                        const themeKey = course.iconBg ? course.iconBg.split('-')[0] : 'blue';
                                        const theme = safeClasses[themeKey] || safeClasses.default;
                                        const badgeThemeKey = course.badgeColor || 'blue';
                                        const badgeTheme = safeClasses[badgeThemeKey] || safeClasses.default;
                                        %>
                                        <div
                                            class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col sm:flex-row items-center gap-6 group">
                                            <!-- Icon -->
                                            <div
                                                class="w-16 h-16 rounded-xl <%= theme.bg %> flex items-center justify-center text-3xl shrink-0 <%= theme.text %> group-hover:scale-110 transition-transform duration-300">
                                                <%= course.icon %>
                                            </div>

                                            <!-- Info -->
                                            <div class="flex-grow text-center sm:text-left">
                                                <div
                                                    class="flex items-center justify-center sm:justify-start gap-2 mb-1">
                                                    <h3 class="font-bold text-slate-800 text-lg">
                                                        <%= course.title %>
                                                    </h3>
                                                    <% if (course.badge) { %>
                                                        <span
                                                            class="<%= badgeTheme.badgeBg %> <%= badgeTheme.badgeText %> text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                                                            <%= course.badge %>
                                                        </span>
                                                        <% } %>
                                                </div>
                                                <p class="text-slate-500 text-sm line-clamp-1 mb-2">
                                                    <%= course.description %>
                                                </p>

                                                <div
                                                    class="flex items-center justify-center sm:justify-start gap-4 text-xs font-medium text-slate-400">
                                                    <span class="flex items-center gap-1"><i
                                                            class="fa-solid fa-users"></i>
                                                        <%= course.users %> Users
                                                    </span>
                                                    <span class="text-slate-600 font-bold ml-2">₹<%= course.price %>
                                                            <span class="line-through text-slate-300 font-normal ml-1">₹
                                                                <%= course.originalPrice %>
                                                            </span></span>
                                                </div>
                                            </div>

                                            <!-- Actions -->
                                            <div class="flex items-center gap-2">
                                                <button data-course-id="<%= course.id %>"
                                                    class="edit-course-btn w-10 h-10 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-700 flex items-center justify-center transition-colors"
                                                    title="Edit Course">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <form action="/admin/courses/delete/<%= course.id %>" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this course?');">
                                                    <input type="hidden" name="_csrf"
                                                        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                    <button type="submit"
                                                        class="w-10 h-10 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 hover:text-red-600 flex items-center justify-center transition-colors"
                                                        title="Delete Course">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <% }); %>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Edit Course Modal -->
    <div id="editCourseModal"
        class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm p-4 [&:not(.hidden)]:flex">
        <div
            class="bg-white rounded-2xl shadow-xl w-full max-w-lg transform transition-all scale-100 flex flex-col max-h-[85vh]">
            <div
                class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50 flex-none rounded-t-2xl">
                <h3 class="text-lg font-bold text-slate-800">Edit Course</h3>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-times text-xl"></i>
                </button>
            </div>

            <div class="overflow-y-auto custom-scrollbar flex-grow">
                <form id="editCourseForm" method="POST" class="p-6 space-y-4 pb-12">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Course Title</label>
                        <input type="text" name="title" id="edit-title" required
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="edit-description" required rows="3"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Live Class Link</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-link text-slate-400"></i>
                            </div>
                            <input type="url" name="liveLink" id="edit-liveLink" placeholder="https://zoom.us/j/..."
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">YouTube Demo Video URL</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-brands fa-youtube text-red-400"></i>
                            </div>
                            <input type="url" name="demoVideoUrl" id="edit-demoVideoUrl"
                                placeholder="https://www.youtube.com/watch?v=..."
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-red-400 focus:border-red-400 outline-none transition-all">
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Shown to users on the enroll page as a preview</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Start Date</label>
                            <input type="date" name="startDate" id="edit-startDate"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">End Date</label>
                            <input type="date" name="endDate" id="edit-endDate"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Enrollment Deadline</label>
                        <input type="date" name="enrollmentDeadline" id="edit-enrollmentDeadline"
                            class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        <p class="text-xs text-slate-400 mt-1">Users cannot enroll after this date</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Price (₹)</label>
                            <input type="number" name="price" id="edit-price" required min="0"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Original Price (₹)</label>
                            <input type="number" name="originalPrice" id="edit-originalPrice" required min="0"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Badge Text</label>
                            <input type="text" name="badge" id="edit-badge"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Badge Color</label>
                            <select name="badgeColor" id="edit-badgeColor"
                                class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
                                <option value="blue">Blue</option>
                                <option value="green">Green</option>
                                <option value="orange">Orange</option>
                                <option value="red">Red</option>
                                <option value="purple">Purple</option>
                                <option value="indigo">Indigo</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="relative">
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Icon Emoji</label>
                            <input type="hidden" name="icon" id="edit-icon-input">

                            <!-- Dropdown Trigger -->
                            <button type="button" id="edit-icon-dropdown-trigger"
                                class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 flex items-center justify-center">
                                        <span id="edit-selected-icon-display" class="text-2xl leading-none">📚</span>
                                    </div>
                                    <span id="edit-selected-icon-label"
                                        class="text-sm font-semibold text-slate-700">Books</span>
                                </div>
                                <i
                                    class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                            </button>

                            <!-- Dropdown Menu -->
                            <div id="icon-dropdown-menu-edit"
                                class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                <div class="grid grid-cols-2 gap-2">
                                    <% const editIcons=[ { emoji: '📚' , label: 'Books' }, { emoji: '📈' ,
                                        label: 'Chart Up' }, { emoji: '📉' , label: 'Chart Down' }, { emoji: '💰' ,
                                        label: 'Money' }, { emoji: '🎓' , label: 'Graduation' }, { emoji: '💎' ,
                                        label: 'Premium' }, { emoji: '🚀' , label: 'Growth' }, { emoji: '📊' ,
                                        label: 'Analysis' }, { emoji: '🧠' , label: 'Psychology' }, { emoji: '🎯' ,
                                        label: 'Target' }, { emoji: '💡' , label: 'Idea' }, { emoji: '⭐' ,
                                        label: 'Featured' } ]; %>
                                        <% editIcons.forEach(item=> { %>
                                            <button type="button"
                                                onclick="selectEditIcon(this, '<%= item.emoji %>', '<%= item.label %>')"
                                                data-icon="<%= item.emoji %>" data-label="<%= item.label %>"
                                                class="edit-icon-btn w-full flex items-center justify-start gap-2 px-1 py-2 rounded-lg border border-slate-100 hover:bg-blue-50 hover:border-blue-200 transition-all group/btn bg-white">
                                                <span
                                                    class="text-2xl transition-transform group-hover/btn:scale-110 text-slate-400 grayscale group-hover/btn:grayscale-0">
                                                    <%= item.emoji %>
                                                </span>
                                                <span
                                                    class="text-sm font-medium text-slate-700 group-hover/btn:text-slate-900">
                                                    <%= item.label %>
                                                </span>
                                            </button>
                                            <% }); %>
                                </div>
                            </div>
                        </div>
                        <div class="relative">
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Color Theme</label>
                            <input type="hidden" name="colorTheme" id="edit-color-input">

                            <!-- Dropdown Trigger -->
                            <button type="button" id="edit-color-dropdown-trigger"
                                class="w-full px-4 py-3 text-left bg-white border border-slate-300 rounded-lg flex items-center justify-between hover:border-blue-500 focus:ring-2 focus:ring-blue-500 transition-all group">
                                <div class="flex items-center gap-3">
                                    <div id="edit-selected-color-preview"
                                        class="w-8 h-8 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center border border-blue-100">
                                        <div class="w-4 h-4 rounded-full bg-current"></div>
                                    </div>
                                    <span id="edit-selected-color-label"
                                        class="text-sm font-semibold text-slate-700">Blue</span>
                                </div>
                                <i
                                    class="fa-solid fa-chevron-down text-slate-400 text-sm group-hover:text-blue-500 transition-colors"></i>
                            </button>

                            <!-- Dropdown Menu -->
                            <div id="color-dropdown-menu-edit"
                                class="hidden absolute z-50 top-full mt-1 w-72 max-h-60 overflow-y-auto custom-scrollbar bg-white border border-slate-200 rounded-xl shadow-xl p-3 transform transition-all origin-top left-0 sm:left-auto">
                                <div class="grid grid-cols-2 gap-2">
                                    <% colors.forEach(item=> { %>
                                        <button type="button"
                                            onclick="selectEditColor(this, '<%= item.value %>', '<%= item.label %>', '<%= item.bg %>', '<%= item.text %>')"
                                            data-color="<%= item.value %>" data-label="<%= item.label %>"
                                            data-bg="<%= item.bg %>" data-text="<%= item.text %>"
                                            class="edit-color-btn w-full flex items-center justify-start gap-2 px-2 py-2 rounded-lg border border-slate-100 hover:bg-slate-50 transition-all group/btn bg-white">
                                            <div
                                                class="w-8 h-8 rounded-full <%= item.bg %> <%= item.text %> flex items-center justify-center border border-slate-100">
                                                <div class="w-4 h-4 rounded-full bg-current"></div>
                                            </div>
                                            <span class="text-sm font-medium text-slate-700">
                                                <%= item.label %>
                                            </span>
                                        </button>
                                        <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="p-6 border-t border-slate-100 bg-slate-50 flex-none rounded-b-2xl">
                <div class="flex gap-3">
                    <button type="button" onclick="closeEditModal()"
                        class="flex-1 py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-colors">
                        Cancel
                    </button>
                    <button type="submit" form="editCourseForm"
                        class="flex-1 py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all transform hover:-translate-y-0.5">
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pass Courses Data Safely -->
    <script>
        // Using encodeURIComponent to prevent syntax errors in IDE and handle special characters safely
        const rawCoursesData = "<%- encodeURIComponent(JSON.stringify(courses)) %>";
        window.allCourses = JSON.parse(decodeURIComponent(rawCoursesData));
    </script>

    <%- include('../partials/footer') %>
</div>
    </div>

    <script src="/javascripts/main.js" defer></script>
        <script src="/javascripts/admin.js" defer></script>
</body>

</html>