<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brand Hub | Landing Page Management</title>
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <link rel="stylesheet" href="/stylesheets/output.css">
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <%- include('../partials/layout_wrapper_top', { pageTitle: 'Brand Hub', wrapperBg: 'bg-slate-50' }) %>

    <main class="flex-grow pt-16 pb-20 px-6 lg:px-12">
        <div class="max-w-7xl mx-auto">
            
            <!-- Page Header -->
            <div class="mb-10 sm:mb-14">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-gold/10 text-brand-gold font-bold text-[10px] uppercase tracking-widest mb-6">
                    <i class="fa-solid fa-palette"></i> Dashboard / Brand Hub
                </div>
                <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 tracking-tighter leading-tight">Homepage <span class="bg-gradient-to-r from-brand-gold to-orange-500 bg-clip-text text-transparent italic">Identity</span></h1>
                <p class="text-slate-400 mt-2 font-medium text-base sm:text-lg">Sculpt your brand's digital narrative and visual assets.</p>
            </div>

            <!-- Management Section -->
            <div class="space-y-10">
                
                <!-- Hero Image Section -->
                <div class="card-premium p-8 sm:p-12 bg-white relative overflow-hidden">
                    <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-gold/5 blur-[100px] rounded-full"></div>
                    
                    <div class="flex flex-col lg:flex-row items-start gap-12 relative z-10">
                        <!-- Preview Box: Now a Gallery -->
                        <div class="w-full lg:w-3/5 group">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em]">Active Hero Gallery</h3>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]"><%= heroImages.length %> Images Active</span>
                            </div>
                            
                            <!-- Gallery Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="hero-gallery">
                                <% heroImages.forEach((img, index) => { %>
                                    <div class="relative aspect-video rounded-2xl overflow-hidden border border-slate-100 shadow-lg group/img" data-url="<%= img %>">
                                        <img src="<%= img %>" alt="Hero <%= index + 1 %>" class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110">
                                        <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center gap-3">
                                            <button onclick="deleteHeroImage('<%= img %>')" class="w-10 h-10 rounded-xl bg-red-500 text-white flex items-center justify-center hover:bg-red-600 transition-colors shadow-lg shadow-red-500/20" title="Remove from Gallery">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                            <a href="<%= img %>" target="_blank" class="px-4 py-2 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 text-white font-bold text-[10px] uppercase tracking-widest hover:bg-white/20 transition-all flex items-center justify-center">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                <% }); %>

                                <% if (heroImages.length === 0) { %>
                                    <div class="sm:col-span-2 aspect-video rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-slate-400 bg-slate-50">
                                        <i class="fa-solid fa-images text-3xl mb-3"></i>
                                        <p class="text-xs font-bold uppercase tracking-widest">No Active Vision</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Info & Actions -->
                        <div class="w-full lg:w-2/5 space-y-8 py-4">
                            <div>
                                <h2 class="text-3xl font-bold text-slate-900 tracking-tight mb-4">Elevate Your Presence</h2>
                                <p class="text-slate-500 font-medium leading-relaxed">The hero image is the first point of contact for every trader. Choose imagery that inspires confidence, professionalism, and the high-performance culture of The Saran Trader.</p>
                            </div>

                            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-4">
                                <div class="flex items-center gap-4 text-slate-600">
                                    <div class="w-10 h-10 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-brand-gold shadow-sm">
                                        <i class="fa-solid fa-house"></i>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-slate-800">Homepage Exposure</p>
                                        <p class="text-[11px] text-slate-500 font-medium">These images appear on the public landing page.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-col items-start gap-4 pt-4">
                                <input type="file" id="hero-image-input" class="hidden" accept="image/*">
                                <button onclick="startImageUpload('hero')" class="w-full py-4 px-10 rounded-2xl bg-brand-gold text-slate-950 font-black text-xs uppercase tracking-widest hover:scale-[1.02] active:scale-98 transition-all shadow-xl shadow-brand-gold/20 flex items-center justify-center gap-3">
                                    <i class="fa-solid fa-plus"></i>
                                    Add New Hero Vision
                                </button>
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest text-center w-full">Placement: Landing Page Only</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Banner Section -->
                <div class="card-premium p-8 sm:p-12 bg-white relative overflow-hidden">
                    <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-blue-500/5 blur-[100px] rounded-full"></div>
                    
                    <div class="flex flex-col lg:flex-row-reverse items-start gap-12 relative z-10">
                        <!-- Preview Box -->
                        <div class="w-full lg:w-3/5 group">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em]">Student Dashboard Banners</h3>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]"><%= dashboardImages.length %> Images Active</span>
                            </div>
                            
                            <!-- Gallery Grid -->
                            <div class="grid grid-cols-1 gap-4" id="dashboard-gallery">
                                <% dashboardImages.forEach((img, index) => { %>
                                    <div class="relative aspect-[24/9] rounded-2xl overflow-hidden border border-slate-100 shadow-lg group/img" data-url="<%= img %>">
                                        <img src="<%= img %>" alt="Dashboard Banner <%= index + 1 %>" class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110">
                                        <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center gap-3">
                                            <button onclick="deleteDashboardImage('<%= img %>')" class="w-10 h-10 rounded-xl bg-red-500 text-white flex items-center justify-center hover:bg-red-600 transition-colors shadow-lg shadow-red-500/20" title="Remove Banner">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                            <a href="<%= img %>" target="_blank" class="px-4 py-2 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 text-white font-bold text-[10px] uppercase tracking-widest hover:bg-white/20 transition-all flex items-center justify-center">
                                                Preview
                                            </a>
                                        </div>
                                    </div>
                                <% }); %>

                                <% if (dashboardImages.length === 0) { %>
                                    <div class="aspect-[24/9] rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-slate-400 bg-slate-50">
                                        <i class="fa-solid fa-rectangle-ad text-3xl mb-3"></i>
                                        <p class="text-xs font-bold uppercase tracking-widest">No Promotional Banners</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Info & Actions -->
                        <div class="w-full lg:w-2/5 space-y-8 py-4">
                            <div>
                                <h2 class="text-3xl font-bold text-slate-900 tracking-tight mb-4">Dashboard Promotions</h2>
                                <p class="text-slate-500 font-medium leading-relaxed">Display high-impact announcements, offers, or milestones directly to your logged-in students. These images appear exclusively on the User Dashboard.</p>
                            </div>

                            <div class="p-6 rounded-2xl bg-blue-50/50 border border-blue-100/50 space-y-4">
                                <div class="flex items-center gap-4 text-slate-600">
                                    <div class="w-10 h-10 rounded-xl bg-white border border-blue-100 flex items-center justify-center text-blue-500 shadow-sm">
                                        <i class="fa-solid fa-user-graduate"></i>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-sm font-bold text-slate-800">Internal Marketing</p>
                                        <p class="text-[11px] text-slate-500 font-medium">Targeted imagery for active course participants.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-col items-start gap-4 pt-4">
                                <input type="file" id="dashboard-image-input" class="hidden" accept="image/*">
                                <button onclick="startImageUpload('dashboard')" class="w-full py-4 px-10 rounded-2xl bg-slate-900 text-white font-black text-xs uppercase tracking-widest hover:bg-slate-800 hover:scale-[1.02] active:scale-98 transition-all shadow-xl shadow-slate-900/20 flex items-center justify-center gap-3">
                                    <i class="fa-solid fa-plus"></i>
                                    New Dashboard Banner
                                </button>
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest text-center w-full">Recommended Ratio: 24:9</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- ======== IMAGE CROP MODAL (Universal) ======== -->
    <div id="cropModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl flex flex-col overflow-hidden" style="max-height:90vh">
            <!-- Header -->
            <div class="flex items-center justify-between px-8 py-6 border-b border-slate-50 flex-none bg-slate-50/50">
                <div>
                    <h3 class="text-xl font-bold text-slate-900 tracking-tight">Sculpt Viewport</h3>
                    <p id="crop-subtitle" class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Reposition and focus your creative asset</p>
                </div>
                <button id="crop-cancel-btn" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-slate-200/50 text-slate-400 transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Cropper area -->
            <div class="flex-1 bg-slate-950 overflow-hidden relative" style="min-height:350px;max-height:55vh">
                <img id="crop-image" src="" alt="Crop preview" style="display:block;max-width:100%">
            </div>

            <!-- Aspect ratio selector -->
            <div class="px-8 py-4 border-b border-slate-50 flex items-center gap-4 flex-none bg-slate-50/30 overflow-x-auto custom-scrollbar">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest whitespace-nowrap">Framing Ratio</span>
                <div class="flex items-center gap-2" id="ratio-selector">
                    <button onclick="setCropRatio(16/9, this)" class="crop-ratio-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-brand-navy text-white transition-all">16:9 (Hero)</button>
                    <button onclick="setCropRatio(24/9, this)" class="crop-ratio-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-white border border-slate-100 text-slate-600 hover:border-brand-gold transition-all">24:9 (Banner)</button>
                    <button onclick="setCropRatio(2/1, this)" class="crop-ratio-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-white border border-slate-100 text-slate-600 hover:border-brand-gold transition-all">2:1</button>
                    <button onclick="setCropRatio(NaN, this)" class="crop-ratio-btn px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-white border border-slate-100 text-slate-600 hover:border-brand-gold transition-all">Free</button>
                </div>
            </div>

            <!-- Footer actions -->
            <div class="px-8 py-6 flex flex-col sm:flex-row justify-end gap-3 flex-none bg-white">
                <button id="crop-cancel-btn2" class="order-2 sm:order-1 px-8 py-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-xs uppercase tracking-widest transition-all">Discard</button>
                <button id="crop-confirm-btn" class="order-1 sm:order-2 px-8 py-4 rounded-2xl bg-brand-navy hover:bg-brand-navy/90 text-white font-bold text-xs uppercase tracking-widest shadow-xl shadow-brand-navy/20 transition-all hover:-translate-y-0.5">
                    <i class="fa-solid fa-crop mr-2"></i>Apply & Save
                </button>
            </div>
        </div>
    </div>

    <%- include('../partials/layout_wrapper_bottom', { hideFooter: true }) %>

    <script src="/javascripts/main.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script src="/javascripts/admin.js"></script>
    
    <script>
        let cropper;
        let activeUploadMode = 'hero'; // 'hero' or 'dashboard'

        const cropModal = document.getElementById('cropModal');
        const cropImage = document.getElementById('crop-image');
        const cropConfirmBtn = document.getElementById('crop-confirm-btn');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

        function startImageUpload(mode) {
            activeUploadMode = mode;
            const input = document.getElementById(mode + '-image-input');
            input.click();
        }

        ['hero', 'dashboard'].forEach(mode => {
            const input = document.getElementById(mode + '-image-input');
            input.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        cropImage.src = event.target.result;
                        cropModal.classList.remove('hidden');
                        
                        // Set subtitle and default ratio based on mode
                        document.getElementById('crop-subtitle').textContent = mode === 'hero' ? 'Reposition your homepage banner' : 'Reposition your internal student banner';
                        
                        if (cropper) cropper.destroy();
                        cropper = new Cropper(cropImage, {
                            aspectRatio: mode === 'hero' ? 16/9 : 24/9,
                            viewMode: 2,
                        });

                        // Update ratio buttons visibility based on mode
                        const ratioSelector = document.getElementById('ratio-selector');
                        const btns = ratioSelector.querySelectorAll('.crop-ratio-btn');
                        
                        if (mode === 'dashboard') {
                            // Only show 24:9 for dashboard
                            btns.forEach(b => b.classList.add('hidden'));
                            btns[1].classList.remove('hidden'); // Show 24:9
                            btns[1].classList.replace('bg-white', 'bg-brand-navy');
                            btns[1].classList.replace('text-slate-600', 'text-white');
                        } else {
                            // Show all for hero
                            btns.forEach(b => {
                                b.classList.remove('hidden');
                                b.classList.remove('bg-brand-navy', 'text-white');
                                b.classList.add('bg-white', 'border', 'border-slate-100', 'text-slate-600');
                            });
                            btns[0].classList.replace('bg-white', 'bg-brand-navy');
                            btns[0].classList.replace('text-slate-600', 'text-white');
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        });

        // Close logic
        const closeSelectors = ['#crop-cancel-btn', '#crop-cancel-btn2'];
        closeSelectors.forEach(sel => {
            document.querySelector(sel).addEventListener('click', () => {
                cropModal.classList.add('hidden');
            });
        });

        function setCropRatio(ratio, btn) {
            if (cropper) cropper.setAspectRatio(ratio);
            document.querySelectorAll('.crop-ratio-btn').forEach(b => {
                b.classList.remove('bg-brand-navy', 'text-white');
                b.classList.add('bg-white', 'border', 'border-slate-100', 'text-slate-600');
            });
            btn.classList.replace('bg-white', 'bg-brand-navy');
            btn.classList.replace('text-slate-600', 'text-white');
        }

        cropConfirmBtn.addEventListener('click', () => {
            if (!cropper) return;
            
            cropConfirmBtn.disabled = true;
            cropConfirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Processing...';

            // Aspect ratio aware export
            const canvasOpts = activeUploadMode === 'hero' ? { width: 1920, height: 1080 } : { width: 1920, height: 720 };

            cropper.getCroppedCanvas(canvasOpts).toBlob((blob) => {
                const formData = new FormData();
                const fieldName = activeUploadMode === 'hero' ? 'heroImage' : 'dashboardImage';
                const endpoint = activeUploadMode === 'hero' ? '/api/admin/settings/hero-image' : '/api/admin/settings/dashboard-image';
                
                formData.append(fieldName, blob, `${activeUploadMode}-asset.png`);
                formData.append('_csrf', csrfToken);

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.showToast('Asset added successfully!', 'success');
                        location.reload();
                    } else {
                        window.showToast(data.message || 'Upload failed', 'error');
                    }
                })
                .catch(err => {
                    console.error(err);
                    window.showToast('Server connection error', 'error');
                })
                .finally(() => {
                    cropConfirmBtn.disabled = false;
                    cropConfirmBtn.innerHTML = '<i class="fa-solid fa-crop mr-2"></i>Apply & Save';
                });
            }, 'image/png');
        });

        function deleteHeroImage(imageUrl) {
            if (!confirm('Remove this hero vision from landing page?')) return;
            performDelete('/api/admin/settings/hero-image/delete', imageUrl);
        }

        function deleteDashboardImage(imageUrl) {
            if (!confirm('Remove this banner from student dashboard?')) return;
            performDelete('/api/admin/settings/dashboard-image/delete', imageUrl);
        }

        function performDelete(endpoint, imageUrl) {
            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageUrl, _csrf: csrfToken })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.showToast('Removed successfully', 'success');
                    location.reload();
                } else {
                    window.showToast(data.message || 'Delete failed', 'error');
                }
            })
            .catch(err => {
                console.error(err);
                window.showToast('Server error during deletion', 'error');
            });
        }
    </script>
</body>
</html></body>
</html>

</body>
</html>
