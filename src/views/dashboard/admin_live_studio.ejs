<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <title>Broadcast Studio - TheSaranTrader</title>

    <!-- Zoom Component SDK CSS -->
    <link type="text/css" rel="stylesheet" href="https://source.zoom.us/3.5.0/css/bootstrap.css" />
    <link type="text/css" rel="stylesheet" href="https://source.zoom.us/3.5.0/css/react-select.css" />

    <!-- Custom Theme -->
    <link rel="stylesheet" href="/stylesheets/output.css">

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <style>
        /* Zoom Component Override to fit Dashboard */
        #meetingSDKElement {
            width: 100%;
            height: 100%;
            min-height: 600px;
            border-radius: 1rem;
            overflow: hidden;
            background: #0f172a;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }

        /* Ensure the Zoom component doesn't break the layout */
        .zoom-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            min-height: 600px;
        }

        @media (max-width: 1024px) {
            .zoom-container {
                height: 500px;
                min-height: 500px;
            }
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <div class="flex min-h-screen">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px]">
                <!-- Header -->
                <header
                    class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 sticky top-0 z-40">
                    <div class="flex items-center gap-4">
                        <button id="sidebar-toggle" class="lg:hidden p-2 text-slate-500">
                            <i class="fa-solid fa-bars-staggered"></i>
                        </button>
                        <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                            Live Broadcast Studio
                        </h1>
                    </div>

                    <div class="flex items-center gap-3">
                        <a href="/admin/dashboard"
                            class="text-sm font-semibold text-slate-500 hover:text-blue-600 transition-colors">
                            <i class="fa-solid fa-arrow-left mr-1"></i> Exit Studio
                        </a>
                    </div>
                </header>

                <main class="p-6 lg:p-8 flex-grow">
                    <div class="max-w-6xl mx-auto">

                        <!-- Studio Header Info -->
                        <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div>
                                <h2 class="text-2xl font-black text-slate-800 tracking-tight">Host Control Panel</h2>
                                <p class="text-slate-500 text-sm">Managing Session ID: <span
                                        class="font-mono font-bold text-blue-600">
                                        <%= meetingNumber %>
                                    </span></p>
                            </div>

                            <div class="flex items-center gap-2 bg-blue-50 px-4 py-2 rounded-xl border border-blue-100">
                                <i class="fa-solid fa-shield-halved text-blue-600"></i>
                                <span class="text-sm font-bold text-blue-700">Encrypted Host Session</span>
                            </div>
                        </div>

                        <!-- The Embedded Studio (Zoom Component) -->
                        <div
                            class="zoom-container rounded-2xl overflow-hidden bg-slate-900 shadow-2xl ring-1 ring-white/10">
                            <div id="meetingSDKElement"></div>
                        </div>

                        <!-- Studio Tips -->
                        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                                <div
                                    class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center mb-4">
                                    <i class="fa-solid fa-microphone-lines"></i>
                                </div>
                                <h4 class="font-bold text-slate-800 mb-1">Audio Check</h4>
                                <p class="text-xs text-slate-500">Ensure your primary microphone is selected in the Zoom
                                    settings once launched.</p>
                            </div>
                            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                                <div
                                    class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-4">
                                    <i class="fa-solid fa-video"></i>
                                </div>
                                <h4 class="font-bold text-slate-800 mb-1">HQ Video</h4>
                                <p class="text-xs text-slate-500">Lighting is key! Use a stable internet connection for
                                    the best broadcast quality.</p>
                            </div>
                            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                                <div
                                    class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center mb-4">
                                    <i class="fa-solid fa-users-gear"></i>
                                </div>
                                <h4 class="font-bold text-slate-800 mb-1">Management</h4>
                                <p class="text-xs text-slate-500">You can mute participants and manage registrations
                                    directly from the sidebar.</p>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
    </div>

    <!-- Zoom SDK Dependencies -->
    <script src="https://source.zoom.us/3.5.0/lib/vendor/react.min.js"></script>
    <script src="https://source.zoom.us/3.5.0/lib/vendor/react-dom.min.js"></script>
    <script src="https://source.zoom.us/3.5.0/lib/vendor/redux.min.js"></script>
    <script src="https://source.zoom.us/3.5.0/lib/vendor/redux-thunk.min.js"></script>
    <script src="https://source.zoom.us/3.5.0/lib/vendor/lodash.min.js"></script>

    <!-- Zoom Component SDK -->
    <script src="https://source.zoom.us/zoom-meeting-embedded-3.5.0.min.js"></script>

    <script>
        const sdkKey = "<%= sdkKey %>";
        const signature = "<%= signature %>";
        const meetingNumber = "<%= meetingNumber %>";
        const password = "<%= password %>";
        const userName = "<%= userName %>";
        const userEmail = "<%= userEmail %>";
        const zoomRole = <%= role %>;
        const zakToken = "<%= zakToken %>";

        const client = ZoomMtgEmbedded.createClient();

        async function startMeeting() {
            let meetingSDKElement = document.getElementById('meetingSDKElement');

            console.log('🎬 Starting meeting with:', {
                sdkKey: sdkKey ? sdkKey.substring(0, 8) + '...' : 'MISSING',
                meetingNumber: meetingNumber,
                hasPassword: !!password,
                role: zoomRole,
            });

            if (zakToken && (zakToken.startsWith('ERROR_') || zakToken.startsWith('FATAL_'))) {
                console.warn('❌ ZAK Fetch Error:', zakToken);
            } else {
                console.log('✅ ZAK Token status:', !!zakToken);
            }

            try {
                // Initialize the Meeting SDK
                await client.init({
                    zoomAppRoot: meetingSDKElement,
                    language: 'en-US',
                    patchJsMedia: true,
                    leaveUrl: window.location.origin + '/admin/dashboard',
                    debug: true
                });

                console.log('✅ SDK initialized successfully');

                // Ensure inputs are stripped of spaces/noise for the SDK
                const cleanMeetingNumber = String(meetingNumber || '').replace(/\s/gi, '');
                const cleanPassword = String(password || '').replace(/\s/gi, '');

                const joinParams = {
                    sdkKey: sdkKey,
                    signature: signature,
                    meetingNumber: cleanMeetingNumber,
                    password: cleanPassword,
                    userName: userName,
                    userEmail: userEmail,
                };

                // Add ZAK token if it's valid (this is required to be Host)
                if (zakToken && !zakToken.startsWith('ERROR_') && !zakToken.startsWith('FATAL_')) {
                    joinParams.zak = zakToken;
                }

                // Join the meeting
                await client.join(joinParams);
                console.log('🚀 Studio Session Active - Joined Successfully');

            } catch (error) {
                const errCode = error && error.errorCode ? error.errorCode : 'unknown';
                const errMsg = error && error.message ? error.message : JSON.stringify(error);
                console.error('❌ Studio Init Error:', error);
                alert(`❌ Studio Error [${errCode}]: ${errMsg}\n\nCheck browser console (F12) for full details.`);
            }
        }

        // Auto-start when page loads
        document.addEventListener('DOMContentLoaded', startMeeting);
    </script>
</body>

</html>