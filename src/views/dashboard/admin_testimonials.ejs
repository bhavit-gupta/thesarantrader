<!-- 
========================================
FILE: admin_testimonials.ejs
PURPOSE: Admin Testimonial Moderation Panel
========================================

DESCRIPTION:
Manage, approve, and reject user-submitted testimonials.
Provides moderation interface with approval queue and published testimonials.

FEATURES:
- Testimonial approval/rejection queue
- Star rating display (1-5 stars)
- User information (name, role)
- Testimonial message preview
- Approval/rejection actions with confirmation
- Statistics (pending, approved, rejected counts)
- Separate tabs/sections for pending vs approved

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- pendingTestimonials (array): Testimonials awaiting approval
  - id, userName, userRole, rating, message, createdAt
- approvedTestimonials (array): Published testimonials
  - id, userName, userRole, rating, message, approvedAt
- rejectedTestimonials (array, optional): Rejected testimonials

ADMIN ACTIONS:
- Approve testimonial: Makes it public on testimonials page
- Reject testimonial: Hides from public, notifies user
- Delete testimonial: Permanent removal

STATISTICS:
- Pending review count
- Total approved count
- Total rejected count

ACCESS CONTROL:
- Admin only

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- admin-testimonials.js: Approval/rejection handling, AJAX operations
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage Testimonials - Admin</title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">

    <%- include('../partials/navbar') %>

        <main class="flex-grow pt-24 pb-12">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Header -->
                <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-slate-800">Testimonial Management 💬</h1>
                        <p class="text-slate-500 mt-1">Review and manage user testimonials</p>
                    </div>
                    <a href="/admin/dashboard"
                        class="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition-colors">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Dashboard
                    </a>
                </div>

                <!-- ========================================
                     STATISTICS CARDS
                     ========================================
                     Display counts for pending, approved, and rejected testimonials -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <!-- Pending Count Card (Yellow) -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex items-center gap-4">
                            <!-- Clock icon -->
                            <div
                                class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center text-yellow-600 text-xl">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <div>
                                <!-- Count of testimonials awaiting review -->
                                <p class="text-2xl font-bold text-slate-800">
                                    <%= pendingTestimonials.length %>
                                </p>
                                <p class="text-sm text-slate-500">Pending Review</p>
                            </div>
                        </div>
                    </div>

                    <!-- Approved Count Card (Green) -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex items-center gap-4">
                            <!-- Check circle icon -->
                            <div
                                class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-600 text-xl">
                                <i class="fa-solid fa-check-circle"></i>
                            </div>
                            <div>
                                <!-- Count of approved (live) testimonials -->
                                <p class="text-2xl font-bold text-slate-800">
                                    <%= approvedTestimonials.length %>
                                </p>
                                <p class="text-sm text-slate-500">Approved</p>
                            </div>
                        </div>
                    </div>

                    <!-- Rejected Count Card (Red) -->
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                        <div class="flex items-center gap-4">
                            <!-- X circle icon -->
                            <div
                                class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-red-600 text-xl">
                                <i class="fa-solid fa-times-circle"></i>
                            </div>
                            <div>
                                <!-- Count of rejected testimonials -->
                                <p class="text-2xl font-bold text-slate-800">
                                    <%= rejectedTestimonials.length %>
                                </p>
                                <p class="text-sm text-slate-500">Rejected</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending Testimonials Section -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-hourglass-half text-yellow-600"></i>
                        Pending Testimonials
                    </h2>

                    <% if (pendingTestimonials.length===0) { %>
                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                            <div class="text-5xl mb-4">✅</div>
                            <h3 class="text-xl font-bold text-slate-800 mb-2">All caught up!</h3>
                            <p class="text-slate-500">No pending testimonials to review.</p>
                        </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                <% pendingTestimonials.forEach(testimonial=> { %>
                                    <div class="bg-white rounded-2xl border border-yellow-200 shadow-sm p-6 hover:shadow-md transition-all"
                                        data-testimonial-id="<%= testimonial.id %>">
                                        <!-- Header -->
                                        <div class="flex items-start justify-between mb-4">
                                            <div class="flex items-center gap-3">
                                                <div
                                                    class="w-10 h-10 rounded-full bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center text-white font-bold text-sm">
                                                    <%= (testimonial.userName && testimonial.userName.length> 0) ?
                                                        testimonial.userName.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-bold text-slate-800"
                                                        data-user-name="<%= testimonial.userName %>">
                                                        <%= testimonial.userName %>
                                                    </p>
                                                    <p class="text-xs text-slate-500">
                                                        <%= testimonial.userRole %>
                                                    </p>
                                                </div>
                                            </div>
                                            <span
                                                class="px-2 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold">Pending</span>
                                        </div>

                                        <!-- Rating -->
                                        <div class="flex gap-1 mb-3">
                                            <% for (let i=0; i < testimonial.rating; i++) { %>
                                                <span class="text-yellow-400">⭐</span>
                                                <% } %>
                                        </div>

                                        <!-- Message -->
                                        <p class="text-slate-600 text-sm leading-relaxed mb-4 italic"
                                            data-message="<%= testimonial.message %>">"<%= testimonial.message %>"</p>

                                        <!-- Submitted Date -->
                                        <p class="text-xs text-slate-400 mb-4">
                                            Submitted <%= formatDate(testimonial.submittedAt) %>
                                        </p>

                                        <!-- Actions -->
                                        <div class="flex gap-2">
                                            <button data-id="<%= testimonial.id %>"
                                                class="approve-btn flex-1 px-4 py-2 rounded-lg bg-green-600 text-white font-semibold text-sm hover:bg-green-700 transition-colors">
                                                <i class="fa-solid fa-check mr-1"></i> Approve
                                            </button>
                                            <button data-id="<%= testimonial.id %>"
                                                class="reject-btn flex-1 px-4 py-2 rounded-lg bg-red-600 text-white font-semibold text-sm hover:bg-red-700 transition-colors">
                                                <i class="fa-solid fa-times mr-1"></i> Reject
                                            </button>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                </div>

                <!-- Approved Testimonials Section -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-check-circle text-green-600"></i>
                        Approved Testimonials (Live on Homepage)
                    </h2>

                    <% if (approvedTestimonials.length===0) { %>
                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                            <div class="text-5xl mb-4">📝</div>
                            <h3 class="text-xl font-bold text-slate-800 mb-2">No approved testimonials yet</h3>
                            <p class="text-slate-500">Approved testimonials will appear here and on the homepage.</p>
                        </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                <% approvedTestimonials.forEach(testimonial=> { %>
                                    <div class="bg-white rounded-2xl border border-green-200 shadow-sm p-6 hover:shadow-md transition-all"
                                        data-testimonial-id="<%= testimonial.id %>">
                                        <!-- Header -->
                                        <div class="flex items-start justify-between mb-4">
                                            <div class="flex items-center gap-3">
                                                <div
                                                    class="w-10 h-10 rounded-full bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center text-white font-bold text-sm">
                                                    <%= (testimonial.userName && testimonial.userName.length> 0) ?
                                                        testimonial.userName.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-bold text-slate-800"
                                                        data-user-name="<%= testimonial.userName %>">
                                                        <%= testimonial.userName %>
                                                    </p>
                                                    <p class="text-xs text-slate-500">
                                                        <%= testimonial.userRole %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <% if (testimonial.isFeatured) { %>
                                                    <span
                                                        class="px-2 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold">
                                                        <i class="fa-solid fa-star mr-1"></i> Featured
                                                    </span>
                                                    <% } %>
                                                        <span
                                                            class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold">Live</span>
                                            </div>
                                        </div>

                                        <!-- Rating -->
                                        <div class="flex gap-1 mb-3">
                                            <% for (let i=0; i < testimonial.rating; i++) { %>
                                                <span class="text-yellow-400">⭐</span>
                                                <% } %>
                                        </div>

                                        <!-- Message -->
                                        <p class="text-slate-600 text-sm leading-relaxed mb-4 italic"
                                            data-message="<%= testimonial.message %>">"<%= testimonial.message %>"</p>

                                        <!-- Approved Date -->
                                        <p class="text-xs text-slate-400 mb-4">
                                            Approved <%= formatDate(testimonial.reviewedAt) %>
                                        </p>

                                        <!-- Actions -->
                                        <div class="flex gap-2">
                                            <button data-id="<%= testimonial.id %>"
                                                class="feature-btn flex-1 px-4 py-2 rounded-lg <%= testimonial.isFeatured ? 'bg-slate-100 text-slate-700 hover:bg-slate-200' : 'bg-blue-600 text-white hover:bg-blue-700' %> font-semibold text-sm transition-colors border <%= testimonial.isFeatured ? 'border-slate-200' : 'border-blue-700' %>">
                                                <i class="fa-solid fa-star mr-1"></i>
                                                <%= testimonial.isFeatured ? 'Unfeature' : 'Feature' %>
                                            </button>
                                            <button data-id="<%= testimonial.id %>"
                                                class="reject-btn flex-1 px-4 py-2 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors border border-red-200">
                                                <i class="fa-solid fa-times mr-1"></i> Reject
                                            </button>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                </div>

            </div>
        </main>

        <script src="/javascripts/main.js" defer></script>
        <script src="/javascripts/admin-testimonials.js" defer></script>
</body>

</html>