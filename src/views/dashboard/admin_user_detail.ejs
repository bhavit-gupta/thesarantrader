<!-- 
========================================
FILE: admin_user_detail.ejs
PURPOSE: Admin User Detail Page
========================================

DESCRIPTION:
Comprehensive view of a single user's profile, enrollment history,
payment records, and activity for admin review and management.

SECTIONS:
1. Profile Header - Avatar, name, role badge, contact info
2. Quick Stats - Course count, purchase count
3. Personal Information - Email, phone, location, join date
4. Enrolled Courses - List of purchased courses with status
5. Payment History - All payment attempts (completed, pending, rejected)
6. Activity Timeline - Recent user actions

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- profileUser (object): User being viewed
  - id, name, username, email, phone, state, city, role, createdAt
- enrolledCourses (array): Courses user has access to
  - courseId, courseName, enrolledAt, status
- purchases (array): Payment transaction history
  - id, courseId, courseName, amount, status, screenshotUrl, createdAt, verifiedAt
- recentActivity (array, optional): User activity log

STATISTICS:
- Total enrolled courses
- Completed purchases count
- Pending payments
- Rejected payments

PAYMENT STATUS INDICATORS:
- completed: Green badge, verified
- pending: Yellow badge, awaiting admin review
- rejected: Red badge, declined payment

ACCESS CONTROL:
- Admin only

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities

FEATURES:
- User avatar with initial
- Role badge (Admin/User)
- Payment screenshot modal preview
- Course enrollment timeline
- Contact information display
- Back navigation to user list
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>
        <%= (profileUser && (profileUser.name || profileUser.username)) ? profileUser.name || profileUser.username
            : 'User Detail' %> — Admin
    </title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">

    <%- include('../partials/layout_wrapper_top', { pageTitle: 'User Detail' }) %>

            <main class="flex-grow pb-12">
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-10">

                <!-- Back -->
                <div class="mb-6">
                    <a href="/admin/users"
                        class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors text-sm font-medium">
                        <i class="fa-solid fa-arrow-left"></i> Back to All Users
                    </a>
                </div>

                <% if (!profileUser) { %>
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-12 text-center text-slate-500">
                        <i class="fa-solid fa-user-slash text-4xl mb-4"></i>
                        <h2 class="text-xl font-bold text-slate-800">User record not found</h2>
                        <p>The requested user data could not be retrieved from the database.</p>
                    </div>
                    <% } else { %>
                        <!-- Profile Header Card -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 mb-6">
                            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
                                <!-- Avatar -->
                                <div
                                    class="w-20 h-20 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shrink-0">
                                    <%= (profileUser.name || profileUser.username || 'U' )[0].toUpperCase() %>
                                </div>

                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-1">
                                        <h1 class="text-2xl font-bold text-slate-800">
                                            <%= profileUser.name || profileUser.username %>
                                        </h1>
                                        <% if (profileUser.role?.toUpperCase()==='ADMIN' ) { %>
                                            <span
                                                class="px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-xs font-bold">Admin</span>
                                            <% } else { %>
                                                <span
                                                    class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold">User</span>
                                                <% } %>
                                    </div>
                                    <p class="text-slate-500 text-sm mb-3">@<%= profileUser.username || 'unknown' %>
                                    </p>

                                    <!-- Contact Info -->
                                    <div class="flex flex-wrap gap-4 text-sm">
                                        <span class="flex items-center gap-2 text-slate-600">
                                            <i class="fa-solid fa-envelope text-blue-500"></i>
                                            <%= profileUser.email || 'N/A' %>
                                        </span>
                                        <span class="flex items-center gap-2 text-slate-600">
                                            <i class="fa-solid fa-phone text-green-500"></i>
                                            <%= profileUser.phone || 'N/A' %>
                                        </span>
                                        <% if (profileUser.city || profileUser.state) { %>
                                            <span class="flex items-center gap-2 text-slate-600">
                                                <i class="fa-solid fa-location-dot text-red-500"></i>
                                                <%= [profileUser.city, profileUser.state].filter(Boolean).join(', ') %>
                                    </span>
                                <% } %>
                                <span class="flex items-center gap-2 text-slate-400">
                                    <i class="fa-solid fa-calendar"></i>
                                    Joined <%= (typeof formatDate !== ' undefined') ? formatDate(profileUser.createdAt)
                                                    : new Date(profileUser.createdAt).toLocaleDateString() %>
                                            </span>
                                    </div>
                                </div>

                                <!-- Quick Stats -->
                                <div class="grid grid-cols-2 gap-3 shrink-0">
                                    <div class="bg-blue-50 rounded-xl p-3 text-center">
                                        <div class="text-2xl font-bold text-blue-700">
                                            <%= (enrolledCourses || []).length %>
                                        </div>
                                        <div class="text-xs text-blue-500 font-medium">Courses</div>
                                    </div>
                                    <div class="bg-green-50 rounded-xl p-3 text-center">
                                        <div class="text-2xl font-bold text-green-700">
                                            <%= (purchases || []).filter(p=> String(p.status).toLowerCase() ===
                                                'completed').length %>
                                        </div>
                                        <div class="text-xs text-green-500 font-medium">Purchases</div>
                                    </div>
                                    <div class="bg-purple-50 rounded-xl p-3 text-center">
                                        <div class="text-2xl font-bold text-purple-700">
                                            <%= (posts || []).length %>
                                        </div>
                                        <div class="text-xs text-purple-500 font-medium">Posts</div>
                                    </div>
                                    <div class="bg-orange-50 rounded-xl p-3 text-center">
                                        <div class="text-2xl font-bold text-orange-700">
                                            <%= (testimonials || []).length %>
                                        </div>
                                        <div class="text-xs text-orange-500 font-medium">Reviews</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ---- ENROLLED COURSES ---- -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
                            <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                                <h2 class="font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-graduation-cap text-blue-600"></i> Enrolled Courses
                                </h2>
                                <span class="text-xs bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full font-semibold">
                                    <%= (enrolledCourses || []).length %>
                                </span>
                            </div>
                            <% if (!enrolledCourses || enrolledCourses.length===0) { %>
                                <div class="p-8 text-center text-slate-400">
                                    <i class="fa-solid fa-book-open text-3xl mb-2"></i>
                                    <p>No courses enrolled yet.</p>
                                </div>
                                <% } else { %>
                                    <div class="divide-y divide-slate-100">
                                        <% enrolledCourses.forEach(course=> { %>
                                            <% if (course) { %>
                                                <div class="px-6 py-4 flex items-center justify-between">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                                                            <%= course.icon || '📚' %>
                                                        </div>
                                                        <div>
                                                            <div class="font-semibold text-slate-800">
                                                                <%= course.title || 'Untitled Course' %>
                                                            </div>
                                                            <div class="text-xs text-slate-400">₹<%= (course.price ||
                                                                    0).toLocaleString() %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span
                                                        class="text-xs bg-green-100 text-green-700 px-2.5 py-1 rounded-full font-semibold">Enrolled</span>
                                                </div>
                                                <% } %>
                                                    <% }); %>
                                    </div>
                                    <% } %>
                        </div>

                        <!-- ---- PURCHASE HISTORY ---- -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
                            <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                                <h2 class="font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-receipt text-green-600"></i> Purchase History
                                </h2>
                                <span
                                    class="text-xs bg-green-100 text-green-700 px-2.5 py-1 rounded-full font-semibold">
                                    <%= (purchases || []).length %>
                                </span>
                            </div>
                            <% if (!purchases || purchases.length===0) { %>
                                <div class="p-8 text-center text-slate-400">
                                    <i class="fa-solid fa-cart-shopping text-3xl mb-2"></i>
                                    <p>No purchase records.</p>
                                </div>
                                <% } else { %>
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-sm">
                                            <thead
                                                class="bg-slate-50 text-slate-500 text-xs font-bold uppercase border-b border-slate-200">
                                                <tr>
                                                    <th class="px-6 py-3 text-left">Course</th>
                                                    <th class="px-6 py-3 text-left">Amount</th>
                                                    <th class="px-6 py-3 text-left">Method</th>
                                                    <th class="px-6 py-3 text-left">Status</th>
                                                    <th class="px-6 py-3 text-left">Date</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-100">
                                                <% purchases.forEach(p=> { %>
                                                    <tr class="hover:bg-slate-50 transition-colors">
                                                        <td class="px-6 py-4 font-medium text-slate-800">
                                                            <%= p.courseTitle || '(deleted course)' %>
                                                        </td>
                                                        <td class="px-6 py-4 font-semibold">₹<%= (p.amount ||
                                                                0).toLocaleString() %>
                                                        </td>
                                                        <td class="px-6 py-4 text-slate-500 capitalize">
                                                            <%= p.paymentMethod || 'unknown' %>
                                                        </td>
                                                        <td class="px-6 py-4">
                                                            <% const pStatus=String(p.status || '' ).toLowerCase(); %>
                                                                <% if (pStatus==='completed' ) { %>
                                                                    <span
                                                                        class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">Completed</span>
                                                                    <% } else if (pStatus==='pending' ) { %>
                                                                        <span
                                                                            class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">Pending</span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="px-2.5 py-1 rounded-full bg-red-100 text-red-700 text-xs font-semibold">Rejected</span>
                                                                            <% } %>
                                                        </td>
                                                        <td class="px-6 py-4 text-slate-400 text-xs">
                                                            <%= (typeof formatDate !=='undefined' ) ? formatDate(p.date)
                                                                : new Date(p.date).toLocaleDateString() %>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } %>
                        </div>

                        <!-- ---- COMMUNITY POSTS ---- -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
                            <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                                <h2 class="font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-comments text-purple-600"></i> Community Posts
                                </h2>
                                <span
                                    class="text-xs bg-purple-100 text-purple-700 px-2.5 py-1 rounded-full font-semibold">
                                    <%= (posts || []).length %>
                                </span>
                            </div>
                            <% if (!posts || posts.length===0) { %>
                                <div class="p-8 text-center text-slate-400">
                                    <i class="fa-solid fa-comment-slash text-3xl mb-2"></i>
                                    <p>No community posts yet.</p>
                                </div>
                                <% } else { %>
                                    <div class="divide-y divide-slate-100">
                                        <% posts.forEach(post=> { %>
                                            <div class="px-6 py-4">
                                                <% if (post.title) { %>
                                                    <h3 class="font-semibold text-slate-800 mb-1">
                                                        <%= post.title %>
                                                    </h3>
                                                    <% } %>
                                                        <p class="text-slate-600 text-sm line-clamp-2">
                                                            <%= post.content || '' %>
                                                        </p>
                                                        <div
                                                            class="flex items-center gap-4 mt-2 text-xs text-slate-400">
                                                            <span><i class="fa-solid fa-heart mr-1 text-red-400"></i>
                                                                <%= post.likes || 0 %> likes
                                                            </span>
                                                            <span><i class="fa-solid fa-comment mr-1 text-blue-400"></i>
                                                                <%= (post.comments || []).length %> comments
                                                            </span>
                                                            <span>
                                                                <%= (typeof formatDate !=='undefined' ) ?
                                                                    formatDate(post.createdAt) : new
                                                                    Date(post.createdAt).toLocaleDateString() %>
                                                            </span>
                                                        </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>
                        </div>

                        <!-- ---- TESTIMONIALS ---- -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                            <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
                                <h2 class="font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-star text-amber-500"></i> Testimonials
                                </h2>
                                <span
                                    class="text-xs bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full font-semibold">
                                    <%= (testimonials || []).length %>
                                </span>
                            </div>
                            <% if (!testimonials || testimonials.length===0) { %>
                                <div class="p-8 text-center text-slate-400">
                                    <i class="fa-solid fa-star-half text-3xl mb-2"></i>
                                    <p>No testimonials submitted yet.</p>
                                </div>
                                <% } else { %>
                                    <div class="divide-y divide-slate-100">
                                        <% testimonials.forEach(t=> { %>
                                            <div class="px-6 py-5">
                                                <div class="flex items-start justify-between mb-2">
                                                    <div class="flex gap-1">
                                                        <% [1,2,3,4,5].forEach(star=> { %>
                                                            <i
                                                                class="<%= star <= (t.rating || 0) ? 'fa-solid' : 'fa-regular' %> fa-star text-amber-400 text-sm"></i>
                                                            <% }); %>
                                                    </div>
                                                    <% const tStatus=String(t.status || '' ).toLowerCase(); %>
                                                        <% if (tStatus==='approved' ) { %>
                                                            <span
                                                                class="text-xs bg-green-100 text-green-700 px-2.5 py-1 rounded-full font-semibold">Approved</span>
                                                            <% } else if (tStatus==='pending' ) { %>
                                                                <span
                                                                    class="text-xs bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full font-semibold">Pending</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="text-xs bg-red-100 text-red-700 px-2.5 py-1 rounded-full font-semibold">Rejected</span>
                                                                    <% } %>
                                                </div>
                                                <p class="text-slate-600 text-sm italic">"<%= t.message || '' %>"</p>
                                                <p class="text-xs text-slate-400 mt-2">
                                                    <%= (typeof formatDate !=='undefined' ) ? formatDate(t.submittedAt)
                                                        : new Date(t.submittedAt).toLocaleDateString() %>
                                                </p>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>
                        </div>
                        <% } %>

            </main>

            <%- include('../partials/footer') %>
    <%- include('../partials/layout_wrapper_bottom', { hideFooter: true }) %>

    <script src="/javascripts/main.js" defer></script>
</body>

</html>