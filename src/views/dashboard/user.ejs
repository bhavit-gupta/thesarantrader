<!-- 
========================================
FILE: user.ejs
PURPOSE: User Dashboard - Main Hub
========================================

DESCRIPTION:
User's main dashboard showing personalized learning overview, live sessions,
enrolled courses, payment status, and testimonial submission.

PAGE SECTIONS:
1. Welcome Header - Personalized greeting
2. Live Sessions - Active live class notifications
3. Quick Stats - Enrolled courses, active courses count
4. Payment Status - Pending/rejected payment verification status
5. My Courses - Ongoing and upcoming courses
6. Account Details - User profile information
7. Share Experience - Testimonial submission form

EXPECTED VARIABLES:
- user (object): Current authenticated user
  - id, name, username, email, createdAt
- courses (array): All available courses
  - id, title, icon, iconBg, iconColor, liveLink, startDate, endDate
- purchasedCourseIds (array): IDs of courses user has purchased and verified
- pendingCourseIds (array): IDs of courses awaiting payment verification
- liveSessions (object): Live session status per course
  - [courseId]: { isLive: boolean }
- ongoingCourses (array): Courses currently in progress
- upcomingCourses (array): Courses that haven't started yet
- rejectedPurchases (array, optional): Rejected payment attempts
  - courseId, rejectionReason
- csrfToken (string): CSRF protection token

FEATURES:
- Real-time live session indicator with "Join Now" CTA
- Course cards with hover effects and click-to-view
- Payment status tracking (pending, rejected, verified)
- Countdown timers for upcoming courses
- Star rating system for testimonials (1-5 stars)
- Character counter for testimonial (500 char limit)
- Responsive grid layouts
- Empty states for no courses/no live sessions

ACCESS CONTROL:
- Requires authentication
- User role only (redirects admins to /admin/dashboard)

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- user-dashboard.js: Testimonial submission, star ratings, course navigation

STYLING:
- CSS animations (pulse for live sessions, float animation)
- Tailwind dynamic classes (safelist for icon colors)
- Hover effects and transitions throughout
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Dashboard - The Saran Trader</title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
    <style>
        @keyframes pulse-live {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        .live-pulse {
            animation: pulse-live 1.5s ease-in-out infinite;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        .float-anim {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<!-- 
    Tailwind Safelist for Dynamic Classes (Do not remove):
    bg-blue-50 bg-indigo-50 bg-green-50 bg-purple-50 bg-orange-50 bg-red-50 bg-yellow-50 bg-teal-50
    text-blue-500 text-indigo-500 text-green-500 text-purple-500 text-orange-500 text-red-500 text-yellow-500 text-teal-500
    bg-blue-100 text-blue-700 bg-green-100 text-green-700 bg-purple-100 text-purple-700 bg-orange-100 text-orange-700
-->

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">

    <%- include('../partials/navbar') %>

        <main class="flex-grow pt-24 pb-12">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- ---------------- WELCOME HEADER ---------------- -->
                <div class="mb-8">
                    <h1 class="text-3xl lg:text-4xl font-bold text-slate-800">
                        Welcome back, <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-brand-navy to-brand-gold">
                            <%= user.name %>
                        </span> 👋
                    </h1>
                    <p class="text-slate-500 mt-2 text-lg">Here's what's happening on your trading journey.</p>
                </div>

                <!-- ---------------- LIVE SESSIONS & STATS ---------------- -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

                    <!-- ---------------- LIVE SESSIONS LIST ---------------- -->
                    <div class="lg:col-span-2 space-y-4">
                        <% let activeSessions=0; courses.forEach(course=> {
                            const isEnrolled = purchasedCourseIds && purchasedCourseIds.includes(course.id);
                            if (liveSessions[course.id] && liveSessions[course.id].isLive && isEnrolled)
                            activeSessions++;
                            }); %>

                            <% if (activeSessions> 0) { %>
                                <% courses.forEach(course=> {
                                    const session = liveSessions[course.id];
                                    const isEnrolled = purchasedCourseIds && purchasedCourseIds.includes(course.id);
                                    if (session && session.isLive && isEnrolled) { %>
                                    <div
                                        class="relative overflow-hidden rounded-2xl border border-green-200 bg-white shadow-md p-6 flex items-center justify-between gap-4">
                                        <!-- Left: Course Info -->
                                        <div>
                                            <h3 class="font-bold text-slate-800 text-lg">
                                                <%= course.title %>
                                            </h3>
                                            <p class="text-sm text-slate-500 mt-1">Live session is ongoing!</p>
                                        </div>
                                        <!-- Right: Join Button -->
                                        <a href="<%= course.liveLink %>" target="_blank"
                                            class="flex-shrink-0 px-5 py-2.5 rounded-xl bg-green-600 text-white font-semibold hover:bg-green-700 transition-colors animate-pulse">
                                            Join Now
                                        </a>
                                    </div>
                                    <% } }); %>
                                        <% } else { %>
                                            <div
                                                class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm p-8 text-center">
                                                <div
                                                    class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center text-3xl mx-auto mb-4 text-slate-400">
                                                    😴
                                                </div>
                                                <h2 class="text-xl font-bold text-slate-800 mb-2">No Live Sessions
                                                    Active</h2>
                                                <p class="text-slate-500 max-w-sm mx-auto">There are no live classes
                                                    happening right now. Check back later or browse your recorded
                                                    courses.</p>
                                            </div>
                                            <% } %>
                    </div>

                    <!-- ---------------- QUICK STATS ---------------- -->
                    <div class="space-y-4 lg:col-span-1">
                        <div
                            class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center gap-4">
                                <div
                                    class="w-12 h-12 rounded-xl bg-brand-gold/10 flex items-center justify-center text-brand-gold text-xl">
                                    📚</div>
                                <div>
                                    <p class="text-2xl font-bold text-slate-800">
                                        <%= purchasedCourseIds ? purchasedCourseIds.length : 0 %>
                                    </p>
                                    <p class="text-sm text-slate-500">Enrolled Courses</p>
                                </div>
                            </div>
                        </div>

                        <div
                            class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition-shadow">
                            <div class="flex items-center gap-4">
                                <div
                                    class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-600 text-xl">
                                    🎯</div>
                                <div>
                                    <!-- Active Courses: computed live from courses data -->
                                    <% const _now=new Date(); const _activeCourses=(courses || []).filter(c=> {
                                        const s = c.startDate ? new Date(c.startDate) : null;
                                        const e = c.endDate ? new Date(c.endDate) : null;
                                        return !(s && s > _now) && !(e && e < _now); }); %>
                                            <p class="text-2xl font-bold text-slate-800">
                                                <%= _activeCourses.length %>
                                            </p>
                                            <p class="text-sm text-slate-500">Active Courses</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ---------------- PENDING VERIFICATION ---------------- -->
                <% const pendingIds=typeof pendingCourseIds !=='undefined' ? pendingCourseIds : []; const
                    pendingCoursesData=courses.filter(c=> pendingIds.includes(c.id));
                    const hasRejections = locals.rejectedPurchases && locals.rejectedPurchases.length > 0;
                    %>
                    <% if (pendingCoursesData.length> 0 || hasRejections) { %>
                        <div class="mb-8">
                            <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                                <i class="fa-solid fa-circle-exclamation text-amber-500"></i> Payment Status
                            </h2>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                <% /* Pending Purchases */ %>
                                    <% pendingCoursesData.forEach(course=> { %>
                                        <div
                                            class="bg-white rounded-2xl shadow-sm border border-amber-200 overflow-hidden hover:shadow-md transition-all">
                                            <div class="p-6">
                                                <div class="flex items-center gap-4 mb-4">
                                                    <div class="w-12 h-12 rounded-lg flex items-center justify-center text-2xl"
                                                        id="pending-icon-<%= course.id %>"
                                                        style="background-color: <%= course.iconBg || '#e5e7eb' %>; color: <%= course.iconColor || '#334155' %>;">
                                                        <%= course.icon %>
                                                    </div>
                                                    <div>
                                                        <h3 class="font-bold text-slate-800 line-clamp-1">
                                                            <%= course.title %>
                                                        </h3>
                                                        <span
                                                            class="text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">
                                                            ⏳ Waiting for Verification
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="bg-amber-50 rounded-lg p-3 text-center">
                                                    <p class="text-sm text-amber-700 font-medium">
                                                        <i class="fa-solid fa-info-circle mr-1"></i>
                                                        Your payment proof has been submitted. Admin will verify it
                                                        shortly.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>

                                            <% /* Rejected Purchases */ %>
                                                <% if (locals.rejectedPurchases) { %>
                                                    <% rejectedPurchases.forEach(rej=> {
                                                        const course = courses.find(c => c.id === rej.courseId);
                                                        if (course) { %>
                                                        <div
                                                            class="bg-white rounded-2xl shadow-sm border border-red-200 overflow-hidden hover:shadow-md transition-all">
                                                            <div class="p-6">
                                                                <div class="flex items-center gap-4 mb-4">
                                                                    <div class="w-12 h-12 rounded-lg flex items-center justify-center text-2xl"
                                                                        id="rejected-icon-<%= course.id %>"
                                                                        style="background-color: <%= course.iconBg || '#e5e7eb' %>; color: <%= course.iconColor || '#334155' %>;">
                                                                        <%= course.icon %>
                                                                    </div>
                                                                    <div>
                                                                        <h3
                                                                            class="font-bold text-slate-800 line-clamp-1">
                                                                            <%= course.title %>
                                                                        </h3>
                                                                        <span
                                                                            class="text-xs font-semibold text-red-600 bg-red-50 px-2 py-0.5 rounded-full">
                                                                            ❌ Payment Rejected
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <div class="bg-red-50 rounded-lg p-3 mb-4">
                                                                    <p
                                                                        class="text-xs font-bold text-red-800 uppercase mb-1">
                                                                        Reason:</p>
                                                                    <p class="text-sm text-red-700 italic">
                                                                        "<%= rej.rejectionReason
                                                                            || 'No specific reason provided.' %>"
                                                                    </p>
                                                                </div>
                                                                <a href="/checkout/<%= course.id %>"
                                                                    class="block w-full text-center py-2.5 rounded-xl bg-slate-800 text-white font-bold text-sm hover:bg-slate-900 transition-all">
                                                                    <i class="fa-solid fa-redo mr-2"></i> Re-upload
                                                                    Proof
                                                                </a>
                                                            </div>
                                                        </div>
                                                        <% }}); %>
                                                            <% } %>
                            </div>
                        </div>
                        <% } %>

                            <!-- ---------------- MY COURSES ---------------- -->
                            <% const myOngoing=ongoingCourses.filter(c=> purchasedCourseIds &&
                                purchasedCourseIds.includes(c.id));
                                const myUpcoming = upcomingCourses.filter(c => purchasedCourseIds &&
                                purchasedCourseIds.includes(c.id));
                                const hasMyCourses = myOngoing.length > 0 || myUpcoming.length > 0;
                                %>

                                <% if (hasMyCourses) { %>
                                    <!-- Ongoing Courses -->
                                    <% if (myOngoing.length> 0) { %>
                                        <div class="mb-8">
                                            <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                                                <i class="fa-solid fa-play-circle text-green-600"></i> Ongoing Courses
                                            </h2>
                                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                                <% myOngoing.forEach(course=> { %>
                                                    <div onclick="if (!event.target.closest('a, button')) window.location.href='/courses/<%= course.id %>/view'"
                                                        class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-all cursor-pointer group/card">
                                                        <div class="p-6">
                                                            <div class="flex items-center gap-4 mb-4">
                                                                <div class="w-12 h-12 rounded-lg flex items-center justify-center text-2xl group-hover/card:scale-110 transition-transform"
                                                                    style="background-color: <%= course.iconBg || '#e5e7eb' %>; color: <%= course.iconColor || '#334155' %>;">
                                                                    <%= course.icon %>
                                                                </div>
                                                                <div>
                                                                    <h3
                                                                        class="font-bold text-slate-800 line-clamp-1 group-hover/card:text-blue-600 transition-colors">
                                                                        <%= course.title %>
                                                                    </h3>
                                                                    <span
                                                                        class="text-xs font-semibold text-green-600 bg-green-50 px-2 py-0.5 rounded-full">In
                                                                        Progress</span>
                                                                </div>
                                                            </div>

                                                            <% if (liveSessions[course.id] &&
                                                                liveSessions[course.id].isLive) { %>
                                                                <a onclick="event.stopPropagation()"
                                                                    href="<%= course.liveLink %>" target="_blank"
                                                                    class="block w-full sm:w-fit sm:ml-auto px-6 text-center py-2 rounded-lg bg-green-600 text-white font-semibold text-sm hover:bg-green-700 transition-colors mb-2 animate-pulse">
                                                                    Join Live Session Now
                                                                </a>
                                                                <% } else { %>
                                                                    <button disabled
                                                                        class="block w-full text-center py-2 rounded-lg bg-slate-100 text-slate-400 font-semibold text-sm cursor-not-allowed mb-2">
                                                                        No Live Session
                                                                    </button>
                                                                    <% } %>

                                                                        <div
                                                                            class="flex flex-col sm:flex-row gap-2 mb-2">
                                                                            <div
                                                                                class="flex-1 text-center py-2 rounded-lg bg-brand-navy text-white font-semibold text-sm hover:bg-brand-navy/90 transition-all flex items-center justify-center gap-2">
                                                                                <i class="fa-solid fa-circle-play"></i>
                                                                                View Lessons
                                                                            </div>
                                                                            <a onclick="event.stopPropagation()"
                                                                                href="/chat/<%= course.id %>"
                                                                                class="flex-1 text-center py-2 rounded-lg bg-slate-800 text-white font-semibold text-sm hover:bg-slate-900 transition-all flex items-center justify-center gap-2">
                                                                                <i class="fa-solid fa-comments"></i>
                                                                                Join Chat
                                                                            </a>
                                                                        </div>


                                                        </div>
                                                    </div>
                                                    <% }); %>
                                                        <!-- Explore Other Courses Card -->
                                                        <div
                                                            class="bg-white rounded-2xl shadow-sm border border-dashed border-slate-300 overflow-hidden hover:shadow-md hover:border-blue-300 transition-all">
                                                            <div
                                                                class="p-6 flex flex-col items-center justify-center text-center h-full min-h-[160px]">
                                                                <div
                                                                    class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-2xl mb-3">
                                                                    🧭</div>
                                                                <h3 class="font-bold text-slate-800 mb-1">Explore More
                                                                </h3>
                                                                <p class="text-xs text-slate-500 mb-4">Discover more
                                                                    courses to level up your skills</p>
                                                                <a href="/courses"
                                                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-navy text-white text-sm font-semibold hover:bg-brand-gold hover:text-brand-navy hover:-translate-y-0.5 transition-all shadow-md shadow-brand-navy/20">
                                                                    <i class="fa-solid fa-graduation-cap"></i> Explore
                                                                    Courses
                                                                </a>
                                                            </div>
                                                        </div>
                                            </div>
                                        </div>
                                        <% } %>

                                            <!-- Upcoming Courses -->
                                            <% if (myUpcoming.length> 0) { %>
                                                <div class="mb-8">
                                                    <h2
                                                        class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                                                        <i class="fa-solid fa-calendar-alt text-blue-600"></i> Upcoming
                                                        Courses
                                                    </h2>
                                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                                        <% myUpcoming.forEach(course=> { %>
                                                            <div onclick="if (!event.target.closest('a, button')) window.location.href='/courses/<%= course.id %>/view'"
                                                                class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-all cursor-pointer group/card">
                                                                <div class="p-6">
                                                                    <div class="flex items-center gap-4 mb-4">
                                                                        <div class="w-12 h-12 rounded-lg flex items-center justify-center text-2xl group-hover/card:scale-110 transition-transform"
                                                                            style="background-color: <%= course.iconBg || '#e5e7eb' %>; color: <%= course.iconColor || '#334155' %>;">
                                                                            <%= course.icon %>
                                                                        </div>
                                                                        <div>
                                                                            <h3
                                                                                class="font-bold text-slate-800 line-clamp-1 group-hover/card:text-brand-gold transition-colors">
                                                                                <%= course.title %>
                                                                            </h3>
                                                                            <span
                                                                                class="text-xs font-semibold text-brand-gold bg-brand-gold/10 px-2 py-0.5 rounded-full">
                                                                                Starts <%= formatDate(course.startDate)
                                                                                    %>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <div
                                                                        class="bg-slate-50 rounded-lg p-3 text-center group-hover/card:bg-brand-gold/10 transition-colors">
                                                                        <p class="text-xs text-slate-500 mb-1">Course
                                                                            starts in</p>
                                                                        <% const diff=new Date(course.startDate) - new
                                                                            Date(); const days=Math.floor(diff / (1000 *
                                                                            60 * 60 * 24)); %>
                                                                            <p class="font-mono text-slate-700 font-bold group-hover/card:text-brand-gold transition-colors"
                                                                                id="dashboard-timer-<%= course.id %>">
                                                                                <%= days %> Days
                                                                            </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <!-- Explore Other Courses Card -->
                                                                <div
                                                                    class="bg-white rounded-2xl shadow-sm border border-dashed border-slate-300 overflow-hidden hover:shadow-md hover:border-blue-300 transition-all">
                                                                    <div
                                                                        class="p-6 flex flex-col items-center justify-center text-center h-full min-h-[160px]">
                                                                        <div
                                                                            class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-2xl mb-3">
                                                                            🧭</div>
                                                                        <h3 class="font-bold text-slate-800 mb-1">
                                                                            Explore More</h3>
                                                                        <p class="text-xs text-slate-500 mb-4">Discover
                                                                            more courses to level up your skills</p>
                                                                        <a href="/courses"
                                                                            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-navy text-white text-sm font-semibold hover:bg-brand-gold hover:text-brand-navy hover:-translate-y-0.5 transition-all shadow-md shadow-brand-navy/20">
                                                                            <i class="fa-solid fa-graduation-cap"></i>
                                                                            Explore Courses
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <% } else { %>
                                                        <!-- Empty State (No My Courses) -->
                                                        <div class="mb-8">
                                                            <h2 class="text-2xl font-bold text-slate-800 mb-6">My
                                                                Courses</h2>
                                                            <div
                                                                class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                                                                <div class="text-5xl mb-4">🎓</div>
                                                                <h3 class="text-xl font-bold text-slate-800 mb-2">No
                                                                    active courses
                                                                </h3>
                                                                <p class="text-slate-500 mb-6 max-w-md mx-auto">
                                                                    You haven't enrolled in any courses yet, or your
                                                                    courses have
                                                                    ended.
                                                                </p>
                                                                <a href="/courses"
                                                                    class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-navy text-white font-semibold text-sm shadow-lg shadow-brand-navy/25 hover:bg-brand-gold hover:text-brand-navy hover:-translate-y-0.5 transition-all">
                                                                    <i class="fa-solid fa-graduation-cap"></i> Explore
                                                                    Courses
                                                                </a>
                                                            </div>
                                                        </div>
                                                        <% } %>

                                                            <!-- ---------------- ACCOUNT & TESTIMONIALS ---------------- -->
                                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">

                                                                <!-- ---------------- ACCOUNT DETAILS ---------------- -->
                                                                <div
                                                                    class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden h-fit">
                                                                    <div
                                                                        class="px-8 py-5 border-b border-slate-100 flex items-center gap-3">
                                                                        <div
                                                                            class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500">
                                                                            <i class="fa-solid fa-user"></i>
                                                                        </div>
                                                                        <h2 class="text-lg font-bold text-slate-800">
                                                                            Account Details
                                                                        </h2>
                                                                    </div>
                                                                    <div class="p-8">
                                                                        <div
                                                                            class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                                                            <div>
                                                                                <label
                                                                                    class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Name</label>
                                                                                <p
                                                                                    class="text-slate-800 font-medium text-lg">
                                                                                    <%= user.name %>
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <label
                                                                                    class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Username</label>
                                                                                <p
                                                                                    class="text-slate-800 font-medium text-lg">
                                                                                    @<%= user.username %>
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <label
                                                                                    class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Email</label>
                                                                                <p
                                                                                    class="text-slate-800 font-medium text-lg">
                                                                                    <%= user.email %>
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <label
                                                                                    class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Member
                                                                                    Since</label>
                                                                                <p
                                                                                    class="text-slate-800 font-medium text-lg">
                                                                                    <%= user.createdAt ? new
                                                                                        Date(user.createdAt).getFullYear()
                                                                                        : '2026' %>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- ---------------- SHARE EXPERIENCE ---------------- -->
                                                                <div
                                                                    class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden h-fit">
                                                                    <div
                                                                        class="px-8 py-5 border-b border-slate-100 flex items-center gap-3">
                                                                        <div
                                                                            class="w-10 h-10 rounded-xl bg-yellow-100 flex items-center justify-center text-yellow-600">
                                                                            <i class="fa-solid fa-star"></i>
                                                                        </div>
                                                                        <h2 class="text-lg font-bold text-slate-800">
                                                                            Share Your
                                                                            Experience</h2>
                                                                    </div>
                                                                    <div class="p-8">
                                                                        <div id="existing-testimonial"
                                                                            class="hidden mb-6">
                                                                        </div>

                                                                        <!-- Testimonial Form -->
                                                                        <form id="testimonial-form">
                                                                            <div class="space-y-6">
                                                                                <!-- Star Rating -->
                                                                                <div>
                                                                                    <label
                                                                                        class="block text-sm font-semibold text-slate-700 mb-3">
                                                                                        Rate Your Experience <span
                                                                                            class="text-red-500">*</span>
                                                                                    </label>
                                                                                    <div class="flex gap-2">
                                                                                        <% for(let i=1;i<=5;i++){ %>
                                                                                            <button type="button"
                                                                                                class="star-btn text-2xl text-slate-300 hover:text-yellow-400 transition-colors focus:outline-none"
                                                                                                data-rating="<%= i %>">
                                                                                                <i
                                                                                                    class="fa-solid fa-star"></i>
                                                                                            </button>
                                                                                            <% } %>
                                                                                    </div>
                                                                                    <input type="hidden"
                                                                                        id="rating-input" name="rating"
                                                                                        required>
                                                                                </div>

                                                                                <!-- Role/Profession -->
                                                                                <div>
                                                                                    <label for="user-role"
                                                                                        class="block text-sm font-semibold text-slate-700 mb-2">Your
                                                                                        Role/Profession</label>
                                                                                    <input type="text" id="user-role"
                                                                                        name="userRole"
                                                                                        placeholder="e.g., Full-Time Trader, User, Working Professional"
                                                                                        class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/20 outline-none transition-all">
                                                                                </div>

                                                                                <!-- Testimonial Message -->
                                                                                <div>
                                                                                    <label for="testimonial-message"
                                                                                        class="block text-sm font-semibold text-slate-700 mb-2">Your
                                                                                        Testimonial <span
                                                                                            class="text-red-500">*</span></label>
                                                                                    <textarea id="testimonial-message"
                                                                                        name="message" rows="4" required
                                                                                        maxlength="500"
                                                                                        placeholder="Share your experience with our courses and how they've helped you..."
                                                                                        class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/20 outline-none transition-all resize-none"></textarea>
                                                                                    <div
                                                                                        class="flex justify-between items-center mt-2">
                                                                                        <span
                                                                                            class="text-xs text-slate-400">Maximum
                                                                                            500 characters</span>
                                                                                        <span id="char-count"
                                                                                            class="text-xs text-slate-500 font-medium">0
                                                                                            / 500</span>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- Feedback Message -->
                                                                                <div id="testimonial-feedback"
                                                                                    class="hidden p-4 rounded-xl"></div>

                                                                                <!-- Submit Button -->
                                                                                <button type="submit"
                                                                                    id="submit-testimonial-btn"
                                                                                    class="w-full px-6 py-3 rounded-xl bg-brand-navy text-white font-semibold shadow-lg shadow-brand-navy/25 hover:bg-brand-gold hover:text-brand-navy hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                                                                                    <i
                                                                                        class="fa-solid fa-paper-plane"></i>
                                                                                    Submit
                                                                                    Testimonial
                                                                                </button>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
        </main>

        <%- include('../partials/footer') %>

            <script src="/javascripts/main.js" defer></script>
            <script src="/javascripts/user-dashboard.js" defer></script>
</body>

</html>