<!-- 
========================================
FILE: user_course_videos.ejs
PURPOSE: Enhanced Lesson Viewer & Creator Studio
========================================

DESCRIPTION:
Cinematic curriculum delivery platform. Feature roles-aware content delivery,
professional timeline navigation, and an integrated Creator Studio for admins.
-->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= course.title %> - Academy Viewer</title>

    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/output.css">

    <style>
        .timeline-line {
            position: absolute;
            left: 1.5rem;
            top: 3rem;
            bottom: -3rem;
            width: 2px;
            background: linear-gradient(to bottom, rgba(212, 175, 55, 0.3), transparent);
        }
        .lesson-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .lesson-card.active {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(212, 175, 55, 0.4);
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.05);
        }
        .admin-toolbar {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-400 bg-slate-950 min-h-screen overflow-x-hidden">
    <div class="flex min-h-screen">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px] min-h-screen">
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 bg-slate-900 border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
                <button id="sidebar-toggle" class="p-2 text-white/70 hover:text-white transition-colors">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>
            </header>

            <main class="flex-grow pb-24 overflow-y-auto">
                <div class="max-w-6xl mx-auto px-6 lg:px-12 pt-12 lg:pt-16">
                    
                    <!-- Back Link & Header -->
                    <div class="mb-16 space-y-8 flex flex-col md:flex-row md:items-end justify-between items-start gap-8">
                        <div class="space-y-4">
                            <a href="/my-courses" class="inline-flex items-center gap-2 text-[8px] font-black uppercase tracking-[0.3em] text-slate-500 hover:text-brand-gold transition-colors group">
                                <i class="fa-solid fa-chevron-left transition-transform group-hover:-translate-x-2"></i> Exit Module
                            </a>

                            <div class="space-y-2">
                                <h1 class="text-3xl lg:text-5xl font-black text-white tracking-tighter leading-none">
                                    <%= course.title %>
                                </h1>
                                <% if (course.level) { %>
                                    <p class="text-[10px] font-black uppercase tracking-[0.4em] text-brand-gold/80 flex items-center gap-3">
                                        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
                                        <%= course.level %> Protocol
                                    </p>
                                <% } else { %>
                                    <p class="text-[10px] font-black uppercase tracking-[0.4em] text-cyan-500/60 flex items-center gap-3">
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
                                        Curriculum Active
                                    </p>
                                <% } %>
                            </div>
                        </div>

                        <% if (isAdmin) { %>
                        <div class="flex-shrink-0">
                            <button onclick="openAddVideoModal()" 
                                class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-white text-slate-950 font-black text-xs uppercase tracking-widest hover:bg-brand-gold transition-all duration-500 shadow-2xl">
                                <i class="fa-solid fa-plus-circle"></i> New Lesson module
                            </button>
                        </div>
                        <% } %>
                    </div>

                    <!-- Curriculum Timeline -->
                    <div class="space-y-12">
                        <% if (videos.length === 0) { %>
                            <div class="py-32 text-center rounded-[3rem] border border-white/5 bg-white/[0.02]">
                                <div class="w-24 h-24 bg-slate-900 rounded-[2rem] flex items-center justify-center text-5xl mb-8 mx-auto border border-white/5 shadow-2xl">
                                    📡
                                </div>
                                <h3 class="text-2xl font-black text-white mb-4 uppercase tracking-[0.2em]">Transmission Pending</h3>
                                <p class="text-slate-500 max-w-sm mx-auto leading-relaxed italic">The tactical data for this course is being compiled by our strategists.</p>
                            </div>
                        <% } else { %>
                            <div class="relative space-y-10">
                                <% videos.forEach((video, index) => {
                                    const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
                                    const match = video.youtubeUrl.match(youtubeRegex);
                                    const videoId = match ? match[1] : "";
                                %>
                                    <div class="relative pl-12 lg:pl-20">
                                        <!-- Vertical Line -->
                                        <% if (index < videos.length - 1) { %>
                                            <div class="timeline-line"></div>
                                        <% } %>

                                        <!-- Number Circle -->
                                        <div class="absolute left-0 top-0 w-10 h-10 lg:w-12 lg:h-12 rounded-full bg-slate-900 border border-white/10 flex items-center justify-center z-10">
                                            <span class="text-white font-black text-xs lg:text-sm italic opacity-40"><%= String(index + 1).padStart(2, '0') %></span>
                                        </div>

                                        <!-- Lesson Card -->
                                        <div class="lesson-card group relative bg-white/5 border border-white/10 rounded-2xl p-4 lg:p-6 flex flex-col md:flex-row gap-8 items-center overflow-hidden">
                                            <!-- Shine Effect -->
                                            <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>

                                            <!-- Thumbnail Container -->
                                            <div onclick="openPlayerModal('<%= videoId %>')"
                                                class="w-full md:w-72 aspect-video rounded-2xl bg-slate-950 border border-white/5 overflow-hidden flex-shrink-0 relative cursor-pointer shadow-2xl transition-all duration-700 group-hover:scale-[1.03] group-hover:border-brand-gold/20">
                                                
                                                <% if (video.thumbnailUrl) { %>
                                                    <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 transition-all duration-1000" alt="<%= video.title %>">
                                                <% } else if (videoId) { %>
                                                    <img src="https://img.youtube.com/vi/<%= videoId %>/maxresdefault.jpg" onerror="this.src='https://img.youtube.com/vi/<%= videoId %>/mqdefault.jpg'" class="w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 transition-all duration-1000">
                                                <% } %>

                                                <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-brand-gold/10 transition-colors">
                                                    <div class="w-16 h-16 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20 shadow-2xl scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500">
                                                        <i class="fa-solid fa-play text-xl ml-1"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Lesson Info -->
                                            <div class="flex-grow space-y-6 relative z-10 text-center md:text-left">
                                                <div class="space-y-2">
                                                    <span class="text-[8px] font-black uppercase tracking-[0.3em] text-brand-gold/80">Operational module <%= index + 1 %></span>
                                                    <h3 class="text-xl lg:text-2xl font-black text-white tracking-tighter group-hover:text-brand-gold transition-colors duration-500">
                                                        <%= video.title %>
                                                    </h3>
                                                </div>
                                                <p class="text-xs text-slate-500 font-medium leading-relaxed italic border-l-2 border-white/5 pl-4">
                                                    <%= video.description || "Curated intelligence briefing for this specific market protocol." %>
                                                </p>
                                                <div class="pt-4 flex flex-wrap items-center justify-center md:justify-start gap-6">
                                                    <button onclick="openPlayerModal('<%= videoId %>')" 
                                                        class="inline-flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em] text-white hover:text-brand-gold transition-all duration-300">
                                                        Start Broadcast <i class="fa-solid fa-arrow-right-long text-brand-gold animate-pulse"></i>
                                                    </button>

                                                    <% if (isAdmin) { %>
                                                    <div class="flex items-center gap-3 ml-auto p-1 rounded-xl bg-black/20 border border-white/5">
                                                        <button onclick="openEditVideoModal('<%= video.id %>', '<%= video.title %>', '<%= (video.description || "").replace(/'/g, "\\'") %>', '<%= video.youtubeUrl %>', '<%= video.order %>')"
                                                            class="p-3 rounded-lg text-slate-500 hover:text-brand-gold hover:bg-brand-gold/10 transition-all" title="Edit Session">
                                                            <i class="fa-solid fa-pen-nib"></i>
                                                        </button>
                                                        <button onclick="deleteVideo('<%= video.id %>')"
                                                            class="p-3 rounded-lg text-slate-500 hover:text-red-500 hover:bg-red-500/10 transition-all" title="Purge Session">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>

            <%- include('../partials/footer') %>
        </div>

    <!-- Modals -->
    <div id="videoPlayerModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/95 backdrop-blur-sm p-4 lg:p-12">
        <button onclick="closePlayerModal()" class="absolute top-10 right-10 text-white/50 hover:text-white text-4xl transition-all z-[110] hover:rotate-90">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="w-full max-w-6xl aspect-video bg-black rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,1)] relative border border-white/5">
            <iframe id="playerIframe" class="w-full h-full" src="" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
        </div>
    </div>

    <% if (isAdmin) { %>
    <!-- Add/Edit Modals (Creator Studio Style) -->
    <div id="videoModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/90 backdrop-blur-xl p-4">
        <div class="w-full max-w-xl admin-toolbar rounded-2xl p-8 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 p-12 opacity-5 pointer-events-none">
                <i class="fa-solid fa-plus-circle text-9xl"></i>
            </div>
            
            <h2 id="modalTitle" class="text-4xl font-black text-white mb-10 uppercase tracking-tighter">New module</h2>
            
            <form id="videoForm" class="space-y-6">
                <input type="hidden" name="id">
                <div class="space-y-2">
                    <label class="block text-[9px] font-black text-slate-500 uppercase tracking-widest pl-4">Curriculum Title</label>
                    <input type="text" name="title" required class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 text-white focus:border-brand-gold outline-none transition-all placeholder:text-slate-700 font-bold" placeholder="e.g. Price Action Mastery">
                </div>
                <div class="space-y-2">
                    <label class="block text-[9px] font-black text-slate-500 uppercase tracking-widest pl-4">Operational Briefing</label>
                    <textarea name="description" rows="3" class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 text-white focus:border-brand-gold outline-none transition-all placeholder:text-slate-700 font-medium" placeholder="Describe the tactical outcomes..."></textarea>
                </div>
                <div class="grid grid-cols-3 gap-6">
                    <div class="col-span-2 space-y-2">
                        <label class="block text-[9px] font-black text-slate-500 uppercase tracking-widest pl-4">YouTube Transmission URL</label>
                        <input type="url" name="youtubeUrl" required class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 text-white focus:border-brand-gold outline-none transition-all font-mono text-xs" placeholder="https://...">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-[9px] font-black text-slate-500 uppercase tracking-widest pl-4">Protocol Order</label>
                        <input type="number" name="order" required class="w-full px-6 py-4 rounded-2xl bg-white/5 border border-white/10 text-white focus:border-brand-gold outline-none transition-all font-mono text-center">
                    </div>
                </div>
                
                <div class="pt-8 flex gap-6">
                    <button type="button" onclick="closeVideoModal()" class="flex-1 px-8 py-5 rounded-2xl bg-white/5 text-white font-black text-[10px] uppercase tracking-widest hover:bg-white/10 transition-all">Abort</button>
                    <button type="submit" id="submitBtn" class="flex-[2] px-8 py-5 rounded-2xl bg-brand-gold text-slate-950 font-black text-[10px] uppercase tracking-widest hover:bg-white transition-all shadow-xl shadow-brand-gold/10">Execute deployment</button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

    <script defer>
        const courseId = '<%= course.id %>';

        // Player Functions
        function openPlayerModal(videoId) {
            if (!videoId) return;
            const iframe = document.getElementById('playerIframe');
            iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&modestbranding=1&rel=0`;
            document.getElementById('videoPlayerModal').classList.replace('hidden', 'flex');
            document.body.style.overflow = 'hidden';
        }

        function closePlayerModal() {
            document.getElementById('playerIframe').src = '';
            document.getElementById('videoPlayerModal').classList.replace('flex', 'hidden');
            document.body.style.overflow = '';
        }

        <% if (isAdmin) { %>
        // Admin Creator Studio Functions
        function openAddVideoModal() {
            const form = document.getElementById('videoForm');
            form.reset();
            form.id.value = '';
            form.order.value = <%= videos.length + 1 %>;
            document.getElementById('modalTitle').textContent = 'Deploy new module';
            document.getElementById('submitBtn').textContent = 'Execute deployment';
            document.getElementById('videoModal').classList.replace('hidden', 'flex');
        }

        function openEditVideoModal(id, title, desc, url, order) {
            const form = document.getElementById('videoForm');
            form.id.value = id;
            form.title.value = title;
            form.description.value = desc;
            form.youtubeUrl.value = url;
            form.order.value = parseInt(order);
            document.getElementById('modalTitle').textContent = 'Reconfigure Protocol';
            document.getElementById('submitBtn').textContent = 'Apply reconfiguration';
            document.getElementById('videoModal').classList.replace('hidden', 'flex');
        }

        function closeVideoModal() {
            document.getElementById('videoModal').classList.replace('flex', 'hidden');
        }

        document.getElementById('videoForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            const isEdit = data.id !== '';
            
            const url = isEdit ? `/api/admin/courses/${courseId}/videos/${data.id}` : `/api/admin/courses/${courseId}/videos`;
            const method = isEdit ? 'PUT' : 'POST';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) location.reload();
                else alert(result.message);
            } catch (err) {
                alert('Operational failure.');
            }
        });

        async function deleteVideo(videoId) {
            if (!confirm('Permanently purge this operational module from history?')) return;
            try {
                const response = await fetch(`/api/admin/courses/${courseId}/videos/${videoId}`, {
                    method: 'DELETE',
                    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
                });
                const result = await response.json();
                if (result.success) location.reload();
            } catch (err) {
                alert('Purge failed.');
            }
        }
        <% } %>

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closePlayerModal();
                <% if (isAdmin) { %> closeVideoModal(); <% } %>
            }
        });
    </script>
</body>

</html>