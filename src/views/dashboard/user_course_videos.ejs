<!-- 
========================================
FILE: user_course_videos.ejs
PURPOSE: User Course Video Player Page
========================================

DESCRIPTION:
Displays all video lessons for a purchased course that the user has access to.
Provides embedded YouTube player for each lesson with metadata.

FEATURES:
- Course header with title and back navigation
- List of video lessons with thumbnails
- Embedded YouTube player
- Video title, description, and duration
- Sequential lesson numbers
- Empty state if no videos uploaded yet
- Responsive video player

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- course (object): Course details
  - id, title
- videos (array): List of course videos
  - id, title, description, youtubeUrl, order

VIDEO DISPLAY:
- YouTube URL parsing to extract video ID
- Embedded iframe player (16:9 aspect ratio)
- Thumbnail preview images
- Video metadata below player

ACCESS CONTROL:
- Requires authentication
- User must have purchased the course
- Verification check in backend

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities

YOUTUBE URL FORMATS SUPPORTED:
- youtube.com/watch?v=VIDEO_ID
- youtu.be/VIDEO_ID
- youtube.com/embed/VIDEO_ID
- youtube.com/v/VIDEO_ID
- youtube.com/shorts/VIDEO_ID
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>
        <%= course.title %> - Lessons
    </title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">
    <!-- Include global navigation bar -->
    <%- include('../partials/navbar') %>

        <main class="flex-grow pt-24 pb-12">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- ========================================
                     PAGE HEADER SECTION
                     ======================================== -->
                <!-- Course title and back navigation -->
                <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <!-- Back link to user dashboard -->
                        <a href="/dashboard"
                            class="text-blue-600 hover:text-blue-700 font-semibold text-sm flex items-center gap-2 mb-2 transition-colors">
                            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                        </a>

                        <!-- Display course title dynamically -->
                        <h1 class="text-3xl lg:text-4xl font-bold text-slate-800">
                            <%= course.title %>
                        </h1>

                        <!-- Subtitle -->
                        <p class="text-slate-500 mt-2 text-lg">Course Lessons & Content</p>
                    </div>
                </div>

                <!-- ========================================
                     VIDEO LIST SECTION
                     ========================================
                     Displays all video lessons for this course -->
                <div class="space-y-6">
                    <!-- Check if course has any videos -->
                    <% if (videos.length===0) { %>
                        <!-- Empty state: No videos available yet -->
                        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                            <div class="text-5xl mb-4">📺</div>
                            <h3 class="text-xl font-bold text-slate-800 mb-2">No videos yet</h3>
                            <p class="text-slate-500 max-w-md mx-auto">
                                The course content for "<%= course.title %>" hasn't been uploaded yet. Please check back
                                    later!
                            </p>
                        </div>
                        <% } else { %>
                            <!-- Loop through each video lesson -->
                            <% videos.forEach(video=> {
                                // Extract YouTube video ID from URL using regex
                                // Supports multiple YouTube URL formats (watch, embed, youtu.be, shorts)
                                const youtubeRegex =
                                /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
                                const match = video.youtubeUrl.match(youtubeRegex);
                                const videoId = match ? match[1] : "";
                                %>

                                <!-- Video card container -->
                                <div
                                    class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow">

                                    <!-- ========================================
                                         VIDEO THUMBNAIL WITH PLAY OVERLAY
                                         ======================================== -->
                                    <!-- Clickable thumbnail that opens fullscreen player -->
                                    <div onclick="openPlayerModal('<%= videoId %>')"
                                        class="w-full md:w-64 aspect-video rounded-xl bg-slate-100 overflow-hidden flex-shrink-0 relative group cursor-pointer shadow-sm hover:shadow-md transition-all transform hover:-translate-y-0.5">

                                        <!-- Display custom thumbnail if it exists, otherwise YouTube thumbnail -->
                                        <% if (video.thumbnailUrl) { %>
                                            <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover"
                                                alt="<%= video.title %>">
                                            <% } else if (videoId) { %>
                                                <!-- Display default YouTube thumbnail -->
                                                <img src="https://img.youtube.com/vi/<%= videoId %>/mqdefault.jpg"
                                                    class="w-full h-full object-cover" alt="<%= video.title %>">
                                                <% } else { %>
                                                    <!-- Error state: Invalid or missing YouTube URL and no thumbnail -->
                                                    <div
                                                        class="w-full h-full flex items-center justify-center text-slate-400 p-4 text-center">
                                                        <i class="fa-solid fa-triangle-exclamation text-2xl mb-2"></i>
                                                        <p class="text-xs">Video Unavailable</p>
                                                    </div>
                                                    <% } %>

                                                        <!-- Play button overlay (appears on hover) -->
                                                        <div
                                                            class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                                                            <!-- Centered play button -->
                                                            <div
                                                                class="w-12 h-12 bg-white/90 rounded-full flex items-center justify-center text-blue-600 shadow-xl transform group-hover:scale-110 transition-transform">
                                                                <i class="fa-solid fa-play text-xl ml-1"></i>
                                                            </div>
                                                        </div>
                                    </div>

                                    <!-- ========================================
                                         VIDEO METADATA
                                         ======================================== -->
                                    <div class="flex-grow">
                                        <!-- Video lesson title -->
                                        <h3 class="text-xl font-bold text-slate-800 mb-2">
                                            <%= video.title %>
                                        </h3>

                                        <!-- Video description (or placeholder if empty) -->
                                        <p class="text-sm text-slate-600 mb-4 italic">
                                            <%= video.description || "No description provided." %>
                                        </p>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
                </div>
            </div>
        </main>

        <!-- ========================================
             VIDEO PLAYER MODAL
             ========================================
             Fullscreen modal for watching YouTube videos
             Opened when user clicks on video thumbnail -->
        <div id="videoPlayerModal"
            class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/95 backdrop-blur-md p-4 sm:p-8">

            <!-- Close button (top right corner) -->
            <button onclick="closePlayerModal()"
                class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl transition-colors z-[110]">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Video container with 16:9 aspect ratio -->
            <div class="w-full max-w-5xl aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl relative">
                <!-- YouTube iframe player
                     - src is populated dynamically by openPlayerModal() function
                     - autoplay=1 starts video immediately when modal opens -->
                <iframe id="playerIframe" class="w-full h-full" src="" frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>

        <!-- Include global footer -->
        <%- include('../partials/footer') %>

            <script>
                /* ========================================
                   VIDEO PLAYER FUNCTIONS
                   ========================================
                   Handle opening/closing the fullscreen video player */

                /**
                 * Opens the video player modal with specified YouTube video
                 * @param {string} videoId - YouTube video ID (11 characters)
                 */
                function openPlayerModal(videoId) {
                    // Validate video ID exists
                    if (!videoId) return;

                    // Get iframe element and set source to YouTube embed URL
                    // autoplay=1 parameter starts video immediately
                    const iframe = document.getElementById('playerIframe');
                    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

                    // Show modal by removing 'hidden' class
                    document.getElementById('videoPlayerModal').classList.remove('hidden');

                    // Disable body scrolling while modal is open
                    document.body.style.overflow = 'hidden';
                }

                /**
                 * Closes the video player modal and stops video playback
                 */
                function closePlayerModal() {
                    // Get iframe and clear source (stops video)
                    const iframe = document.getElementById('playerIframe');
                    iframe.src = '';

                    // Hide modal by adding 'hidden' class
                    document.getElementById('videoPlayerModal').classList.add('hidden');

                    // Re-enable body scrolling
                    document.body.style.overflow = '';
                }

                /* ========================================
                   KEYBOARD SHORTCUTS
                   ======================================== */

                // Close modal when Escape key is pressed
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closePlayerModal();
                    }
                });
            </script>
</body>

</html>