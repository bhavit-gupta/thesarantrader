<!-- 
========================================
FILE: user_course_videos.ejs
PURPOSE: User Course Video Player Page
========================================

DESCRIPTION:
Displays all video lessons for a purchased course that the user has access to.
Provides embedded YouTube player for each lesson with metadata.

FEATURES:
- Course header with title and back navigation
- List of video lessons with thumbnails
- Embedded YouTube player
- Video title, description, and duration
- Sequential lesson numbers
- Empty state if no videos uploaded yet
- Responsive video player

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- course (object): Course details
  - id, title
- videos (array): List of course videos
  - id, title, description, youtubeUrl, order

VIDEO DISPLAY:
- YouTube URL parsing to extract video ID
- Embedded iframe player (16:9 aspect ratio)
- Thumbnail preview images
- Video metadata below player

ACCESS CONTROL:
- Requires authentication
- User must have purchased the course
- Verification check in backend

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities

YOUTUBE URL FORMATS SUPPORTED:
- youtube.com/watch?v=VIDEO_ID
- youtu.be/VIDEO_ID
- youtube.com/embed/VIDEO_ID
- youtube.com/v/VIDEO_ID
- youtube.com/shorts/VIDEO_ID
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>
        <%= course.title %> - Lessons
    </title>

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-950 min-h-screen overflow-x-hidden">
    <div class="flex min-h-screen bg-slate-950">
        <!-- Dashboard Sidebar -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col min-w-0 lg:ml-[288px] min-h-screen">
            <!-- Mobile Header -->
            <header class="lg:hidden h-16 bg-slate-900 border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
                <button id="sidebar-toggle" class="p-2 text-slate-400 hover:text-white transition-colors" aria-label="Open sidebar">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>
                <div class="ml-4 flex items-center gap-2">
                    <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded-md shadow-sm">
                    <span class="text-white font-black text-sm tracking-tight uppercase italic">Saran Trader</span>
                </div>
            </header>

            <main class="flex-grow pb-12 overflow-y-auto">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-14">
                    <!-- ========================================
                         PAGE HEADER SECTION
                         ======================================== -->
                    <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
                        <div class="space-y-4">
                            <!-- Back link to user dashboard -->
                            <a href="/dashboard"
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 text-slate-400 hover:text-white hover:bg-white/10 transition-all border border-white/10 group text-xs font-black uppercase tracking-widest">
                                <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i> 
                                Control Center
                            </a>

                            <div class="space-y-1">
                                <h1 class="text-4xl lg:text-5xl font-black text-white tracking-tight">
                                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-white/40">
                                        <%= course.title %>
                                    </span>
                                </h1>
                                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-brand-gold/60 flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
                                    Curated Learning Materials
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================
                         VIDEO LIST SECTION
                         ======================================== -->
                    <div class="space-y-6">
                        <% if (videos.length === 0) { %>
                            <!-- Premium Empty State -->
                            <div class="relative group">
                                <div class="absolute inset-0 bg-brand-gold/5 blur-3xl rounded-[3rem] opacity-50"></div>
                                <div class="relative bg-white/5 backdrop-blur-2xl rounded-[3rem] border border-white/10 p-16 lg:p-24 text-center overflow-hidden">
                                    <div class="absolute top-0 right-0 w-64 h-64 bg-brand-gold/5 blur-3xl rounded-full -translate-y-1/2 translate-x-1/2"></div>
                                    
                                    <div class="relative z-10">
                                        <div class="w-24 h-24 bg-slate-900 rounded-[2.5rem] flex items-center justify-center text-5xl mb-8 mx-auto border border-white/5 shadow-2xl transform group-hover:scale-110 transition-transform duration-500">
                                            📺
                                        </div>
                                        <h3 class="text-2xl lg:text-3xl font-black text-white mb-4 uppercase tracking-tighter">
                                            The Vault is <span class="text-brand-gold">Pending</span>
                                        </h3>
                                        <p class="text-slate-400 max-w-md mx-auto leading-relaxed font-medium">
                                            The high-performance content for "<span class="text-white font-bold"><%= course.title %></span>" is currently being finalized. Stay tuned for the broadcast.
                                        </p>
                                        <div class="mt-10">
                                            <a href="/dashboard" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-brand-gold hover:text-white transition-colors">
                                                Return to Dashboard <i class="fa-solid fa-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 gap-4 lg:gap-6">
                                <% videos.forEach((video, index) => {
                                    const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
                                    const match = video.youtubeUrl.match(youtubeRegex);
                                    const videoId = match ? match[1] : "";
                                %>
                                    <!-- Premium Lesson Card -->
                                    <div class="group relative bg-white/5 border border-white/10 rounded-[2rem] p-4 lg:p-6 hover:bg-white/[0.08] hover:border-brand-gold/30 transition-all duration-500 flex flex-col md:flex-row gap-6 items-center">
                                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-30 transition-opacity">
                                            <span class="text-4xl font-black italic text-white leading-none"><%= String(index + 1).padStart(2, '0') %></span>
                                        </div>

                                        <!-- Thumbnail with Premium Overlay -->
                                        <div onclick="openPlayerModal('<%= videoId %>')"
                                            class="w-full md:w-80 aspect-video rounded-3xl bg-slate-900 border border-white/5 overflow-hidden flex-shrink-0 relative cursor-pointer shadow-2xl transition-all duration-500 group-hover:scale-[1.02] group-hover:border-brand-gold/20">
                                            
                                            <% if (video.thumbnailUrl) { %>
                                                <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="<%= video.title %>">
                                            <% } else if (videoId) { %>
                                                <img src="https://img.youtube.com/vi/<%= videoId %>/maxresdefault.jpg" onerror="this.src='https://img.youtube.com/vi/<%= videoId %>/mqdefault.jpg'" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="<%= video.title %>">
                                            <% } else { %>
                                                <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 bg-slate-950 p-6 text-center">
                                                    <i class="fa-solid fa-triangle-exclamation text-3xl mb-3"></i>
                                                    <p class="text-[10px] uppercase font-black tracking-widest">Feed Unavailable</p>
                                                </div>
                                            <% } %>

                                            <div class="absolute inset-0 bg-black/40 group-hover:bg-brand-gold/10 transition-colors flex items-center justify-center">
                                                <div class="w-14 h-14 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20 shadow-2xl transform scale-75 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500">
                                                    <i class="fa-solid fa-play text-xl ml-1"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex-grow space-y-3 relative z-10 text-center md:text-left">
                                            <div class="space-y-1">
                                                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-brand-gold/80">Lesson Module <%= index + 1 %></span>
                                                <h3 class="text-xl lg:text-2xl font-black text-white tracking-tight group-hover:text-brand-gold transition-colors">
                                                    <%= video.title %>
                                                </h3>
                                            </div>
                                            <p class="text-sm text-slate-400 font-medium leading-relaxed line-clamp-2 italic opacity-80 group-hover:opacity-100 transition-opacity">
                                                <%= video.description || "No transmission data provided for this module." %>
                                            </p>
                                            <div class="pt-2">
                                                <button onclick="openPlayerModal('<%= videoId %>')" 
                                                    class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-white/40 group-hover:text-white transition-colors">
                                                    Initiate Playback <i class="fa-solid fa-chevron-right text-[8px]"></i>
                                                </button>
                                            </div>
                                        </div>
                                <% }); %>
                            </div>
                        <% } %>
                    </div> <!-- Closes space-y-6 -->
                </div> <!-- Closes max-w-7xl -->
            </main>

            <%- include('../partials/footer') %>
        </div> <!-- Closes Main Content Area -->

    <!-- ========================================
         VIDEO PLAYER MODAL
         ======================================== -->
    <div id="videoPlayerModal"
        class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/95 backdrop-blur-md p-4 sm:p-8">

        <!-- Close button -->
        <button onclick="closePlayerModal()"
            class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl transition-colors z-[110]">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Video container -->
        <div class="w-full max-w-5xl aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl relative">
            <iframe id="playerIframe" class="w-full h-full" src="" frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </div>
</div> <!-- Closes Outer Flex Container -->

    <script src="/javascripts/main.js" defer></script>
            <script>
                /* ========================================
                   VIDEO PLAYER FUNCTIONS
                   ========================================
                   Handle opening/closing the fullscreen video player */

                /**
                 * Opens the video player modal with specified YouTube video
                 * @param {string} videoId - YouTube video ID (11 characters)
                 */
                function openPlayerModal(videoId) {
                    // Validate video ID exists
                    if (!videoId) return;

                    // Get iframe element and set source to YouTube embed URL
                    // autoplay=1 parameter starts video immediately
                    const iframe = document.getElementById('playerIframe');
                    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

                    // Show modal by removing 'hidden' class
                    document.getElementById('videoPlayerModal').classList.remove('hidden');

                    // Disable body scrolling while modal is open
                    document.body.style.overflow = 'hidden';
                }

                /**
                 * Closes the video player modal and stops video playback
                 */
                function closePlayerModal() {
                    // Get iframe and clear source (stops video)
                    const iframe = document.getElementById('playerIframe');
                    iframe.src = '';

                    // Hide modal by adding 'hidden' class
                    document.getElementById('videoPlayerModal').classList.add('hidden');

                    // Re-enable body scrolling
                    document.body.style.overflow = '';
                }

                /* ========================================
                   KEYBOARD SHORTCUTS
                   ======================================== */

                // Close modal when Escape key is pressed
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closePlayerModal();
                    }
                });
            </script>
</body>

</html>