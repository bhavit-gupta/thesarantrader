<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | The Saran Trader</title>
    
    <!-- CSS -->
    <link rel="stylesheet" href="/stylesheets/output.css">
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body class="bg-brand-navy text-white font-sans antialiased min-h-screen flex flex-col selection:bg-brand-gold/30">
    <%- include('../partials/navbar') %>

    <main class="flex-grow flex items-center justify-center pt-36 pb-12 relative overflow-hidden">
        <!-- Background Ambient Glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-gold/5 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto px-6 text-center">
            <!-- Large 404 Graphic -->
            <div class="mb-12 group flex flex-col items-center">
                <div class="inline-flex items-center justify-center px-6 py-2 rounded-full bg-brand-gold/10 text-brand-gold text-2xl font-black tracking-widest mb-8 border border-brand-gold/20 shadow-[0_0_15px_rgba(212,175,55,0.2)]">
                    <i class="fa-solid fa-triangle-exclamation mr-3 pt-1"></i> ERROR 404
                </div>
                <h1 class="text-4xl md:text-6xl font-black text-white leading-tight tracking-tighter mb-4">
                    Trend Is <span class="italic text-brand-gold">Not Found</span>
                </h1>
                <div class="w-16 h-1 bg-brand-gold rounded-full opacity-50 shadow-[0_0_15px_rgba(212,175,55,0.4)]"></div>
            </div>

            <!-- Description -->
            <div class="space-y-4 mb-12">
                <p class="text-xl md:text-2xl font-light text-slate-300">
                    It looks like you've hit a <span class="text-red-400 font-medium">Gap Down</span>.
                </p>
                <p class="text-slate-400 max-w-lg mx-auto leading-relaxed">
                    The requested page is currently unavailable or has been liquidated. Let's get your strategy back on track.
                </p>
            </div>

            <!-- Primary CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
                <a href="<%= links.platform.home %>" 
                   class="w-full sm:w-auto px-10 py-4 bg-gradient-to-r from-brand-gold to-brand-accent text-brand-navy font-black rounded-xl hover:scale-105 transition-all shadow-xl shadow-brand-gold/10 flex items-center justify-center gap-3">
                    <i class="fa-solid fa-chart-line text-lg"></i> Return to Dashboard
                </a>
                <a href="<%= links.platform.courses %>" 
                   class="w-full sm:w-auto px-10 py-4 bg-white/5 text-white border border-white/10 rounded-xl hover:bg-white/10 transition-all font-bold flex items-center justify-center gap-3">
                    <i class="fa-solid fa-graduation-cap text-lg text-brand-gold"></i> Browse Courses
                </a>
            </div>

            <!-- Quick Help Links -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-12 border-t border-white/5">
                <a href="<%= links.platform.community %>" class="text-xs font-semibold text-slate-500 hover:text-brand-gold transition-colors">COMMUNITY</a>
                <a href="<%= links.platform.features %>" class="text-xs font-semibold text-slate-500 hover:text-brand-gold transition-colors">STRATEGIES</a>
                <a href="<%= links.platform.testimonials %>" class="text-xs font-semibold text-slate-500 hover:text-brand-gold transition-colors">SUCCESS STORIES</a>
                <a href="<%= links.contact.supportUrl %>" class="text-xs font-semibold text-slate-500 hover:text-brand-gold transition-colors">CONTACT SUPPORT</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/javascripts/main.js" defer></script>
</body>

</html>
