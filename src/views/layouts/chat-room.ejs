<!-- 
========================================
FILE: chat-room.ejs
PURPOSE: Individual Course Chat Room
========================================

DESCRIPTION:
Real-time chat interface for a specific course. Allows users enrolled
in the same course to communicate, share images, and ask questions.

FEATURES:
- Real-time message loading and display
- Text messages with image attachments
- Message timestamps and sender info
- Auto-scroll to latest messages
- Image preview before sending
- Course-specific chat header
- Back navigation to chat rooms list

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- course (object): Current course details
  - id (string): Course ID
  - title (string): Course name
  - icon (string): Emoji icon for course
- user (object): Current authenticated user
  - id (string): User ID
  - name (string): User's display name

DATA SOURCE:
- API: GET /api/chat/messages/:courseId (loaded by chat.js)
- POST /api/chat/send (for sending messages)

ACCESS CONTROL:
- Requires authentication
- User must have purchased the course

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- chat.js: Real-time message handling, image upload, message rendering

GLOBAL JAVASCRIPT VARIABLES:
- window.courseId: Current course ID
- window.currentUserId: Current user ID
- window.currentUserName: User's display name
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= course.title %> Chat - TheSaranTrader
    </title>
    <meta name="description"
        content="Join the <%= course.title %> chat room. Connect with fellow users, discuss trading strategies, and get help from the community.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="https://thesarantrader.com/chat/<%= course.id %>">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">

    <%- include('../partials/navbar') %>

        <main class="flex-grow pt-24 pb-12">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col">

                <!-- Chat Header -->
                <div class="bg-white rounded-t-2xl border border-slate-200 p-4 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <a href="/chat" class="text-slate-400 hover:text-slate-600 transition-colors">
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>
                        <div class="text-3xl">
                            <%= course.icon %>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">
                                <%= course.title %>
                            </h2>
                            <p class="text-sm text-slate-500">Course Chat Room</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-green-600">
                        <i class="fa-solid fa-circle text-xs"></i>
                        <span>Active</span>
                    </div>
                </div>

                <!-- Messages Container -->
                <div id="messages-container" class="flex-1 bg-white border-x border-slate-200 p-6 overflow-y-auto"
                    style="max-height: 500px;">
                    <div id="messages-loading" class="text-center py-12">
                        <i class="fa-solid fa-spinner fa-spin text-4xl text-blue-500"></i>
                        <p class="text-slate-500 mt-4">Loading messages...</p>
                    </div>
                    <div id="messages-list" class="hidden space-y-4">
                        <!-- Messages will be loaded here -->
                    </div>
                    <div id="empty-messages" class="hidden text-center py-12">
                        <div class="text-6xl mb-4">💬</div>
                        <h3 class="text-xl font-bold text-slate-800 mb-2">No messages yet</h3>
                        <p class="text-slate-500">Be the first to start the conversation!</p>
                    </div>
                </div>

                <!-- Message Input -->
                <div class="bg-white rounded-b-2xl border border-slate-200 p-4">
                    <form id="message-form" class="flex flex-col gap-3">
                        <div class="flex gap-3">
                            <div class="relative flex-1">
                                <input type="text" id="message-input" placeholder="Type your message..." maxlength="500"
                                    class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <label for="chat-image"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer text-slate-400 hover:text-blue-600 transition-colors">
                                    <i class="fa-regular fa-image text-lg"></i>
                                    <input type="file" id="chat-image" accept="image/*" class="hidden">
                                </label>
                            </div>
                            <button type="submit"
                                class="px-6 py-3 rounded-lg bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold hover:shadow-lg transition-all">
                                <i class="fa-solid fa-paper-plane mr-2"></i>Send
                            </button>
                        </div>

                        <!-- Image Preview Area -->
                        <div id="chat-image-preview-container" class="hidden relative self-start mt-2">
                            <img id="chat-image-preview" src="#" alt="Preview"
                                class="max-h-32 rounded-lg border border-slate-200">
                            <button type="button" id="remove-chat-image"
                                class="absolute -top-2 -right-2 w-6 h-6 bg-white rounded-full shadow-md border border-slate-200 flex items-center justify-center text-red-500 hover:bg-red-50 transition-all">
                                <i class="fa-solid fa-times text-xs"></i>
                            </button>
                        </div>
                    </form>
                    <div id="message-feedback" class="hidden mt-2"></div>
                </div>

            </div>
        </main>

        <script>
            window.courseId = "<%= course && course.id ? course.id : '' %>";
            window.currentUserId = "<%= user && user.id ? user.id : '' %>";
            window.currentUserName = "<%= user && user.name ? user.name : '' %>";
        </script>
        <script src="/javascripts/main.js" defer></script>
        <script src="/javascripts/chat.js"></script>
</body>

</html>