<!-- 
========================================
FILE: chat-room.ejs
PURPOSE: Individual Course Chat Room
========================================

DESCRIPTION:
Real-time chat interface for a specific course. Allows users enrolled
in the same course to communicate, share images, and ask questions.

FEATURES:
- Real-time message loading and display
- Text messages with image attachments
- Message timestamps and sender info
- Auto-scroll to latest messages
- Image preview before sending
- Course-specific chat header
- Back navigation to chat rooms list

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- course (object): Current course details
  - id (string): Course ID
  - title (string): Course name
  - icon (string): Emoji icon for course
- user (object): Current authenticated user
  - id (string): User ID
  - name (string): User's display name

DATA SOURCE:
- API: GET /api/chat/messages/:courseId (loaded by chat.js)
- POST /api/chat/send (for sending messages)

ACCESS CONTROL:
- Requires authentication
- User must have purchased the course

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- chat.js: Real-time message handling, image upload, message rendering

GLOBAL JAVASCRIPT VARIABLES:
- window.courseId: Current course ID
- window.currentUserId: Current user ID
- window.currentUserName: User's display name
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= course.title %> Chat - TheSaranTrader
    </title>
    <meta name="description"
        content="Join the <%= course.title %> chat room. Connect with fellow users, discuss trading strategies, and get help from the community.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="https://thesarantrader.com/chat/<%= course.id %>">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

    <body class="font-sans antialiased text-slate-600 bg-slate-950 h-screen overflow-x-hidden overflow-y-hidden">
        <!-- Sidebar Navigation -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Mobile Header (Visible only on mobile) -->
        <header class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-slate-900 border-b border-white/10 flex items-center px-4 z-40 shadow-lg">
            <button id="sidebar-toggle" class="p-2 -ml-2 text-slate-400 hover:text-white transition-colors">
                <i class="fa-solid fa-bars-staggered text-xl"></i>
            </button>
            <div class="ml-4 flex items-center gap-2">
                <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded shadow-sm">
                <span class="text-white font-bold text-sm tracking-tight italic">Saran Trader</span>
            </div>
        </header>

        <!-- Main Content Area -->
        <div class="lg:ml-[288px] h-screen flex flex-col overflow-x-hidden overflow-y-hidden">
            <main class="flex-grow flex flex-col pt-16 lg:pt-0 min-h-0 overflow-hidden bg-slate-950">
                <div class="flex-grow flex flex-col max-w-6xl mx-auto w-full px-0 sm:px-6 lg:px-8 py-0 sm:py-6 lg:py-8 min-h-0 overflow-hidden">

                    <!-- Chat Container -->
                    <div class="flex-grow flex flex-col bg-white sm:rounded-[2rem] shadow-2xl shadow-black/20 border border-white/5 overflow-hidden">
                        
                        <!-- Chat Header -->
                        <div class="bg-white border-b border-slate-100 p-4 lg:p-6 flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <a href="/chat" class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-all border border-slate-100">
                                    <i class="fa-solid fa-arrow-left"></i>
                                </a>
                                <div class="text-4xl filter drop-shadow-sm">
                                    <%= course.icon %>
                                </div>
                                <div>
                                    <h2 class="text-lg lg:text-xl font-black text-slate-900 tracking-tight leading-none">
                                        <%= course.title %>
                                    </h2>
                                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mt-1.5 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold/60"></span>
                                        Member Lounge
                                    </p>
                                </div>
                            </div>
                            <div class="hidden sm:flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-green-500/5 border border-green-500/10">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                                </span>
                                <span class="text-[10px] font-black uppercase tracking-widest text-green-600">Secure Live Connection</span>
                            </div>
                        </div>

                        <!-- Messages Container -->
                        <div id="messages-container" class="flex-1 bg-white p-4 lg:p-8 overflow-y-auto custom-scrollbar">
                            <div id="messages-loading" class="flex flex-col items-center justify-center py-20 text-center">
                                <div class="relative w-16 h-16 mb-6">
                                    <div class="absolute inset-0 rounded-2xl border-4 border-slate-100"></div>
                                    <div class="absolute inset-0 rounded-2xl border-4 border-t-brand-gold animate-spin"></div>
                                </div>
                                <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest">Hydrating Session</h3>
                                <p class="text-xs text-slate-400 mt-2">Connecting to secure trading lounge...</p>
                            </div>
                            <div id="messages-list" class="hidden flex flex-col gap-6">
                                <!-- Messages will be loaded here -->
                            </div>
                            <div id="empty-messages" class="hidden flex flex-col items-center justify-center py-20 text-center grayscale opacity-60">
                                <div class="w-24 h-24 bg-slate-50 rounded-[2rem] flex items-center justify-center text-5xl mb-6 border border-slate-100 shadow-inner">💬</div>
                                <h3 class="text-xl font-black text-slate-900 mb-2">The Silence of the Market</h3>
                                <p class="text-slate-500 text-sm italic">Be the first to initiate a trade discussion or ask a question.</p>
                            </div>
                        </div>

                        <!-- Message Input -->
                        <div class="bg-white border-t border-slate-100 p-3 sm:p-4 lg:p-6 shadow-2xl">
                            <form id="message-form" class="flex flex-col gap-3 sm:gap-4">
                                <div class="flex items-end gap-2 sm:gap-4">
                                    <div class="relative flex-1 group">
                                        <textarea id="message-input" placeholder="Compose trading insight..." maxlength="500" rows="1"
                                            class="w-full pl-6 pr-14 py-4 rounded-3xl border-2 border-slate-100 focus:outline-none focus:border-brand-gold/30 focus:bg-slate-50/50 transition-all resize-none text-slate-800 font-medium placeholder:text-slate-300 placeholder:font-bold placeholder:uppercase placeholder:tracking-widest placeholder:text-[10px]"></textarea>
                                        
                                        <div class="absolute right-2 bottom-2">
                                            <label for="chat-image"
                                                class="w-10 h-10 rounded-2xl bg-slate-50 flex items-center justify-center cursor-pointer text-slate-400 hover:text-brand-gold hover:bg-slate-100 transition-all border border-slate-100 active:scale-95 shadow-sm">
                                                <i class="fa-regular fa-image text-lg"></i>
                                                <input type="file" id="chat-image" accept="image/*" class="hidden">
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <button type="submit"
                                        class="h-14 px-4 sm:px-6 lg:px-8 rounded-3xl bg-slate-900 text-brand-gold font-black hover:bg-black hover:shadow-2xl hover:shadow-brand-gold/20 transition-all active:scale-95 flex items-center justify-center gap-2">
                                        <span class="hidden md:inline uppercase tracking-widest text-[10px]">Broadcast</span>
                                        <i class="fa-solid fa-paper-plane text-sm"></i>
                                    </button>
                                </div>

                                <!-- Image Preview Area -->
                                <div id="chat-image-preview-container" class="hidden relative self-start group">
                                    <div class="bg-slate-900 rounded-3xl p-1 shadow-2xl">
                                        <img id="chat-image-preview" src="#" alt="Preview"
                                            class="max-h-40 rounded-[1.25rem] border border-white/10">
                                    </div>
                                    <button type="button" id="remove-chat-image"
                                        class="absolute -top-3 -right-3 w-8 h-8 bg-white rounded-2xl shadow-xl border border-slate-100 flex items-center justify-center text-red-500 hover:bg-red-500 hover:text-white transition-all transform hover:rotate-90">
                                        <i class="fa-solid fa-times text-sm"></i>
                                    </button>
                                </div>
                            </form>
                            <div id="message-feedback" class="hidden mt-3 text-[10px] font-black uppercase tracking-widest text-center"></div>
                        </div>
                    </div>

                </div>
            </main>
        </div>

        <script>
            window.courseId = "<%= course && course.id ? course.id : '' %>";
            window.currentUserId = "<%= user && user.id ? user.id : '' %>";
            window.currentUserName = "<%= user && user.name ? user.name : '' %>";
        </script>
        <script src="/javascripts/main.js" defer></script>
        <script src="/javascripts/chat.js"></script>
        <style>
            /* Smooth transitions for chat input expansion */
            #message-input {
                transition: height 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
                min-height: 56px;
                max-height: 150px;
            }
        </style>
    </body>dy>

</html>