<!-- 
========================================
FILE: chat-rooms.ejs
PURPOSE: Course Chat Rooms Directory
========================================

DESCRIPTION:
Displays all available chat rooms for courses the user has purchased.
Each purchased course has a dedicated chat room for user discussions.

FEATURES:
- Grid of chat room cards (one per purchased course)
- Empty state if no courses purchased
- Active status indicator
- Direct links to individual chat rooms
- Responsive grid layout (1/2/3 columns)

EXPECTED VARIABLES:
- purchasedCourses (array): List of courses user has purchased
  Each course object contains: id, title, icon

ACCESS CONTROL:
- Requires authentication (user must be logged in)
- Only shows chat rooms for purchased courses

NAVIGATION:
- Click course card → /chat/:courseId (individual chat room)

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
-->
<% const safePurchasedCourses=Array.isArray(purchasedCourses) ? purchasedCourses : []; %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Course Chat Rooms - Connect with Users | TheSaranTrader</title>
        <meta name="description"
            content="Access exclusive chat rooms for your purchased F&O trading courses. Connect with fellow users, discuss strategies, and get real-time support.">
        <meta name="robots" content="noindex, nofollow">
        <link rel="canonical" href="https://thesarantrader.com/chat">

        <!-- Favicon -->
        <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
        <link rel="apple-touch-icon" href="/images/favicon.jpg">

        <!-- Theme Color -->
        <meta name="theme-color" content="#2563eb">

        <!-- Preconnect Hints -->
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
        <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

        <!-- Font Awesome with SRI -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
            crossorigin="anonymous" referrerpolicy="no-referrer">

        <link rel="stylesheet" href="/stylesheets/output.css">
    </head>

    <body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">

        <%- include('../partials/navbar') %>

            <main class="flex-grow pt-24 pb-12">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

                    <!-- Page Header -->
                    <div class="mb-8 text-center">
                        <h1 class="text-4xl font-bold text-slate-800 mb-2">
                            Course <span
                                class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Chat
                                Rooms</span>
                        </h1>
                        <p class="text-slate-500 mb-5">Connect with fellow users in your purchased courses</p>
                        <a href="/courses"
                            class="inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold text-base shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all">
                            <i class="fa-solid fa-graduation-cap"></i>
                            Explore Courses
                            <i class="fa-solid fa-arrow-right text-sm opacity-75"></i>
                        </a>
                    </div>

                    <!-- Course Chat Rooms Grid -->
                    <% if (safePurchasedCourses.length> 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <!-- Chat Room Cards (Loop through purchased courses) -->
                            <% safePurchasedCourses.forEach(course=> { %>
                                <a href="/chat/<%= course.id %>"
                                    class="group block bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-all transform hover:-translate-y-1 overflow-hidden">
                                    <!-- Course Icon Header -->
                                    <div
                                        class="p-6 bg-gradient-to-br from-blue-50 to-purple-50 border-b border-slate-100">
                                        <div class="text-6xl mb-3 text-center">
                                            <%= course.icon %>
                                        </div>
                                        <h3 class="text-xl font-bold text-slate-800 text-center">
                                            <%= course.title %>
                                        </h3>
                                    </div>

                                    <!-- Chat Info & Enter Button -->
                                    <div class="p-6">
                                        <div class="flex items-center justify-between mb-4">
                                            <div class="flex items-center gap-2 text-sm text-slate-500">
                                                <i class="fa-solid fa-comments"></i>
                                                <span>Chat Room</span>
                                            </div>
                                            <div class="flex items-center gap-2 text-sm text-green-600">
                                                <i class="fa-solid fa-circle text-xs"></i>
                                                <span>Active</span>
                                            </div>
                                        </div>

                                        <div
                                            class="flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-blue-50 text-blue-700 font-semibold group-hover:bg-blue-100 transition-colors">
                                            <i class="fa-solid fa-arrow-right"></i>
                                            <span>Enter Chat</span>
                                        </div>
                                    </div>
                                </a>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <!-- Empty State (No purchased courses) -->
                            <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                                <i class="fa-solid fa-comments text-6xl text-slate-300 mb-4"></i>
                                <h3 class="text-xl font-bold text-slate-800 mb-2">No Chat Rooms Yet</h3>
                                <p class="text-slate-500 mb-4">Purchase a course to access exclusive chat rooms</p>
                                <a href="/courses"
                                    class="inline-block px-6 py-2.5 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold hover:shadow-lg transition-all transform hover:-translate-y-0.5">
                                    <i class="fa-solid fa-book mr-2"></i>Browse Courses
                                </a>
                            </div>
                            <% } %>

                </div>
            </main>

            <script src="/javascripts/main.js" defer></script>
    </body>

    </html>