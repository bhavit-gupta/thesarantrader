<!-- 
========================================
FILE: chat-rooms.ejs
PURPOSE: Course Chat Rooms Directory
========================================

DESCRIPTION:
Displays all available chat rooms for courses the user has purchased.
Each purchased course has a dedicated chat room for user discussions.

FEATURES:
- Grid of chat room cards (one per purchased course)
- Empty state if no courses purchased
- Active status indicator
- Direct links to individual chat rooms
- Responsive grid layout (1/2/3 columns)

EXPECTED VARIABLES:
- purchasedCourses (array): List of courses user has purchased
  Each course object contains: id, title, icon

ACCESS CONTROL:
- Requires authentication (user must be logged in)
- Only shows chat rooms for purchased courses

NAVIGATION:
- Click course card → /chat/:courseId (individual chat room)

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
-->
<% const safePurchasedCourses=Array.isArray(purchasedCourses) ? purchasedCourses : []; %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Course Chat Rooms - Connect with Users | TheSaranTrader</title>
        <meta name="description"
            content="Access exclusive chat rooms for your purchased F&O trading courses. Connect with fellow users, discuss strategies, and get real-time support.">
        <meta name="robots" content="noindex, nofollow">
        <link rel="canonical" href="https://thesarantrader.com/chat">

        <!-- Favicon -->
        <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
        <link rel="apple-touch-icon" href="/images/favicon.jpg">

        <!-- Theme Color -->
        <meta name="theme-color" content="#2563eb">

        <!-- Preconnect Hints -->
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
        <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

        <!-- Font Awesome with SRI -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
            crossorigin="anonymous" referrerpolicy="no-referrer">

        <link rel="stylesheet" href="/stylesheets/output.css">
    </head>

    <body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen">
        <!-- Sidebar Navigation -->
        <%- include('../partials/dashboard_sidebar') %>

        <!-- Mobile Header (Visible only on mobile) -->
        <header class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-slate-900 border-b border-white/10 flex items-center px-4 z-40 shadow-lg">
            <button id="sidebar-toggle" class="p-2 -ml-2 text-slate-400 hover:text-white transition-colors">
                <i class="fa-solid fa-bars-staggered text-xl"></i>
            </button>
            <div class="ml-4 flex items-center gap-2">
                <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded shadow-sm">
                <span class="text-white font-bold text-sm tracking-tight italic">Saran Trader</span>
            </div>
        </header>

        <!-- Main Content Area -->
        <div class="lg:ml-[288px] min-h-screen flex flex-col">
            <main class="flex-grow pt-24 lg:pt-12 pb-12">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

                    <!-- Page Header -->
                    <div class="mb-8 text-center">
                        <h1 class="text-4xl font-extrabold text-slate-900 mb-2">
                            Course <span
                                class="bg-gradient-to-r from-brand-gold to-yellow-600 bg-clip-text text-transparent italic">Chat
                                Rooms</span>
                        </h1>
                        <p class="text-slate-500 mb-6 font-medium">Connect with fellow users in your purchased courses</p>
                        <a href="/courses"
                            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-slate-900 text-white font-bold text-base shadow-xl shadow-slate-900/20 hover:shadow-slate-900/40 hover:-translate-y-1 transition-all border border-white/5 group">
                            <i class="fa-solid fa-graduation-cap text-brand-gold group-hover:scale-110 transition-transform"></i>
                            Explore Courses
                            <i class="fa-solid fa-arrow-right text-sm opacity-75 group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                    <!-- Course Chat Rooms Grid -->
                    <% if (safePurchasedCourses.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                            <!-- Chat Room Cards (Loop through purchased courses) -->
                            <% safePurchasedCourses.forEach(course => { %>
                                <a href="/chat/<%= course.id %>"
                                    class="group block bg-white rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-2xl hover:shadow-brand-gold/10 transition-all transform hover:-translate-y-2 overflow-hidden">
                                    <!-- Course Icon Header -->
                                    <div class="p-8 bg-gradient-to-br from-slate-50 to-white border-b border-slate-100 relative overflow-hidden h-48 flex flex-col items-center justify-center">
                                        <div class="absolute top-0 right-0 p-4 opacity-[0.03] group-hover:opacity-[0.07] transition-opacity">
                                            <i class="fa-solid fa-comments text-8xl -rotate-12"></i>
                                        </div>
                                        <div class="text-7xl mb-4 transform group-hover:scale-110 transition-transform duration-500 ease-out drop-shadow-sm">
                                            <%= course.icon %>
                                        </div>
                                        <h3 class="text-xl font-black text-slate-900 text-center tracking-tight leading-tight px-4">
                                            <%= course.title %>
                                        </h3>
                                    </div>

                                    <!-- Chat Info & Enter Button -->
                                    <div class="p-8">
                                        <div class="flex items-center justify-between mb-8">
                                            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.15em] <%= course.id === 'e1f1a7e78ba742e88c7c1c9f' ? 'text-blue-500' : 'text-slate-400' %>">
                                                <i class="fa-solid <%= course.id === 'e1f1a7e78ba742e88c7c1c9f' ? 'fa-globe' : 'fa-shield-halved' %> text-brand-gold/60"></i>
                                                <span><%= course.id === 'e1f1a7e78ba742e88c7c1c9f' ? 'Community Access' : 'Private Lounge' %></span>
                                            </div>
                                            <% 
                                                const now = new Date();
                                                const isActive = course.lastActivityAt && 
                                                    (now - new Date(course.lastActivityAt)) < 24 * 60 * 60 * 1000;
                                            %>
                                            <% if (isActive) { %>
                                            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.15em] text-green-600 bg-green-500/5 px-2 py-1 rounded-full border border-green-500/10">
                                                <span class="relative flex h-1.5 w-1.5">
                                                    <span class="animate-ping absolute inline-flex h-1.5 w-1.5 rounded-full bg-green-400 opacity-75"></span>
                                                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span>
                                                </span>
                                                <span>Active</span>
                                            </div>
                                            <% } else { %>
                                            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.15em] text-slate-400 bg-slate-100 px-2 py-1 rounded-full">
                                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-slate-300"></span>
                                                <span>Quiet</span>
                                            </div>
                                            <% } %>
                                        </div>

                                        <div
                                            class="flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-slate-900 text-white font-black group-hover:bg-brand-gold group-hover:text-slate-950 transition-all duration-300 shadow-xl shadow-slate-900/10 group-hover:shadow-brand-gold/30">
                                            <span class="text-sm">Enter Chat Room</span>
                                            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                                        </div>
                                    </div>
                                </a>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <!-- Empty State (No purchased courses) -->
                            <div class="bg-white rounded-[2.5rem] border-2 border-dashed border-slate-200 p-20 text-center shadow-inner max-w-2xl mx-auto">
                                <div class="w-24 h-24 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-8 rotate-3 shadow-sm">
                                    <i class="fa-solid fa-comments text-5xl text-slate-300"></i>
                                </div>
                                <h3 class="text-3xl font-black text-slate-900 mb-3">No Member Access</h3>
                                <p class="text-slate-500 mb-10 text-lg leading-relaxed">You need to be enrolled in a course to access the private trader lounges and coordinate with your peers.</p>
                                <a href="/courses"
                                    class="inline-flex items-center gap-4 px-10 py-4 rounded-full bg-brand-gold text-slate-950 font-black shadow-xl shadow-brand-gold/20 hover:shadow-brand-gold/40 transition-all transform hover:-translate-y-1">
                                    <i class="fa-solid fa-book"></i>
                                    Browse Our Courses
                                </a>
                            </div>
                            <% } %>

                </div>
            </main>
        </div>

        <script src="/javascripts/main.js" defer></script>
    </body>

    </html>