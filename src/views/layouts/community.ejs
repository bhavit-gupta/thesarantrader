<!-- 
========================================
FILE: community.ejs
PURPOSE: Community Feed & Social Posts Page
========================================

DESCRIPTION:
Public community hub where users can share posts, images, and discussions.
Authenticated users can create posts; everyone can view the feed.

FEATURES:
- Create post form (title, content, optional image)
- Character counter (1000 char limit)
- Image upload with preview
- Dynamic post feed (loaded from API)
- Like, comment, and delete functionality
- Admin moderation capabilities
- Empty state for no posts
- Authentication-aware UI (show create form only for logged-in users)

EXPECTED VARIABLES:
- csrfToken (string): CSRF protection token
- user (object, optional): Current authenticated user
  - id (string): User ID
  - role (string): User role ('user' or 'admin')

DATA SOURCE:
- API: GET /api/community/posts (loaded by community.js)
- API: POST /api/community/post (create new post)

UI STATES:
- Authenticated: Show create post form
- Guest: Show login prompt
- Loading: Spinner animation
- Empty: Empty state message
- Loaded: Feed of posts

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- community.js: Post creation, feed loading, like/comment/delete actions

GLOBAL JAVASCRIPT VARIABLES:
- window.currentUserId: Current user ID (empty string if guest)
- window.isAdmin: Boolean indicating admin status
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community Hub - Join the Conversation | TheSaranTrader</title>
    <meta name="description"
        content="Join The Saran Trader community hub. Share trading insights, discuss strategies, and connect with thousands of successful users. Free to join!">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    <link rel="canonical" href="https://thesarantrader.com/community">

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e3a8a">

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thesarantrader.com/community">
    <meta property="og:title" content="Community Hub - Join the Conversation | TheSaranTrader">
    <meta property="og:description"
        content="Connect with fellow users, share insights, and learn from the community. Join thousands of users discussing strategies.">
    <meta property="og:image" content="https://thesarantrader.com/images/community-og.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Community Hub - TheSaranTrader">
    <meta name="twitter:description"
        content="Connect with fellow traders, share insights, and learn from the community.">
    <meta name="twitter:image" content="https://thesarantrader.com/images/community-og.jpg">

    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-slate-50 min-h-screen flex flex-col">

    <%- include('../partials/navbar') %>

        <main class="flex-grow pt-24 pb-12">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Header -->
                <div class="mb-8 text-center">
                    <h1 class="text-4xl font-bold text-slate-800 mb-2">
                        Community <span
                            class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Hub</span>
                    </h1>
                    <p class="text-slate-500 mb-5">Connect, share, and learn together</p>
                    <a href="/courses"
                        class="inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold text-base shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all">
                        <i class="fa-solid fa-graduation-cap"></i>
                        Explore Courses
                        <i class="fa-solid fa-arrow-right text-sm opacity-75"></i>
                    </a>
                </div>

                <!-- Create Post Card -->
                <% if (user) { %>
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-8">
                        <h2 class="text-lg font-bold text-slate-800 mb-4">Share with the community</h2>
                        <form id="create-post-form">
                            <input type="text" id="post-title" placeholder="Title (optional)"
                                class="w-full px-4 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 mb-3">
                            <textarea id="post-content" rows="4" placeholder="What's on your mind?" required
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none mb-2"></textarea>
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span id="post-char-count" class="text-xs text-slate-400">0 / 1000</span>
                                    <label for="post-image"
                                        class="cursor-pointer group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors">
                                        <div
                                            class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center group-hover:bg-blue-50">
                                            <i class="fa-regular fa-image text-sm"></i>
                                        </div>
                                        <span class="text-xs font-semibold">Add Image</span>
                                        <input type="file" id="post-image" accept="image/*" class="hidden">
                                    </label>
                                </div>
                                <button type="submit"
                                    class="px-6 py-2.5 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold hover:shadow-lg transition-all transform hover:-translate-y-0.5">
                                    <i class="fa-solid fa-paper-plane mr-2"></i>Post
                                </button>
                            </div>

                            <!-- Image Preview Area -->
                            <div id="image-preview-container" class="hidden relative mt-4">
                                <img id="image-preview" src="#" alt="Preview"
                                    class="max-h-48 rounded-xl border border-slate-200">
                                <button type="button" id="remove-image"
                                    class="absolute -top-2 -right-2 w-8 h-8 bg-white rounded-full shadow-md border border-slate-200 flex items-center justify-center text-red-500 hover:bg-red-50 transition-all">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                            </div>
                        </form>
                        <div id="post-feedback" class="hidden mt-3"></div>
                    </div>
                    <% } else { %>
                        <div
                            class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl border border-blue-200 p-8 mb-8 text-center">
                            <i class="fa-solid fa-lock text-4xl text-blue-600 mb-4"></i>
                            <h2 class="text-xl font-bold text-slate-800 mb-2">Join the Conversation</h2>
                            <p class="text-slate-600 mb-4">Log in to share your thoughts and connect with the community
                            </p>
                            <a href="/login"
                                class="inline-block px-6 py-2.5 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold hover:shadow-lg transition-all transform hover:-translate-y-0.5">
                                <i class="fa-solid fa-sign-in-alt mr-2"></i>Log In to Post
                            </a>
                        </div>
                        <% } %>

                            <!-- Posts Feed -->
                            <div id="posts-loading" class="text-center py-12">
                                <i class="fa-solid fa-spinner fa-spin text-4xl text-blue-500"></i>
                                <p class="text-slate-500 mt-4">Loading posts...</p>
                            </div>

                            <div id="posts-container" class="hidden space-y-6">
                                <!-- Posts will be loaded here dynamically -->
                            </div>

                            <div id="empty-state"
                                class="hidden bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                                <div class="text-6xl mb-4">💬</div>
                                <h3 class="text-xl font-bold text-slate-800 mb-2">No posts yet</h3>
                                <p class="text-slate-500">Be the first to share something with the community!</p>
                            </div>

            </div>
        </main>

        <script>
            // Set current user ID for client-side use (Safe JSON encoding to prevent XSS)
            window.currentUserId = "<%= (locals.user && locals.user.id) ? locals.user.id : '' %>";
            window.isAdmin = <%= (locals.user && String(locals.user.role || '').toUpperCase() === 'ADMIN') ? true : false %>;
        </script>
        <script src="/javascripts/main.js" defer></script>
        <script src="/javascripts/community.js" defer></script>
</body>

</html>