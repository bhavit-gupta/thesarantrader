<!-- 
========================================
FILE: courses.ejs
PURPOSE: Courses Catalog Page
========================================

DESCRIPTION:
Displays all available courses in a grid layout. Courses are loaded
dynamically via JavaScript from the API.

FEATURES:
- Responsive grid layout (1/2/3 columns)
- Dynamic course loading from API
- Course cards with title, description, price, icon
- Integration with navbar and footer

EXPECTED VARIABLES:
- None (uses global navbar data via include)

DATA SOURCE:
- API: GET /api/courses (loaded by courses.js)

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- courses.js: Fetches and renders courses from API
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F&O Trading Courses - Expert-Led with Lifetime Access | The Saran Trader</title>
    <meta name="description" content="Browse expert-led F&O trading courses from basics to advanced strategies. Lifetime access, practical exercises, and real market examples. Enroll today!">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    <link rel="canonical" href="https://thesarantrader.com/courses">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e3a8a">
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thesarantrader.com/courses">
    <meta property="og:title" content="F&O Trading Courses - The Saran Trader">
    <meta property="og:description" content="Master F&O trading with expert-led courses from basics to advanced. Lifetime access, practical strategies, and real market examples.">
    <meta property="og:image" content="https://thesarantrader.com/images/courses-og.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="F&O Trading Courses - The Saran Trader">
    <meta name="twitter:description" content="Master F&O trading with expert-led courses from basics to advanced.">
    <meta name="twitter:image" content="https://thesarantrader.com/images/courses-og.jpg">
    
    <!-- Preconnect Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    
    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
    
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="font-sans antialiased text-slate-600 bg-white flex flex-col min-h-screen">

    <!-- Navigation Bar -->
    <%- include('../partials/navbar')%>

    <main class="flex-grow">
        <!-- Page Header -->
        <section class="pt-32 pb-12 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h1 class="text-4xl font-bold text-slate-800 mb-4">Explore Our Premium Courses</h1>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                    Master the art of trading with our structured learning programs designed for beginners to
                    advanced traders.
                </p>
            </div>
        </section>

        <!-- Courses Grid (Dynamically Populated) -->
        <section class="py-16 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Error State -->
                <div id="courses-error" class="hidden max-w-2xl mx-auto text-center py-12">
                    <i class="fa-solid fa-exclamation-triangle text-5xl text-red-500 mb-4"></i>
                    <h3 class="text-xl font-bold text-slate-800 mb-2">Failed to Load Courses</h3>
                    <p class="text-slate-600 mb-6">We couldn't retrieve the courses. Please check your connection and try again.</p>
                    <button onclick="location.reload()" 
                            class="px-6 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition-colors">
                        <i class="fa-solid fa-rotate-right mr-2"></i>Retry
                    </button>
                </div>
                
                <!-- Empty State -->
                <div id="courses-empty" class="hidden max-w-2xl mx-auto text-center py-16">
                    <div class="text-6xl mb-4">📚</div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-3">No Courses Available Yet</h3>
                    <p class="text-slate-600 mb-8">
                        We're preparing amazing courses for you. Check back soon or join our newsletter to get notified!
                    </p>
                    <a href="/features" 
                       class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700 transition-colors">
                        Explore Platform Features
                    </a>
                </div>
                
                <!-- Courses Grid -->
                <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Loading skeleton -->
                    <% for(let i = 0; i < 6; i++) { %>
                    <div class="animate-pulse bg-slate-50 rounded-2xl overflow-hidden course-skeleton">
                        <div class="aspect-video bg-slate-200"></div>
                        <div class="p-6">
                            <div class="h-4 bg-slate-200 rounded w-1/3 mb-3"></div>
                            <div class="h-6 bg-slate-200 rounded w-3/4 mb-3"></div>
                            <div class="h-4 bg-slate-200 rounded w-full mb-2"></div>
                            <div class="h-4 bg-slate-200 rounded w-5/6 mb-4"></div>
                            <div class="flex justify-between items-center mt-6 pt-4 border-t border-slate-100">
                                <div class="h-8 bg-slate-200 rounded w-20"></div>
                                <div class="h-10 bg-slate-200 rounded-lg w-24"></div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
                
                <!-- NoScript Fallback -->
                <noscript>
                    <div class="max-w-2xl mx-auto text-center py-12">
                        <div class="bg-amber-50 rounded-2xl border border-amber-200 p-8">
                            <h3 class="text-xl font-bold text-amber-800 mb-3">JavaScript Required</h3>
                            <p class="text-amber-700">Our course catalog requires JavaScript to display. Please enable JavaScript in your browser or contact us at support@thesarantrader.com for assistance.</p>
                        </div>
                    </div>
                </noscript>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <!-- JavaScript Dependencies -->
    <script src="/javascripts/main.js" defer></script>
    <script src="/javascripts/courses.js" defer></script>
</body>

</html>