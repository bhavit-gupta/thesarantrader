<!-- 
========================================
FILE: features.ejs
PURPOSE: Platform Features Showcase Page
========================================

DESCRIPTION:
Marketing page highlighting all platform features, benefits, and value
propositions. Designed to convert visitors into registrations/purchases.

PAGE SECTIONS:
1. Hero Section - Headline with gradient text and CTA
2. Features Grid - 6 feature cards with icons and descriptions
3. How It Works - 3-step process visualization
4. CTA Section - Final conversion prompt with CTAs

FEATURES HIGHLIGHTED:
- Live Trading Sessions (real-time market analysis)
- Expert-Led Courses (structured learning)
- Course Chat Rooms (private per course)
- Community Forum (open discussions)
- Lifetime Access (buy once, learn forever)
- Affordable Pricing (50%+ discounts)

EXPECTED VARIABLES:
- user (object, optional): Current authenticated user
  - username (string): Used to determine dashboard redirect

STYLING:
- Custom CSS animations (hover effects, pulse, float)
- Gradient backgrounds and text effects
- Responsive grid layouts
- Interactive feature cards with transforms

CTAs:
- Explore Courses (all users)
- Go to Dashboard (authenticated)
- Login/Sign Up (guests)

DESIGN FEATURES:
- Animated decorative blobs in hero
- Feature cards with hover lift effects
- Icon placeholders with emoji
- Step connectors with gradient lines
- Gradient CTA section

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities and interactions
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO Optimized Title -->
    <title>Live Trading Sessions & F&O Courses - Platform Features | The Saran Trader</title>

    <!-- Meta Description -->
    <meta name="description"
        content="Learn F&O trading with live sessions, expert courses, private chat rooms, and lifetime access. Join 5000+ users today.">

    <!-- Canonical -->
    <link rel="canonical" href="https://thesarantrader.com/features">

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thesarantrader.com/features">
    <meta property="og:title" content="Trading Platform Features - The Saran Trader">
    <meta property="og:description"
        content="Live sessions, expert-led F&O courses, community chat, and lifetime access — everything you need to master trading.">
    <meta property="og:image" content="https://thesarantrader.com/images/features-og.jpg">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <link rel="apple-touch-icon" href="/images/favicon.jpg">

    <!-- Performance -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Styles -->
    <link rel="stylesheet" href="/stylesheets/output.css">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "The Saran Trader Platform",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "price": "0"
      },
      "featureList": [
        "Live Trading Sessions",
        "Expert-Led F&O Courses",
        "Private Course Chat Rooms",
        "Community Forum",
        "Lifetime Access",
        "Affordable Pricing"
      ]
    }
    </script>
    <style>
        .feature-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.1);
        }

        .feature-icon {
            transition: transform 0.3s ease;
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.15);
        }

        .step-connector {
            position: relative;
        }

        .step-connector::after {
            content: '';
            position: absolute;
            top: 32px;
            left: 50%;
            width: calc(100% + 2rem);
            height: 2px;
            background: linear-gradient(to right, #3b82f6, #4f46e5);
            z-index: 0;
        }

        @media (max-width: 767px) {
            .step-connector::after {
                display: none;
            }
        }
    </style>
</head>

<body class="font-sans antialiased text-slate-600 bg-white">

    <%- include('../partials/navbar') %>

        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 bg-gradient-to-br from-blue-50 via-indigo-50 to-slate-50 overflow-hidden">
            <!-- Decorative blobs -->
            <div
                class="absolute top-20 left-10 w-72 h-72 bg-blue-200 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse">
            </div>
            <div class="absolute bottom-10 right-10 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"
                style="animation-delay: 2s;"></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-3xl mx-auto">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-semibold mb-6 border border-blue-100">
                        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                        Platform Features
                    </div>
                    <h1 class="text-4xl lg:text-5xl font-bold text-slate-800 leading-tight mb-6">
                        Everything You Need to
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-500">Master
                            Trading</span>
                    </h1>
                    <p class="mb-5">From live sessions to community support, our platform is packed with tools and
                        resources
                        designed to turn you into a confident, profitable user.</p>
                    <!-- CTA Button -->
                    <a href="/courses"
                        class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold text-lg shadow-xl shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all">
                        <i class="fa-solid fa-graduation-cap"></i>
                        Explore Courses
                        <i class="fa-solid fa-arrow-right text-sm opacity-75"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Features Grid -->
        <section class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                    <!-- Feature 1: Live Trading Sessions -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-red-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            📡
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Live Trading Sessions</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Watch Kundan Sir trade live during market hours. Get real-time market analysis, strategy
                            breakdowns, and instant Q&A.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-red-500 font-medium">
                            <span class="w-2 h-2 rounded-full bg-red-500"></span>
                            Real-time experience
                        </div>
                    </div>

                    <!-- Feature 2: Expert-Led Courses -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            👨‍🏫
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Expert-Led Courses</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Structured courses from basics to advanced strategies, taught by Kundan Sir with real market
                            examples and practical exercises.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-blue-500 font-medium">
                            <i class="fa-solid fa-graduation-cap"></i>
                            Beginner to advanced
                        </div>
                    </div>

                    <!-- Feature 3: Course Chat Rooms -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-purple-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            💬
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Course Chat Rooms</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Each course comes with its own private chat room. Discuss strategies, ask doubts, and learn
                            collaboratively with peers.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-purple-500 font-medium">
                            <i class="fa-solid fa-comments"></i>
                            Private per course
                        </div>
                    </div>

                    <!-- Feature 4: Community Forum -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            🌐
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Community Forum</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Join an active community of traders. Share insights, post trade setups, discuss market
                            trends, and learn from each other.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-green-500 font-medium">
                            <i class="fa-solid fa-users"></i>
                            Open to all members
                        </div>
                    </div>

                    <!-- Feature 5: Lifetime Access -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-indigo-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            ♾️
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Lifetime Access</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Buy once, learn forever. Your course materials never expire and you'll receive all future
                            updates at no extra cost.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-indigo-500 font-medium">
                            <i class="fa-solid fa-infinity"></i>
                            No recurring fees
                        </div>
                    </div>

                    <!-- Feature 6: Affordable Pricing -->
                    <div class="feature-card bg-white p-8 rounded-2xl border border-slate-100 shadow-sm">
                        <div
                            class="feature-icon w-14 h-14 bg-orange-50 rounded-xl flex items-center justify-center text-2xl mb-6">
                            💰
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Affordable Pricing</h3>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Premium trading education at pocket-friendly prices. All courses come at 50%+ discounts with
                            zero hidden charges.
                        </p>
                        <div class="flex items-center gap-2 text-sm text-orange-500 font-medium">
                            <i class="fa-solid fa-tag"></i>
                            50%+ off always
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="py-20 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <span class="text-blue-600 font-semibold tracking-wider uppercase text-sm">Simple Process</span>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800 sm:text-4xl">How It Works</h2>
                    <p class="mt-4 text-lg text-slate-600">Get started in 3 simple steps and begin your trading journey
                        today.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                    <!-- Step 1 -->
                    <div class="step-connector text-center">
                        <div
                            class="relative z-10 w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mx-auto mb-6 shadow-lg shadow-blue-500/25">
                            1
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Create an Account</h3>
                        <p class="text-slate-600">Sign up for free in under a minute. No credit card required to get
                            started.</p>
                    </div>

                    <!-- Step 2 -->
                    <div class="step-connector text-center">
                        <div
                            class="relative z-10 w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mx-auto mb-6 shadow-lg shadow-indigo-500/25">
                            2
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Pick a Course</h3>
                        <p class="text-slate-600">Browse our expert-led courses and choose the one that fits your level
                            and goals.</p>
                    </div>

                    <!-- Step 3 -->
                    <div class="text-center">
                        <div
                            class="relative z-10 w-16 h-16 bg-purple-600 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mx-auto mb-6 shadow-lg shadow-purple-500/25">
                            3
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Start Learning</h3>
                        <p class="text-slate-600">Access courses, join live sessions, chat with peers, and grow as a
                            trader.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-20 bg-white">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <div
                    class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-12 lg:p-16 shadow-2xl shadow-blue-500/20">
                    <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Ready to Start Your Trading Journey?</h2>
                    <p class="text-white mb-5">Join thousands of successful users and transform your financial future with expert guidance.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/courses"
                            class="px-8 py-4 rounded-full bg-white text-blue-700 font-semibold text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
                            Explore Courses
                        </a>
                        <% if (typeof user !=='undefined' && user) { %>
                            <% const dashboardUrl = (user && user.role?.toUpperCase() === 'ADMIN') ? '/admin/dashboard' : '/dashboard'; %>

                                <a href="<%= dashboardUrl %>"
                                    class="px-8 py-4 rounded-full bg-white text-blue-700 font-semibold text-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
                                    Go to Dashboard
                                </a>
                                <% } else { %>
                                    <a href="/login"
                                        class="px-8 py-4 rounded-full bg-white/10 backdrop-blur-sm text-white font-semibold text-center border border-white/20 hover:bg-white/20 transition-all">
                                        Login / Sign Up
                                    </a>
                                    <% } %>
                    </div>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>

            <script src="/javascripts/main.js" defer></script>
</body>

</html>