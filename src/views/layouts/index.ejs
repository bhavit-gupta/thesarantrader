<!-- ========================================================================== -->
<!--                           HOMEPAGE (index.ejs)                             -->
<!-- ========================================================================== -->
<!--
    Purpose: Landing page showcasing platform value and driving conversions
    
    Sections:
    1. Hero Section - Main value proposition with CTA buttons
    2. Courses Section - Top/featured courses grid (dynamic)
    3. Testimonials Section - User success stories (dynamic)
    4. Footer - Contact and copyright info
    
    Expected Variables:
    - user: Object | null - Current authenticated user
      - user.username: string - For admin detection
    
    Dynamic Content:
    - Courses loaded via /javascripts/courses.js (API: /api/courses)
    - Testimonials loaded via /javascripts/testimonials.js (API: /api/testimonials/public)
    
    CTAs by Auth State:
    - Guest: "Login/Signup" button
    - Logged in: "Go to Dashboard" button
    
    SEO Optimization:
    - Meta description for search engines
    - Semantic HTML5 structure
    - Proper heading hierarchy
-->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <!-- Viewport (Zoom Enabled) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO Primary -->
    <title>The Saran Trader</title>

    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <!-- Canonical (20.1 FIX) -->
    <link rel="canonical" href="https://thesarantrader.com/">

    <!-- Favicon (20.18 FIX) -->
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Preconnect + DNS Prefetch (20.24 FIX) -->
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <!-- Preload Critical Resources (20.23 FIX) -->
    <link rel="preload" as="image" href="/images/hero-image.png">
    <link rel="preload" as="style" href="/stylesheets/output.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/stylesheets/output.css">

    <!-- Font Awesome WITH SRI (20.3 FIX) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-bx3f6XgFZkGJ0J4+z7E6sMZ4nXgKjMZQ5P5YFjzZpR0H6GmP8nM8uYQqJ3VQ8d1v0Z2XyXy8W8KzX4Y1xXzXw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Open Graph (20.8 FIX) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="The Saran Trader">
    <meta property="og:description" content="Learn option trading from expert Kundan Sir">
    <meta property="og:image" content="https://thesarantrader.com/og-image.png">
    <meta property="og:url" content="https://thesarantrader.com/">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="The Saran Trader">
    <meta name="twitter:description" content="Master option trading with Kundan Sir">
    <meta name="twitter:image" content="https://thesarantrader.com/twitter-image.png">

    <!-- Schema.org Structured Data (20.7 FIX) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "The Saran Trader",
        "url": "https://thesarantrader.com",
        "description": "Master option trading with Kundan Sir",
        "potentialAction": {
            "@type": "SearchAction",
            "target": "https://thesarantrader.com/courses?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
</head>

<body class="font-sans antialiased text-slate-600 bg-white">
    <noscript>
        <div class="bg-yellow-50 text-yellow-800 text-center py-4">
            JavaScript is required for dynamic content.
            <a href="/courses" class="underline">View courses here</a>.
        </div>
    </noscript>

    <%- include('../partials/navbar') %>

        <!-- ========== HERO SECTION ========== -->
        <!-- Main landing area with headline, CTA, and hero image -->
        <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
            <!-- Background Decor -->

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">

                    <!-- ===== LEFT COLUMN: Text Content ===== -->
                    <div class="max-w-2xl">
                        <!-- Platform Badge -->
                        <div
                            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-semibold mb-6 border border-blue-100">
                            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                            #1 F&O Learning Platform
                        </div>

                        <!-- Main Headline -->
                        <h1 class="text-4xl lg:text-6xl font-bold text-slate-800 leading-tight mb-6">
                            Unlock Your Potential with <span
                                class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-400">Option
                                Trading</span>
                        </h1>

                        <!-- Subheadline / Value Proposition -->
                        <p class="mb-5">
                            Discover a world of knowledge with our expert Kundan Sir. Learn at your own pace, anytime,
                            anywhere. Join thousands of users today.
                        </p>
                        <!-- CTA Buttons (Authentication-Aware) -->
                        <div class="flex flex-col sm:flex-row gap-4">
                            <!-- Primary CTA: Explore Courses -->
                            <a href="/courses"
                                class="px-8 py-4 rounded-full bg-blue-600 text-white font-semibold text-center shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-1">
                                Explore Courses
                            </a>

                            <!-- Secondary CTA: Varies by auth state -->
                            <% if (user) { %>
                                <!-- Logged-in users: Go to their dashboard -->
                                <a href="<%= user.username === 'admin' ? '/admin/dashboard' : '/dashboard' %>"
                                    class="px-8 py-4 rounded-full bg-white text-slate-700 font-semibold text-center border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
                                    Go to Dashboard 📊
                                </a>
                                <% } else { %>
                                    <!-- Guest users: Encourage login/signup -->
                                    <a href="/login"
                                        class="px-8 py-4 rounded-full bg-white text-slate-700 font-semibold text-center border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
                                        Login/Signup
                                    </a>
                                    <% } %>
                        </div>


                    </div>

                    <!-- ===== RIGHT COLUMN: Hero Image with Floating Stats ===== -->
                    <div class="relative lg:h-auto">
                        <div
                            class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white/50 backdrop-blur-sm">
                            <div class="aspect-[4/3] bg-slate-100 flex items-center justify-center relative group">
                                <div class="absolute inset-0 bg-gradient-to-tr from-blue-100 to-indigo-50"></div>
                                <div class="relative z-10 text-center p-8">
                                    <!-- Hero Image -->
                                    <img src="/images/hero-image.png"
                                        alt="Kundan Sir teaching option trading strategies in an interactive online session"
                                        width="800" height="400" fetchpriority="high"
                                        class="max-w-full h-auto drop-shadow-2xl transform group-hover:scale-105 transition-transform duration-500">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- ========== COURSES SECTION ========== -->
        <!-- 
            Dynamically loaded course cards
            
            JavaScript: /javascripts/courses.js
            API Endpoint: /api/courses (GET)
            Loads: Top/featured courses with thumbnails, prices, enrollment counts
        -->
        <section id="courses" class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="flex justify-between items-end mb-12">
                    <div>
                        <span class="text-blue-600 font-semibold tracking-wider uppercase text-sm">Top Courses</span>
                        <h2 class="mt-2 text-3xl font-bold text-slate-800 sm:text-4xl">Explore Popular Courses</h2>
                    </div>
                    <a href="/courses"
                        class="hidden sm:flex items-center gap-2 text-blue-600 font-semibold hover:text-blue-700 transition-colors">
                        View All Courses ➡️
                    </a>
                </div>

                <!-- Courses Grid (Populated by JavaScript) -->
                <div id="courses-grid" data-testid="courses-grid"
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                    <% for (let i=0; i < 3; i++) { %>
                        <div class="animate-pulse">
                            <div class="aspect-video bg-slate-200 rounded-lg mb-4"></div>
                            <div class="h-4 bg-slate-200 rounded mb-2"></div>
                            <div class="h-4 bg-slate-200 rounded w-2/3"></div>
                        </div>
                        <% } %>

                </div>
            </div>
        </section>

        <!-- ========== TESTIMONIALS SECTION ========== -->
        <!-- 
            Dynamically loaded user testimonials
            
            JavaScript: /javascripts/testimonials.js
            API Endpoint: /api/testimonials/public (GET)
            Loads: Only approved testimonials with ratings and user feedback
        -->
        <section id="testimonials" class="py-20 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <span class="text-blue-600 font-semibold tracking-wider uppercase text-sm">Testimonials</span>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800 sm:text-4xl">What Our Users Say</h2>
                    <p class="mt-4 text-lg text-slate-600">Real success stories from traders who transformed their
                        journey with Kundan Sir's expert guidance.</p>
                </div>

                <!-- Testimonials Grid (Populated by JavaScript) -->
                <div id="testimonials-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Loading State -->
                    <div class="col-span-full flex justify-center items-center py-12">
                        <i class="fa-solid fa-spinner fa-spin text-4xl text-blue-500"></i>
                    </div>
                </div>

                <!-- Final CTA Section -->
                <div class="mt-16 text-center">
                    <p class="text-slate-600 mb-6">Join thousands of successful traders today!</p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/courses"
                            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-gradient-to-r from-blue-600 to-blue-500 text-white font-semibold shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-1 transition-all">
                            Start Your Trading Journey
                            <span>→</span>
                        </a>
                        <a href="/testimonials"
                            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white text-slate-700 font-semibold border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all">
                            <i class="fa-solid fa-comments"></i>
                            View All Testimonials
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>

            <!-- ========== JAVASCRIPT DEPENDENCIES ========== -->
            <!-- 
            Execution Order:
            1. main.js - Global utilities and helpers
            2. courses.js - Fetches and renders course cards
            3. testimonials.js - Fetches and renders testimonial cards
        -->
            <script src="/javascripts/main.js" defer></script>
            <script src="/javascripts/courses.js" defer></script>
            <script src="/javascripts/testimonials.js" defer></script>
</body>

</html>