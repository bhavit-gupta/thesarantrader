<!-- 
========================================
FILE: testimonials.ejs
PURPOSE: Public Testimonials Gallery Page
========================================

DESCRIPTION:
Displays all approved user testimonials with success stories.
Authenticated users can navigate to dashboard to submit their own testimonial.

FEATURES:
- Hero section with CTA buttons
- Dynamic testimonials grid (loaded from API)
- Authentication-aware CTAs (Explore Courses vs Share Experience)
- Loading, empty, and error states
- Responsive grid layout (1/2/3 columns)

EXPECTED VARIABLES:
- user (object, optional): Current authenticated user
  - Used to show "Share Your Experience" button for logged-in users

DATA SOURCE:
- API: GET /api/testimonials/public (loaded by all-testimonials.js)

UI STATES:
- Loading: Spinner animation
- Loaded: Grid of testimonial cards
- Empty: Empty state with CTA
- Error: Error message with retry option

JAVASCRIPT DEPENDENCIES:
- main.js: Global utilities
- all-testimonials.js: Fetches and renders testimonials from API
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO -->
    <title>User Testimonials - The Saran Trader</title>
    <meta name="description"
        content="Read authentic success stories from traders who transformed their journey with Kundan Sir's expert trading courses. Join thousands of satisfied users today!">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    <link rel="canonical" href="https://thesarantrader.com/testimonials">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://thesarantrader.com/testimonials">
    <meta property="og:title" content="User Success Stories - The Saran Trader">
    <meta property="og:description"
        content="Real testimonials from traders who transformed their journey with expert guidance.">
    <meta property="og:image" content="https://thesarantrader.com/images/testimonials-og.jpg">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563eb">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">

    <!-- Preconnect for CDN -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Styles -->
    <link rel="stylesheet" href="/stylesheets/output.css">

    <!-- Font Awesome with SRI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
</head>

<body class="font-sans antialiased text-slate-600 bg-white">
    <noscript>
        <div class="bg-amber-50 rounded-2xl border border-amber-200 p-8 text-center">
            <p class="text-amber-800 font-semibold">
                JavaScript is required to view testimonials.
            </p>
        </div>
    </noscript>

    <%- include('../partials/navbar') %>

        <!-- Hero Section -->
        <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 bg-gradient-to-br from-blue-50 to-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto">
                    <!-- Badge -->
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-semibold mb-6 border border-blue-100">
                        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                        Success Stories
                    </div>

                    <!-- Title -->
                    <h1 class="text-4xl lg:text-5xl font-bold text-slate-800 leading-tight mb-6">
                        What Our <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-400">Users</span>
                        Say
                    </h1>

                    <!-- Description -->
                    <p class="text-lg text-slate-600 leading-relaxed mb-8">
                        Real experiences from traders who transformed their journey with Kundan Sir's expert guidance.
                        Join thousands of successful users today!
                    </p>

                    <!-- CTA Buttons (Authentication-Aware) -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <!-- Explore Courses Button -->
                        <a href="/courses"
                            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold text-lg shadow-xl shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all">
                            <i class="fa-solid fa-graduation-cap"></i>
                            Explore Courses
                            <i class="fa-solid fa-arrow-right text-sm opacity-75"></i>
                        </a>

                        <!-- Share Experience Button (Only for Authenticated Users) -->
                        <% if (locals.user) { %>
                            <a href="/dashboard"
                                class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white text-slate-700 font-semibold text-lg border border-slate-200 hover:border-blue-500 hover:text-blue-600 hover:-translate-y-1 transition-all shadow-sm">
                                <i class="fa-solid fa-pen-to-square"></i>
                                Share Your Experience
                            </a>
                            <% } %>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonials Grid Section -->
        <section class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Loading State -->
                <div id="testimonials-loading" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% for(let i=0; i < 6; i++) { %>
                        <div class="animate-pulse bg-slate-100 rounded-2xl p-6">
                            <div class="h-4 bg-slate-200 rounded w-3/4 mb-4"></div>
                            <div class="h-4 bg-slate-200 rounded w-1/2 mb-4"></div>
                            <div class="h-20 bg-slate-200 rounded mb-4"></div>
                            <div class="h-10 bg-slate-200 rounded-full w-1/3"></div>
                        </div>
                        <% } %>
                </div>

                <!-- Testimonials Grid (Populated by JavaScript) -->
                <div id="all-testimonials-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 hidden">
                    <!-- all-testimonials.js populates testimonial cards here -->
                </div>

                <!-- Empty State (No testimonials) -->
                <div id="empty-state" class="hidden">
                    <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                        <div class="text-5xl mb-4 text-slate-300">
                            <i class="fa-regular fa-comments"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-2">No testimonials yet</h3>
                        <p class="text-slate-500 mb-6">
                            We're just getting started! Be among the first users to share your success story and
                            inspire others.
                        </p>
                        <% if (locals.user) { %>
                            <a href="/dashboard"
                                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-blue-600 text-white font-semibold shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:-translate-y-0.5 transition-all">
                                <i class="fa-solid fa-pen-to-square"></i>
                                Share Experience
                            </a>
                            <% } else { %>
                                <a href="/login"
                                    class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-blue-600 text-white font-semibold shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:-translate-y-0.5 transition-all">
                                    <i class="fa-solid fa-user"></i>
                                    Login to Share
                                </a>
                                <% } %>
                    </div>
                </div>

                <!-- Error State -->
                <div id="error-state" class="hidden">
                    <div class="bg-red-50 rounded-2xl border border-red-200 p-8 text-center">
                        <i class="fa-solid fa-exclamation-triangle text-4xl text-red-500 mb-4"></i>
                        <p class="text-red-600 font-semibold mb-4">
                            Failed to load testimonials. Please try again.
                        </p>
                        <button onclick="location.reload()"
                            class="px-6 py-3 bg-blue-600 text-white rounded-full font-semibold hover:bg-blue-700">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Retry
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-20 bg-slate-50">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h2 class="text-3xl font-bold text-slate-800 mb-4">Ready to Start Your Trading Journey?</h2>
                <p class="text-lg text-slate-600 mb-8">Join thousands of successful traders and transform your financial
                    future.</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/courses"
                        class="px-8 py-4 rounded-full bg-blue-600 text-white font-semibold text-center shadow-lg shadow-blue-500/25 hover:bg-blue-700 hover:shadow-blue-500/40 transition-all transform hover:-translate-y-1">
                        Explore Courses
                    </a>
                    <% if (locals.user) { %>
                        <a href="/dashboard"
                            class="px-8 py-4 rounded-full bg-white text-slate-700 font-semibold text-center border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all">
                            Share Experience
                        </a>
                        <% } else { %>
                            <a href="/login"
                                class="px-8 py-4 rounded-full bg-white text-slate-700 font-semibold text-center border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-all">
                                Login/Signup
                            </a>
                            <% } %>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>

            <script src="/javascripts/main.js" defer></script>
            <script src="/javascripts/all-testimonials.js" defer></script>
</body>

</html>