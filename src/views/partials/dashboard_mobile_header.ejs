<!-- Mobile Header Component -->
<header class="lg:hidden h-16 bg-brand-navy border-b border-white/10 flex items-center px-4 sticky top-0 z-40">
    <button id="sidebar-toggle-mobile" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all shadow-lg active:scale-95" aria-label="Open sidebar">
        <i class="fa-solid fa-bars-staggered text-lg"></i>
    </button>
    <div class="ml-4 flex items-center gap-2">
        <a href="/" class="flex items-center gap-2">
            <img src="/images/logo.webp" alt="Logo" class="h-8 w-auto rounded-md">
            <span class="text-white font-bold text-sm tracking-tight uppercase truncate max-w-[180px]">
                <%= typeof mobileTitle !== 'undefined' ? mobileTitle : 'The Saran Trader' %>
            </span>
        </a>
    </div>

    <!-- Mobile Header Actions -->
    <div class="ml-auto flex items-center gap-3">
        <a href="/dashboard" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-gold hover:bg-brand-gold hover:text-black transition-all shadow-lg active:scale-95" title="Dashboard">
            <i class="fa-solid fa-gauge-high text-sm"></i>
        </a>
    </div>
</header>

<%# Removed inline script - handled by main.js %>
