<!-- ========================================================================== -->
<!--                        DASHBOARD SIDEBAR PARTIAL                           -->
<!-- ========================================================================== -->
<!--
    Purpose: Left-side navigation for Admin and User dashboards
-->

<aside id="dashboard-sidebar" 
    class="fixed inset-y-0 left-0 z-50 w-80 bg-slate-900 border-r border-white/10 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none">
    
    <div class="h-full flex flex-col bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
        <!-- Logo Section -->
        <div class="h-24 flex items-center px-6 mb-2">
            <a href="/" class="flex items-center gap-3 group">
                <div class="p-2.5 rounded-xl bg-brand-gold/10 border border-brand-gold/20 group-hover:border-brand-gold/40 transition-all duration-500">
                    <img src="/images/logo.webp" alt="Logo" class="h-11 w-auto rounded-lg shadow-lg">
                </div>
                <div class="flex flex-col">
                    <span class="text-white font-bold text-lg tracking-tight leading-none italic group-hover:text-brand-gold transition-colors">The Saran Trader</span>
                    <span class="text-brand-gold text-[10px] font-bold tracking-[0.25em] uppercase mt-1 opacity-80">Premium Academy</span>
                </div>
            </a>
            <!-- Mobile Close Button -->
            <button id="close-sidebar-btn" class="lg:hidden ml-auto p-2.5 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-all hover:bg-white/10">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <!-- User Profile Card -->
        <div class="px-4 mb-5">
            <a href="/dashboard" class="relative group block">
                <div class="absolute inset-0 bg-brand-gold/5 blur-2xl rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                
                <div class="relative bg-white/5 backdrop-blur-2xl border border-white/10 rounded-3xl p-3.5 shadow-2xl overflow-hidden active:scale-95 transition-all">
                    <div class="absolute -top-10 -right-10 w-24 h-24 bg-brand-gold/10 blur-2xl rounded-full"></div>
                    
                    <div class="flex items-center gap-3 relative z-10">
                        <div class="relative flex-shrink-0">
                            <div class="absolute -inset-1 bg-gradient-to-tr from-brand-gold to-brand-red rounded-xl blur-sm opacity-30 group-hover:opacity-60 transition-opacity"></div>
                            <div class="relative w-12 h-12 rounded-xl bg-slate-800 border-2 border-slate-700 flex items-center justify-center text-brand-gold font-black text-xl shadow-inner overflow-hidden uppercase">
                                <%= (typeof user !== 'undefined' && user?.name) ? user.name.charAt(0) : 'U' %>
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-green-500 border-4 border-slate-900 shadow-xl"></div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-white font-bold truncate text-[15px] tracking-tight uppercase leading-none">
                                <%= (typeof user !== 'undefined' && user?.name) ? user.name : 'User' %>
                            </p>
                            <p class="text-brand-gold/70 text-[10px] font-bold tracking-[0.1em] uppercase mt-2 flex items-center gap-1.5 leading-none">
                                <span class="flex-1">Community</span>
                                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
                                <%= (typeof user !== 'undefined' && user?.role) ? (user.role === 'ADMIN' ? 'Strategic Admin' : 'Active Trader') : 'STUDENT' %>
                            </p>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 space-y-1.5 overflow-y-auto custom-scrollbar pt-4">
            <% 
                const normalizePath = (p) => p === '/' ? p : p.replace(/\/$/, '');
                const currentPath = normalizePath(typeof path !== 'undefined' ? path : '');
                const isAdmin = typeof user !== 'undefined' && user?.role?.toUpperCase() === 'ADMIN';
                
                const getIsActive = (itemPath) => {
                    const normalizedItemPath = normalizePath(itemPath);
                    const baseCurrentPath = currentPath.split('?')[0];
                    if (normalizedItemPath === '/dashboard' && baseCurrentPath === '/admin/dashboard') return true;
                    if (normalizedItemPath === '/admin/management' && baseCurrentPath === '/admin/management') return true;
                    return baseCurrentPath === normalizedItemPath || 
                           (normalizedItemPath !== '/' && normalizedItemPath !== '/dashboard' && normalizedItemPath !== '/admin/management' && baseCurrentPath.startsWith(normalizedItemPath + '/'));
                };

                const navItemClass = (itemPath) => {
                    const isActive = getIsActive(itemPath);
                    return `flex items-center gap-4 px-5 py-3.5 rounded-2xl transition-all duration-500 group relative ${
                        isActive 
                        ? 'bg-brand-gold/10 text-brand-gold' 
                        : 'text-slate-400 hover:bg-white/5 hover:text-white'
                    }`;
                };

                const iconWrapperClass = (itemPath) => {
                    const isActive = getIsActive(itemPath);
                    return `w-10 h-10 rounded-xl flex items-center justify-center transition-all duration-500 ${
                        isActive 
                        ? 'bg-brand-gold text-slate-900 shadow-lg shadow-brand-gold/20 scale-110' 
                        : 'bg-white/5 text-slate-400 group-hover:bg-white/10 group-hover:text-white group-hover:scale-105'
                    }`;
                };

                const activeIndicator = (itemPath) => {
                    const isActive = getIsActive(itemPath);
                    if (!isActive) return '';
                    return `<div class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-brand-gold rounded-r-full shadow-[0_0_15px_rgba(191,155,48,0.5)]"></div>`;
                };
            %>

            <% if (isAdmin) { %>
                <!-- Dashboard -->
                <a href="/dashboard" class="<%= navItemClass('/admin/dashboard') %>">
                    <%- activeIndicator('/admin/dashboard') %>
                    <div class="<%= iconWrapperClass('/admin/dashboard') %>">
                        <i class="fa-solid fa-table-cells-large text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Dashboard</span>
                </a>
  
                <!-- Control Center -->
                <a href="/admin/management" class="<%= navItemClass('/admin/management') %>">
                    <%- activeIndicator('/admin/management') %>
                    <div class="<%= iconWrapperClass('/admin/management') %>">
                        <i class="fa-solid fa-screwdriver-wrench text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Control Center</span>
                </a>

                <!-- Courses Dropdown (Admin) -->
                <div class="relative admin-dropdown-container" 
                     onmouseenter="handleAdminCoursesHover(true)" 
                     onmouseleave="handleAdminCoursesHover(false)">
                    <button type="button" 
                        onclick="toggleAdminCoursesDropdown()"
                        class="<%= navItemClass('/courses') %> w-full text-left justify-start">
                        <%- activeIndicator('/courses') %>
                        <div class="<%= iconWrapperClass('/courses') %>">
                            <i class="fa-solid fa-book-open text-lg"></i>
                        </div>
                        <div class="flex-1 flex items-center justify-between">
                            <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Courses</span>
                            <i id="admin-courses-chevron" class="fa-solid fa-chevron-down text-[10px] opacity-30 transition-transform duration-300 <%= currentPath.includes('/courses') ? 'rotate-180' : '' %>"></i>
                        </div>
                    </button>
                    
                    <div id="admin-courses-dropdown" 
                        class="admin-dropdown-menu <%= currentPath.includes('/courses') ? 'active' : '' %> mt-1 ml-14 space-y-1 transition-all duration-500 ease-in-out">
                        <div class="mr-4 mb-2 bg-white/5 backdrop-blur-md border border-white/5 rounded-2xl p-2 shadow-inner">
                             <a href="/admin/courses" class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold text-slate-400 hover:text-brand-gold transition-all group/item uppercase tracking-[0.2em] leading-none">
                                 <i class="fa-solid fa-pen-to-square text-[10px]"></i>
                                 Manage Courses
                             </a>
                             <a href="/courses" class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold text-slate-400 hover:text-brand-gold transition-all group/item uppercase tracking-[0.2em] leading-none mt-1">
                                 <i class="fa-solid fa-eye text-[10px]"></i>
                                 Courses Page
                             </a>
                        </div>
                    </div>
                </div>

                <a href="/my-courses" class="<%= navItemClass('/my-courses') %>">
                    <%- activeIndicator('/my-courses') %>
                    <div class="<%= iconWrapperClass('/my-courses') %>">
                        <i class="fa-solid fa-file-lines text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Content</span>
                </a>

                <a href="/community" class="<%= navItemClass('/community') %>">
                    <%- activeIndicator('/community') %>
                    <div class="<%= iconWrapperClass('/community') %>">
                        <i class="fa-solid fa-user-group text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Community</span>
                </a>

                <a href="/chat" class="<%= navItemClass('/chat') %>">
                    <%- activeIndicator('/chat') %>
                    <div class="<%= iconWrapperClass('/chat') %>">
                        <i class="fa-solid fa-comments text-lg"></i>
                    </div>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Chats</span>
                        <% if (currentPath.startsWith('/chat')) { %>
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        <% } %>
                    </div>
                </a>

                <a href="/admin/analytics" class="<%= navItemClass('/admin/analytics') %>">
                    <%- activeIndicator('/admin/analytics') %>
                    <div class="<%= iconWrapperClass('/admin/analytics') %>">
                        <i class="fa-solid fa-chart-simple text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Analytics</span>
                </a>

                <a href="#" class="<%= navItemClass('/integrations') %>">
                    <%- activeIndicator('/integrations') %>
                    <div class="<%= iconWrapperClass('/integrations') %>">
                        <i class="fa-solid fa-arrows-rotate text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight uppercase">Integrations</span>
                </a>

                <a href="#" class="<%= navItemClass('/campaigns') %>">
                    <%- activeIndicator('/campaigns') %>
                    <div class="<%= iconWrapperClass('/campaigns') %>">
                        <i class="fa-solid fa-bullhorn text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight uppercase">Campaigns</span>
                </a>

                <div class="h-px bg-white/5 mx-5 my-4"></div>

                <a href="/admin/users" class="<%= navItemClass('/admin/users') %>">
                    <%- activeIndicator('/admin/users') %>
                    <div class="<%= iconWrapperClass('/admin/users') %>">
                        <i class="fa-solid fa-users text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Peoples</span>
                </a>

                <a href="/admin/testimonials" class="<%= navItemClass('/admin/testimonials') %>">
                    <%- activeIndicator('/admin/testimonials') %>
                    <div class="<%= iconWrapperClass('/admin/testimonials') %>">
                        <i class="fa-solid fa-star-half-stroke text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Testimonials</span>
                </a>

            <% } else { %>
                <!-- Dashboard (User) -->
                <a href="/dashboard" class="<%= navItemClass('/dashboard') %>">
                    <%- activeIndicator('/dashboard') %>
                    <div class="<%= iconWrapperClass('/dashboard') %>">
                        <i class="fa-solid fa-gauge-high text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Dashboard</span>
                </a>

                <!-- All Courses (Dropdown) -->
                <div class="relative user-dropdown-container"
                     onmouseenter="handleUserCoursesHover(true)"
                     onmouseleave="handleUserCoursesHover(false)">
                    <button type="button" 
                        onclick="toggleTradeSafarDropdown()"
                        class="<%= navItemClass('/courses') %> w-full text-left justify-start">
                        <%- activeIndicator('/courses') %>
                        <div class="<%= iconWrapperClass('/courses') %>">
                            <i class="fa-solid fa-book-open-reader text-lg"></i>
                        </div>
                        <div class="flex-1 flex items-center justify-between">
                            <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">All Courses</span>
                            <i id="trade-safar-chevron" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-300 opacity-40 <%= currentPath.startsWith('/courses') ? 'rotate-180' : '' %>"></i>
                        </div>
                    </button>

                    <div id="trade-safar-dropdown" 
                        class="admin-dropdown-menu <%= currentPath.startsWith('/courses') ? 'active' : '' %> mt-1 ml-14 space-y-1 transition-all duration-500 ease-in-out">
                        <div class="mr-4 mb-2 bg-white/5 backdrop-blur-md border border-white/5 rounded-2xl p-2 shadow-inner">
                            <a href="/courses?filter=Learn Step 1" 
                                class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold transition-all uppercase tracking-[0.15em] leading-none <%= currentPath.includes('Learn Step 1') ? 'text-brand-gold' : 'text-slate-400 hover:text-brand-gold' %>">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-400 flex-shrink-0"></span>
                                Learn Step 1
                            </a>
                            <a href="/courses?filter=Nifty Zoom Live Session" 
                                class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold transition-all uppercase tracking-[0.15em] leading-none mt-1 <%= currentPath.includes('Nifty Zoom Live Session') ? 'text-brand-gold' : 'text-slate-400 hover:text-brand-gold' %>">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                                Nifty Zoom Live
                            </a>
                            <a href="/courses?filter=Nifty%2BZoom%2BCommodity" 
                                class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold transition-all uppercase tracking-[0.15em] leading-none mt-1 <%= currentPath.includes('Nifty+Zoom+Commodity') || currentPath.includes('Nifty%2BZoom%2BCommodity') ? 'text-brand-gold' : 'text-slate-400 hover:text-brand-gold' %>">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 flex-shrink-0"></span>
                                Nifty+Zoom+Commodity
                            </a>
                            <a href="/courses" 
                                class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold transition-all uppercase tracking-[0.15em] leading-none mt-1 <%= currentPath === '/courses' && !currentPath.includes('filter') ? 'text-brand-gold' : 'text-slate-400 hover:text-brand-gold' %>">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 flex-shrink-0"></span>
                                All Courses
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Content (My Courses) -->
                <a href="/my-courses" class="<%= navItemClass('/my-courses') %>">
                    <%- activeIndicator('/my-courses') %>
                    <div class="<%= iconWrapperClass('/my-courses') %>">
                        <i class="fa-solid fa-file-lines text-lg"></i>
                    </div>
                    <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Content</span>
                </a>

                <!-- Community (Read Only) -->
                <a href="/community" class="<%= navItemClass('/community') %>">
                    <%- activeIndicator('/community') %>
                    <div class="<%= iconWrapperClass('/community') %>">
                        <i class="fa-solid fa-users text-lg"></i>
                    </div>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Community</span>
                        <span class="text-[8px] font-black uppercase tracking-widest text-slate-500 bg-white/5 border border-white/10 px-1.5 py-0.5 rounded-md">Read</span>
                    </div>
                </a>

                <!-- Chatrooms -->
                <a href="/chat" class="<%= navItemClass('/chat') %>">
                    <%- activeIndicator('/chat') %>
                    <div class="<%= iconWrapperClass('/chat') %>">
                        <i class="fa-solid fa-comments text-lg"></i>
                    </div>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Chatrooms</span>
                        <% if (currentPath.startsWith('/chat')) { %>
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        <% } %>
                    </div>
                </a>

                <!-- Testimonials -->
                <a href="/dashboard/testimonials" class="<%= navItemClass('/dashboard/testimonials') %>">
                    <%- activeIndicator('/dashboard/testimonials') %>
                    <div class="<%= iconWrapperClass('/dashboard/testimonials') %>">
                        <i class="fa-solid fa-star text-lg"></i>
                    </div>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight group-hover:translate-x-1 transition-transform uppercase">Testimonials</span>
                        <span class="text-[8px] font-black uppercase tracking-widest text-brand-gold bg-brand-gold/10 border border-brand-gold/20 px-1.5 py-0.5 rounded-md">New</span>
                    </div>
                </a>

            <% } %>

        </nav>

        <!-- Sidebar Footer -->
        <div class="p-6 border-t border-white/5 mt-auto bg-black/20">
            <form id="logout-sidebar-form" action="/logout" method="POST" class="hidden">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            </form>
            <button type="submit" onclick="event.preventDefault(); document.getElementById('logout-sidebar-form').submit();" 
                class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-2xl text-brand-red bg-brand-red/5 border border-brand-red/10 hover:bg-brand-red hover:text-white transition-all duration-300 group active:scale-95">
                <i class="fa-solid fa-power-off text-sm"></i>
                <span class="font-bold text-xs uppercase tracking-widest">Logout</span>
            </button>
            <div class="mt-4 text-center">
                <span class="text-[9px] font-black text-slate-600 uppercase tracking-[0.3em] opacity-40">System Version v<%= version %></span>
            </div>
        </div>
    </div>
</aside>

<!-- Sidebar Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-md lg:hidden opacity-0 pointer-events-none transition-all duration-300"></div>

<script>
    function toggleTradeSafarDropdown() {
        const dropdown = document.getElementById('trade-safar-dropdown');
        const chevron = document.getElementById('trade-safar-chevron');
        if (dropdown && chevron) {
            const isExpanding = !dropdown.classList.contains('active');
            dropdown.classList.toggle('active');
            if (isExpanding) {
                chevron.classList.add('rotate-180');
            } else {
                chevron.classList.remove('rotate-180');
            }
        }
    }

    function handleUserCoursesHover(isHovering) {
        const dropdown = document.getElementById('trade-safar-dropdown');
        const chevron = document.getElementById('trade-safar-chevron');
        const isActivePage = window.location.pathname.startsWith('/courses');

        if (dropdown && chevron && !isActivePage) {
            if (isHovering) {
                dropdown.classList.add('active');
                chevron.classList.add('rotate-180');
            } else {
                dropdown.classList.remove('active');
                chevron.classList.remove('rotate-180');
            }
        }
    }

    function toggleAdminCoursesDropdown() {
        const dropdown = document.getElementById('admin-courses-dropdown');
        const chevron = document.getElementById('admin-courses-chevron');
        if (dropdown && chevron) {
            const isExpanding = !dropdown.classList.contains('active');
            dropdown.classList.toggle('active');
            if (isExpanding) {
                chevron.classList.add('rotate-180');
            } else {
                chevron.classList.remove('rotate-180');
            }
        }
    }

    function handleAdminCoursesHover(isHovering) {
        const dropdown = document.getElementById('admin-courses-dropdown');
        const chevron = document.getElementById('admin-courses-chevron');
        const isActivePage = window.location.pathname.includes('/courses');

        if (dropdown && chevron && !isActivePage) {
            if (isHovering) {
                dropdown.classList.add('active');
                chevron.classList.add('rotate-180');
            } else {
                if (!dropdown.dataset.clicked) {
                    dropdown.classList.remove('active');
                    chevron.classList.remove('rotate-180');
                }
            }
        }
    }
</script>

<style>
    /* Mobile Sidebar Toggle Support */
    #dashboard-sidebar.active { transform: translateX(0) !important; }
    #sidebar-overlay.active { opacity: 1 !important; pointer-events: auto !important; }
    
    /* Dropdown Transitions */
    .admin-dropdown-menu {
        max-height: 0;
        opacity: 0;
        visibility: hidden;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .admin-dropdown-menu.active {
        max-height: 400px !important;
        opacity: 1 !important;
        visibility: visible !important;
        margin-top: 0.5rem !important;
    }
</style>
