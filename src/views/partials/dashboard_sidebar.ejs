<!-- ========================================================================== -->
<!--                        DASHBOARD SIDEBAR PARTIAL                           -->
<!-- ========================================================================== -->
<!--
    Purpose: Left-side navigation for Admin and User dashboards
    
    Features:
    - Responsive: Hidden on mobile (toggled via hamburger), fixed on desktop
    - Role-based: Shows different links for ADMIN vs USER
    - Active State: Highlights current page (implemented via client-side or server-side logic)
-->

<aside id="dashboard-sidebar" 
    class="fixed inset-y-0 left-0 z-50 w-80 bg-slate-900 border-r border-white/10 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none">
    
    <div class="h-full flex flex-col bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
        <!-- Logo Section -->
        <div class="h-24 flex items-center px-6 mb-2">
            <a href="/" class="flex items-center gap-3 group">
                <div class="p-2.5 rounded-xl bg-brand-gold/10 border border-brand-gold/20 group-hover:border-brand-gold/40 transition-all duration-500">
                    <img src="/images/logo.webp" alt="Logo" class="h-11 w-auto rounded-lg shadow-lg">
                </div>
                <div class="flex flex-col">
                    <span class="text-white font-bold text-lg tracking-tight leading-none italic group-hover:text-brand-gold transition-colors">The Saran Trader</span>
                    <span class="text-brand-gold text-[10px] font-bold tracking-[0.25em] uppercase mt-1 opacity-80">Premium Academy</span>
                </div>
            </a>
            <!-- Mobile Close Button -->
            <button id="close-sidebar-btn" class="lg:hidden ml-auto p-2.5 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-all hover:bg-white/10">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <!-- User Profile Card (Premium Glassmorphism) -->
        <div class="px-4 mb-5">
            <a href="/dashboard" class="relative group block">
                <!-- Subtle glow effect -->
                <div class="absolute inset-0 bg-brand-gold/5 blur-2xl rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                
                <div class="relative bg-white/5 backdrop-blur-2xl border border-white/10 rounded-3xl p-3.5 shadow-2xl overflow-hidden active:scale-95 transition-all">
                    <!-- Dynamic corner light -->
                    <div class="absolute -top-10 -right-10 w-24 h-24 bg-brand-gold/10 blur-2xl rounded-full"></div>
                    
                    <div class="flex items-center gap-3 relative z-10">
                        <div class="relative flex-shrink-0">
                            <!-- Multi-layered avatar glow -->
                            <div class="absolute -inset-1 bg-gradient-to-tr from-brand-gold to-brand-red rounded-xl blur-sm opacity-30 group-hover:opacity-60 transition-opacity"></div>
                            <div class="relative w-12 h-12 rounded-xl bg-slate-800 border-2 border-slate-700 flex items-center justify-center text-brand-gold font-black text-xl shadow-inner overflow-hidden uppercase">
                                <%= (typeof user !== 'undefined' && user?.name) ? user.name.charAt(0) : 'U' %>
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-green-500 border-4 border-slate-900 shadow-xl"></div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-white font-bold truncate text-[15px] tracking-tight uppercase leading-none" title="<%= (typeof user !== 'undefined' && user?.name) ? user.name : 'User' %>">
                                <%= (typeof user !== 'undefined' && user?.name) ? user.name : 'User' %>
                            </p>
                            <p class="text-brand-gold/70 text-[10px] font-bold tracking-[0.1em] uppercase mt-2 flex items-center gap-1.5 leading-none">
                                <span class="flex-1">Community</span>
                                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
                                <%= (typeof user !== 'undefined' && user?.role) ? (user.role === 'ADMIN' ? 'Strategic Admin' : 'Active Trader') : 'STUDENT' %>
                            </p>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 space-y-1.5 overflow-y-auto custom-scrollbar pt-4">
            <% 
                // Normalize paths by removing trailing slashes for consistent matching
                const normalizePath = (p) => p === '/' ? p : p.replace(/\/$/, '');
                const currentPath = normalizePath(typeof path !== 'undefined' ? path : '');
                const isAdmin = typeof user !== 'undefined' && user?.role?.toUpperCase() === 'ADMIN';
                
                const getIsActive = (itemPath) => {
                    const normalizedItemPath = normalizePath(itemPath);
                    const baseCurrentPath = currentPath.split('?')[0];
                    if (normalizedItemPath === '/dashboard' && baseCurrentPath === '/admin/dashboard') return true;
                    if (normalizedItemPath === '/admin/management' && baseCurrentPath === '/admin/management') return true;
                    return baseCurrentPath === normalizedItemPath || 
                           (normalizedItemPath !== '/' && normalizedItemPath !== '/dashboard' && normalizedItemPath !== '/admin/management' && baseCurrentPath.startsWith(normalizedItemPath + '/'));
                };

                const navItemClass = (itemPath) => {
                    const isActive = getIsActive(itemPath);
                    return `flex items-center gap-4 px-5 py-3 rounded-2xl transition-all duration-300 group ${
                        isActive 
                        ? 'bg-brand-gold/10 text-brand-gold' 
                        : 'text-slate-400 hover:bg-white/5 hover:text-white'
                    }`;
                };

                const iconClass = (itemPath) => {
                    const isActive = getIsActive(itemPath);
                    return `text-lg transition-all duration-300 w-6 flex justify-center ${
                        isActive 
                        ? 'text-brand-gold' 
                        : 'text-slate-500 group-hover:text-white'
                    }`;
                };
            %>

            <% if (isAdmin) { %>
                <!-- Dashboard -->
                <a href="/dashboard" class="<%= navItemClass('/admin/dashboard') %>">
                    <i class="fa-solid fa-table-cells-large <%= iconClass('/admin/dashboard') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Dashboard</span>
                </a>
 
                <!-- Management Hub -->
                <a href="/admin/management" class="<%= navItemClass('/admin/management') %>">
                    <i class="fa-solid fa-screwdriver-wrench <%= iconClass('/admin/management') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Control Center</span>
                </a>

                <!-- Courses with Expanding Hover Menu -->
                <div class="relative group">
                    <div class="<%= navItemClass('/courses') %> cursor-pointer">
                        <i class="fa-solid fa-book-open <%= iconClass('/courses') %>"></i>
                        <div class="flex-1 flex items-center justify-between">
                            <span class="font-bold text-[15px] tracking-tight">Courses</span>
                            <i class="fa-solid fa-chevron-right text-[10px] opacity-30 group-hover:rotate-90 transition-transform duration-300"></i>
                        </div>
                    </div>
                    
                    <!-- Expanding Menu Content (Vertical "Toaster") -->
                    <div class="max-h-0 overflow-hidden group-hover:max-h-40 transition-all duration-500 ease-in-out">
                        <div class="mt-1 ml-6 mr-4 mb-2 bg-white/5 backdrop-blur-md border border-white/5 rounded-2xl p-2 shadow-inner">
                             <a href="/admin/courses" class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold text-slate-400 hover:text-brand-gold transition-all group/item uppercase tracking-[0.2em] leading-none">
                                 <i class="fa-solid fa-pen-to-square text-[10px]"></i>
                                 Manage Courses
                             </a>
                             <a href="/courses" class="flex items-center gap-3 px-4 py-2.5 hover:bg-brand-gold/10 rounded-xl text-[10px] font-bold text-slate-400 hover:text-brand-gold transition-all group/item uppercase tracking-[0.2em] leading-none mt-1">
                                 <i class="fa-solid fa-eye text-[10px]"></i>
                                 Courses Page
                             </a>
                        </div>
                    </div>
                </div>

                <a href="/my-courses" class="<%= navItemClass('/my-courses') %>">
                    <i class="fa-solid fa-file-lines <%= iconClass('/my-courses') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Content</span>
                </a>




                <a href="/community" class="<%= navItemClass('/community') %>">
                    <i class="fa-solid fa-user-group <%= iconClass('/community') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Community</span>
                </a>

                <a href="/chat" class="<%= navItemClass('/chat') %>">
                    <i class="fa-solid fa-comments <%= iconClass('/chat') %>"></i>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight">Chats</span>
                        <% if (currentPath.startsWith('/chat')) { %>
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        <% } %>
                    </div>
                </a>

                <a href="/admin/analytics" class="<%= navItemClass('/admin/analytics') %>">
                    <i class="fa-solid fa-chart-simple <%= iconClass('/admin/analytics') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Analytics</span>
                </a>

                <a href="#" class="<%= navItemClass('/integrations') %>">
                    <i class="fa-solid fa-arrows-rotate <%= iconClass('/integrations') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Integrations</span>
                </a>

                <a href="#" class="<%= navItemClass('/campaigns') %>">
                    <i class="fa-solid fa-bullhorn <%= iconClass('/campaigns') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Campaigns</span>
                </a>

                <div class="h-px bg-white/5 mx-5 my-4"></div>

                <a href="/admin/users" class="<%= navItemClass('/admin/users') %>">
                    <i class="fa-solid fa-users <%= iconClass('/admin/users') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Peoples</span>
                </a>

                <a href="/admin/testimonials" class="<%= navItemClass('/admin/testimonials') %>">
                    <i class="fa-solid fa-star-half-stroke <%= iconClass('/admin/testimonials') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Testimonials</span>
                </a>

            <% } else { %>
                <!-- ================= USER NAVIGATION ================= -->
                <a href="/dashboard" class="<%= navItemClass('/dashboard') %>">
                    <i class="fa-solid fa-gauge-high <%= iconClass('/dashboard') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">My Dashboard</span>
                </a>

                <a href="/my-courses" class="<%= navItemClass('/my-courses') %>">
                    <i class="fa-solid fa-graduation-cap <%= iconClass('/my-courses') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">My Courses</span>
                </a>

                <!-- Trade Safar (Courses) Dropdown - Restored for Users -->
                <div class="relative">
                    <button type="button" 
                        onclick="toggleTradeSafarDropdown()"
                        class="<%= navItemClass('/courses') %> w-full text-left justify-start">
                        <i class="fa-solid fa-book-open-reader <%= iconClass('/courses') %>"></i>
                        <div class="flex-1 flex items-center justify-between">
                            <span class="font-bold text-[15px] tracking-tight">Trade Safar</span>
                            <i id="trade-safar-chevron" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-300 <%= currentPath.startsWith('/courses') ? 'rotate-180' : '' %>"></i>
                        </div>
                    </button>

                    <!-- Dropdown Menu -->
                    <div id="trade-safar-dropdown" 
                        class="<%= currentPath.startsWith('/courses') ? '' : 'hidden' %> mt-2 ml-10 space-y-1 overflow-hidden transition-all duration-300">
                        <a href="/courses?filter=Learn Step 1" 
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all <%= currentPath.includes('Learn Step 1') || (currentPath === '/courses' && typeof path !== 'undefined' && path.includes('filter=Learn%20Step%201')) ? 'text-brand-gold bg-white/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                            Learn Step 1
                        </a>
                        <a href="/courses?filter=Nifty Zoom Live Session" 
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all <%= currentPath.includes('Nifty Zoom Live Session') || (currentPath === '/courses' && typeof path !== 'undefined' && path.includes('filter=Nifty%20Zoom%20Live%20Session')) ? 'text-brand-gold bg-white/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                            Nifty Zoom Live Session
                        </a>
                        <a href="/courses?filter=Nifty%2BZoom%2BCommodity" 
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all <%= currentPath.includes('Nifty%2BZoom%2BCommodity') || currentPath.includes('Nifty+Zoom+Commodity') ? 'text-brand-gold bg-white/5' : 'text-slate-500 hover:text-white hover:bg-white/5' %>">
                            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                            Nifty+Zoom+Commodity
                        </a>
                        <a href="/courses" 
                            class="flex items-center gap-3 px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-600 hover:text-slate-400 transition-all mt-2">
                            View All Courses
                        </a>
                    </div>
                </div>

                <a href="/community" class="<%= navItemClass('/community') %>">
                    <i class="fa-solid fa-users <%= iconClass('/community') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Community</span>
                </a>

                <a href="/chat" class="<%= navItemClass('/chat') %>">
                    <i class="fa-solid fa-comments <%= iconClass('/chat') %>"></i>
                    <div class="flex-1 flex items-center justify-between">
                        <span class="font-bold text-[15px] tracking-tight">Traders Lounge</span>
                        <% if (currentPath.startsWith('/chat')) { %>
                            <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        <% } %>
                    </div>
                </a>

                <a href="/features" class="<%= navItemClass('/features') %>">
                    <i class="fa-solid fa-wand-magic-sparkles <%= iconClass('/features') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Features</span>
                </a>

                <div class="h-px bg-white/5 mx-5 my-8"></div>

                <a href="/about" class="<%= navItemClass('/about') %>">
                    <i class="fa-solid fa-circle-info <%= iconClass('/about') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">About Us</span>
                </a>

                <a href="/our-mission" class="<%= navItemClass('/our-mission') %>">
                    <i class="fa-solid fa-bullseye <%= iconClass('/our-mission') %>"></i>
                    <span class="font-bold text-[15px] tracking-tight">Our Mission</span>
                </a>
            <% } %>

        </nav>

        <!-- Sidebar Footer -->
        <div class="p-6 border-t border-white/5 mt-auto bg-black/20">
            <form id="logout-sidebar-form" action="/logout" method="POST" class="hidden">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            </form>
            <button type="submit" onclick="event.preventDefault(); document.getElementById('logout-sidebar-form').submit();" 
                class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-2xl text-brand-red bg-brand-red/5 border border-brand-red/10 hover:bg-brand-red hover:text-white transition-all duration-300 group active:scale-95">
                <i class="fa-solid fa-power-off text-sm"></i>
                <span class="font-bold text-xs uppercase tracking-widest">Logout</span>
            </button>
            <div class="mt-4 text-center">
                <span class="text-[9px] font-black text-slate-600 uppercase tracking-[0.3em] opacity-40">System Version v<%= version %></span>
            </div>
        </div>
    </div>
</aside>

<!-- Sidebar Overlay (Mobile) -->
<div id="sidebar-overlay" class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-md lg:hidden transition-all duration-300"></div>

<script>
    function toggleTradeSafarDropdown() {
        const dropdown = document.getElementById('trade-safar-dropdown');
        const chevron = document.getElementById('trade-safar-chevron');
        if (dropdown && chevron) {
            dropdown.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }
    }
</script>

<style>
    /* Mobile Sidebar Toggle Support (Synced with main.js) */
    #dashboard-sidebar.active {
        transform: translateX(0) !important;
    }

    #sidebar-overlay.active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    
    #sidebar-overlay {
        opacity: 0;
        pointer-events: none;
    }
    
    #sidebar-overlay.active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
</style>

