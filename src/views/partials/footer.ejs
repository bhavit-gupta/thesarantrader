<!-- ========================================================================== -->
<!--                              FOOTER PARTIAL                                -->
<!-- ========================================================================== -->
<!--
    Purpose: Global footer component included in all pages
    
    Features:
    - Logo and branding display
    - Copyright notice with dynamic year
    - Simple, minimal design
    - Responsive layout (stacks on mobile, horizontal on desktop)
    
    Expected Variables: None (static content)
    
    Design:
    - White background with subtle top border
    - Minimal padding for clean look
    - Flexbox layout for alignment
-->

<footer id="footer" class="bg-brand-navy border-t border-white/5" role="contentinfo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <!-- Grid Layout -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

            <!-- 1️⃣ Brand Section -->
            <div>
                <div class="flex items-center gap-3 text-white">
                    <img src="/images/logo.webp" alt="The Saran Trader Logo" class="h-12 w-auto rounded-lg object-contain">
                </div>

                <p class="mt-4 text-sm text-slate-400 leading-relaxed">
                    Professional trading education, live sessions, and structured learning designed for serious traders.
                </p>

                <p class="mt-4 text-sm text-slate-400">
                    📧
                    <a href="<%= links.contact.supportUrl %>"
                        class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                        <%= links.contact.email %>
                    </a>
                </p>
                <p class="mt-2 text-sm text-slate-400">
                    📞
                    <a href="tel:<%= links.contact.phone %>"
                        class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                        <%= links.contact.phone %>
                    </a>
                </p>

                <!-- Social Links -->
                <div class="mt-6 flex gap-4" aria-label="Social media links">
                    <a href="<%= links.social.twitter %>" target="_blank" rel="noopener noreferrer"
                        class="text-slate-400 hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded transition-colors"
                        aria-label="Follow us on Twitter">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                    </a>
                    <a href="<%= links.social.youtube %>" target="_blank" rel="noopener noreferrer"
                        class="text-slate-400 hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded transition-colors"
                        aria-label="Subscribe on YouTube">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                        </svg>
                    </a>
                    <a href="<%= links.social.instagram %>" target="_blank" rel="noopener noreferrer"
                        class="text-slate-400 hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded transition-colors"
                        aria-label="Follow us on Instagram">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" />
                        </svg>
                    </a>
                    <a href="<%= links.social.telegram %>" target="_blank" rel="noopener noreferrer"
                        class="text-slate-400 hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded transition-colors"
                        aria-label="Join us on Telegram">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- 2️⃣ Platform Links -->
            <nav aria-label="Platform" class="space-y-4">
                <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
                    Platform
                </h3>

                <ul class="space-y-2 text-sm text-slate-400">
                    <li>
                        <a href="<%= links.platform.courses %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Courses
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.community %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Community
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.dashboard %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/chat"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Chat Rooms
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- 3️⃣ Company -->
            <nav aria-label="Company" class="space-y-4">
                <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
                    Company
                </h3>

                <ul class="space-y-2 text-sm text-slate-400">
                    <li>
                        <a href="<%= links.platform.about %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.ourMission %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Our Mission
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.features %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Features
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.testimonials %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Testimonials
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.courses %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Enroll Now
                        </a>
                    </li>
                    <li>
                        <a href="<%= links.platform.login %>"
                            class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                            Login
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- 4️⃣ Quick Links & Newsletter -->
            <div class="space-y-6">
                <nav aria-label="Quick Links" class="space-y-4">
                    <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
                        Quick Links
                    </h3>

                    <ul class="space-y-2 text-sm text-slate-400">
                        <li>
                            <a href="<%= links.platform.signup %>"
                                class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                                Sign Up
                            </a>
                        </li>
                        <li>
                            <a href="<%= links.platform.privacyPolicy %>"
                                class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                                Privacy Policy
                            </a>
                        </li>
                        <li>
                            <a href="<%= links.platform.termsConditions %>"
                                class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                                Terms & Conditions
                            </a>
                        </li>
                        <li>
                            <a href="<%= links.platform.refundPolicy %>"
                                class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                                Refund Policy
                            </a>
                        </li>

                        <li>
                            <a href="<%= links.contact.supportUrl %>"
                                class="hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold rounded">
                                Contact Support
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

        </div>

        <!-- Divider -->
        <div class="mt-12 border-t border-white/10 pt-6 text-center text-sm text-slate-500">

            <p>
                © <%= new Date().getFullYear() %> The Saran Trader Inc. All rights reserved.
            </p>

            <p class="mt-2">
                Built for serious traders. Designed for performance.
            </p>
            <!-- Back to Top Button: Floating fixed position -->
            <a href="#top" id="back-to-top"
                class="fixed bottom-8 right-8 w-12 h-12 rounded-full bg-brand-gold text-brand-navy flex items-center justify-center shadow-2xl hover:bg-brand-accent transition-all transform hover:-translate-y-1 z-50 opacity-0 invisible"
                aria-label="Back to top of page">
                <i class="fa-solid fa-arrow-up"></i>
            </a>
        </div>
    </div>
</footer>