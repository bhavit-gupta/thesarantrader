<!-- ========================================================================== -->
<!--                           NAVIGATION BAR PARTIAL                           -->
<!-- ========================================================================== -->
<!--
    Purpose: Global navigation component included in all pages
    
    Features:
    - Fixed top navigation with blur effect
    - Responsive mobile menu (hamburger)
    - Dynamic authentication state (logged in vs guest)
    - Live session indicator (green when any course is live)
    - Admin panel quick access
    - User avatar with first initial
    - Chat link (only for course owners or admins)
    
    Expected Variables (from viewData middleware):
    - user: Object | null - Current logged-in user
      - user.name: string - Display name
      - user.username: string - Username (admin detection)
      - user.role: 'admin' | 'user' - User role
    - hasPurchasedCourses: boolean - Has user bought any course
    - liveSessions: Object - Map of courseId ΓåÆ {isLive: boolean}
    - csrfToken: string - CSRF token for logout form
    - purchasedCourseIds: string[] - Array of owned course IDs
    - pendingCourseIds: string[] - Array of pending purchase IDs
    
    Layout Behavior:
    - Desktop: Horizontal menu with all links visible
    - Mobile: Hamburger menu with slide-down panel
    - Live button: Dynamically shows green (live) or gray (offline)
    
    JavaScript Integration:
    - auth-init.js: Parses embedded JSON data for client-side auth state
    - Mobile menu toggle via #mobile-menu-btn
    - Live status polling (updates button color dynamically)
-->

<!-- Skip to main content link for keyboard/screen reader users (18.21) -->
<a href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg focus:outline-none">
    Skip to main content
</a>

<!-- Main Navigation Container -->
<nav class="fixed w-full z-50 bg-brand-navy/90 backdrop-blur-md border-b border-white/10 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-20 items-center">
            <% let isAnyCourseLive=false; if (typeof liveSessions !=='undefined' && liveSessions) { const
                safePurchases=typeof purchasedCourseIds !=='undefined' && purchasedCourseIds ?
                (Array.isArray(purchasedCourseIds) ? purchasedCourseIds : Array.from(purchasedCourseIds)) : [];
                isAnyCourseLive=Object.keys(liveSessions).some(courseId=>
                liveSessions[courseId]?.isLive === true && safePurchases.includes(courseId)
                );
                } else if (typeof isLive !== 'undefined') {
                isAnyCourseLive = Boolean(isLive);
                }
                %>
                <!-- Logo -->
                <div class="flex-shrink-0">
                    <a href="<%= links.platform.home %>">
                        <img src="/images/logo.webp" alt="The Saran Trader" class="h-12 w-auto rounded-lg object-contain">
                    </a>
                </div>

                <!-- ========== DESKTOP NAVIGATION MENU ========== -->
                <!-- Visible on lg (1024px) and larger screens -->
                <div class="hidden lg:flex space-x-8 items-center">
                    <a href="<%= links.platform.home %>"
                        class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Home</a>
                    <a href="<%= links.platform.features %>"
                        class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Features</a>
                    <a href="<%= links.platform.courses %>"
                        class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Courses</a>
                    <a href="<%= links.platform.community %>"
                        class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Community</a>

                    <!-- Chat Link - Only shown if user owns courses or is admin -->
                    <% if ((typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) || (typeof user
                        !=='undefined' && user && user.role?.toUpperCase()==='ADMIN' )) { %>
                        <a href="/chat"
                            class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Chat</a>
                        <% } %>

                            <a href="<%= links.platform.testimonials %>"
                                class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">Testimonials</a>
                            <a href="<%= links.platform.about %>"
                                class="text-sm font-medium text-slate-300 hover:text-brand-gold transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2 rounded">About</a>
                        </div>

                <!-- ========== DESKTOP CTA SECTION ========== -->
                <!-- Authentication-aware buttons and indicators -->
                <div class="hidden lg:flex items-center gap-3">
                    <!-- User is logged in -->
                    <% if (typeof user !=='undefined' && user) { %>

                        <!-- Admin User: Show direct admin panel link + Live Status -->
                        <% if (user?.role?.toUpperCase()==='ADMIN' ) { %>
                            <a href="<%= links.platform.adminDashboard %>"
                                class="px-5 py-2.5 rounded-full bg-slate-800 text-white text-sm font-bold hover:bg-slate-900 transition-all flex items-center gap-2">
                                <i class="fa-solid fa-shield-halved"></i> Admin Panel
                            </a>
                            <% } %>

                                <% if (typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) { %>
                                    <!-- 
                                Live Button Logic:
                                - Green + pulsing: At least one course is currently live
                                - Gray + static: No courses currently live
                                - Updated dynamically via JavaScript polling
                            -->
                                    <div id="join-live-btn" class="join-live-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all flex items-center gap-2 cursor-pointer
                                 <%= isAnyCourseLive 
                                     ? 'bg-green-500 text-white shadow-lg shadow-green-500/25' 
                                     : 'bg-slate-100 text-slate-400' %>">

                                        <span
                                            class="live-dot w-2 h-2 rounded-full <%= isAnyCourseLive ? 'bg-white live-pulse' : 'bg-slate-400' %>"></span>
                                        <span class="live-text">
                                            <%= isAnyCourseLive ? 'Live Now' : 'Live Offline' %>
                                        </span>
                                    </div>
                                    <% } else { %>
                                        <a href="<%= links.platform.courses %>"
                                            class="px-6 py-2.5 rounded-full bg-brand-gold text-brand-navy text-sm font-semibold transition-all hover:bg-brand-accent hover:shadow-lg shadow-brand-gold/25 transform hover:-translate-y-0.5">
                                            Enroll Now
                                        </a>
                                        <% } %>

                                            <!-- User Avatar: Shows first letter of name, links to dashboard -->
                                            <a href="<%= (user?.role?.toUpperCase() === 'ADMIN' || user?.role?.toUpperCase() === 'admin') ? links.platform.adminDashboard : links.platform.dashboard %>"
                                                class="w-10 h-10 rounded-full <%= (user?.role?.toUpperCase() === 'ADMIN' || user?.role?.toUpperCase() === 'admin') ? 'bg-slate-800 text-white' : 'bg-brand-gold/20 text-brand-gold' %> font-bold flex items-center justify-center text-sm hover:opacity-80 transition-opacity"
                                                title="Dashboard">
                                                <% const safeName=(typeof user?.name==='string' && user.name.length> 0)
                                                    ? user.name
                                                    : 'U';
                                                    const safeInitial = safeName.charAt(0).toUpperCase();
                                                    %>
                                                    <%= safeInitial %>
                                            </a>

                                            <!-- Logout Button: Submits hidden form below -->
                                            <button type="submit" form="logout-form"
                                                class="text-sm font-medium text-slate-500 hover:text-red-500 transition-colors bg-transparent border-none cursor-pointer flex items-center">
                                                <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i> Logout
                                            </button>

                                            <!-- Guest User: Show Get Started CTA -->
                                            <% } else { %>
                                                <a href="<%= links.platform.login %>"
                                                    class="px-6 py-2.5 rounded-full bg-brand-accent text-brand-navy font-bold shadow-lg shadow-brand-accent/20 hover:bg-brand-gold hover:shadow-brand-gold/30 transition-all transform hover:-translate-y-0.5">
                                                    Get Started
                                                </a>
                                                <% } %>
                </div>

                <!-- ========== MOBILE MENU TOGGLE BUTTON ========== -->
                <div class="lg:hidden flex items-center gap-4">
                    <!-- Mobile CTA Button (Guest Only) -->
                    <% if (typeof user === 'undefined' || !user) { %>
                        <a href="<%= links.platform.login %>" 
                           class="px-4 py-2 rounded-full bg-brand-accent text-brand-navy text-xs font-bold shadow-lg shadow-brand-accent/20">
                           Get Started
                        </a>
                    <% } %>

                    <button id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false"
                        aria-controls="mobile-menu"
                        class="text-slate-300 hover:text-brand-gold focus:outline-none focus:ring-2 focus:ring-brand-gold h-10 w-10 flex items-center justify-center rounded-lg bg-white/5 border border-white/10">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
        </div>
    </div>

    <!-- ========== MOBILE SLIDE-DOWN MENU ========== -->
    <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 top-20 bottom-0 bg-brand-navy/98 backdrop-blur-xl z-[60] overflow-y-auto">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <a href="<%= links.platform.home %>"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Home</a>
            <a href="<%= links.platform.features %>"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Features</a>
            <a href="<%= links.platform.courses %>"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Courses</a>
            <a href="<%= links.platform.community %>"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Community</a>

            <!-- Chat link (conditional: only for course owners or admins) -->
            <% if ((typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) || (typeof user !=='undefined' &&
                user && user.role?.toUpperCase()==='ADMIN' )) { %>
                <a href="/chat"
                    class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Chat</a>
                <% } %>

                    <a href="<%= links.platform.testimonials %>"
                        class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">Testimonials</a>
                    <a href="<%= links.platform.about %>"
                        class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-brand-gold hover:bg-white/5">About</a>

                    <!-- Mobile: User-specific links -->
                    <% if (typeof user !=='undefined' && user) { %>

                        <!-- Mobile Live Session Indicator / Enroll Now Button -->
                        <% if (typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) { %>
                            <div id="mobile-join-live-btn" class="join-live-btn px-3 py-2 rounded-md text-base font-medium transition-colors cursor-pointer flex items-center
                            <%= isAnyCourseLive ? 'text-green-600 bg-green-50' : 'text-slate-400 bg-slate-100' %>">
                                <span class="w-2.5 h-2.5 rounded-full mr-2 <%= isAnyCourseLive ? 'bg-green-600 animate-pulse' : 'bg-slate-400' %>"></span>
                                <%= isAnyCourseLive ? 'Live Now' : 'Live Offline' %>
                            </div>
                            <% } else { %>
                                <a href="<%= links.platform.courses %>"
                                    class="block px-3 py-2 rounded-md text-base font-medium text-brand-gold hover:bg-brand-gold/10">
                                    ⭐ Enroll Now
                                </a>
                                <% } %>

                                    <!-- Dashboard Link -->
                                    <a href="<%= user.role?.toUpperCase() === 'ADMIN' ? links.platform.adminDashboard : links.platform.dashboard %>"
                                        class="block px-3 py-2 rounded-md text-base font-medium text-brand-gold hover:bg-brand-gold/10">📊
                                        <%= user.role?.toUpperCase() === 'ADMIN' ? 'Admin Dashboard'
                                            : 'Dashboard' %>
                                    </a>

                                    <!-- Mobile Logout Button -->
                                    <button type="submit" form="logout-form"
                                        class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-red-500 hover:bg-red-50 bg-transparent border-none cursor-pointer flex items-center">
                                        <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Logout
                                    </button>

                                    <!-- Guest: Get Started Button -->
                                    <% } else { %>
                                        <a href="<%= links.platform.login %>"
                                            class="block px-3 py-2 rounded-md text-base font-medium text-brand-navy bg-brand-gold hover:bg-brand-accent">Get
                                            Started</a>
                                        <% } %>
        </div>
    </div>

    <!-- ========== HIDDEN LOGOUT FORM ========== -->
    <!-- 
        Form Strategy: Hidden form referenced by logout buttons via form="logout-form"
        Allows semantic POST request for logout while keeping buttons outside form
        CSRF token included for security
    -->
    <!-- Logout Form: Unified to top-level /logout -->
    <form id="logout-form" action="/logout" method="POST" style="display: none;">
        <% if (!csrfToken) { throw new Error('CSRF token missing in navbar'); } %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>

    <!-- ========== SERVER-SIDE DATA EMBEDDING ========== -->
    <!-- 
        Strategy: Embed server-rendered data as JSON in HTML for client-side JavaScript
        
        Benefits:
        - No separate API call needed for auth state
        - Immediate access to user data on page load
        - Type-safe parsing with JSON.parse()
        
        Consumed by: /javascripts/auth-init.js
        
        Data Available:
        - user: Current user object (null if guest)
        - purchasedCourseIds: Array of owned course IDs
        - pendingCourseIds: Array of courses awaiting payment approval
    -->


    <% function safeJson(obj) { return JSON.stringify(obj) .replace(/</g, '\\u003c' ) .replace( />/g, '\\u003e')
    .replace(/&/g, '\\u0026');
    }
    %>

    <script id="server-side-auth-user" type="application/json">
        <%- safeJson(locals.user || null) %>
    </script>
    <script id="server-side-purchased-courses" type="application/json">
        <%- safeJson(locals.purchasedCourseIds || []) %>
    </script>
    <script id="server-side-pending-courses" type="application/json">
        <%- safeJson(locals.pendingCourseIds || []) %>
    </script>

    <!-- Client-side auth initialization script -->
    <script src="/javascripts/auth-init.js"></script>

    <!-- FOUC prevention: Set auth state immediately (18.10) -->
    <script>
        (function () {
            try {
                const authScript = document.getElementById('server-side-auth-user');
                if (authScript) {
                    const user = JSON.parse(authScript.textContent);
                    if (user) {
                        document.documentElement.setAttribute('data-authenticated', 'true');
                    }
                }
            } catch (e) {
                console.error('Auth state initialization failed:', e);
            }
        })();
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const desktopBtn = document.getElementById('join-live-btn');
            const mobileBtn = document.getElementById('mobile-join-live-btn');

            async function handleLiveClick() {
                try {
                    const res = await fetch('/api/live-status', {
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    // liveSessions is a map of courseId -> { isLive, startTime }
                    if (data.liveSessions) {
                        const liveCourseIds = Object.keys(data.liveSessions).filter(id => data.liveSessions[id].isLive);
                        if (liveCourseIds.length > 0) {
                            // Navigate to the first available live course
                            window.location.href = `/courses/${liveCourseIds[0]}/view`;
                        } else {
                            window.location.href = '/courses?info=no_live';
                        }
                    }
                } catch (err) {
                    console.error('Live navigation failed', err);
                    window.location.href = '/courses';
                }
            }

            if (desktopBtn) {
                desktopBtn.addEventListener('click', handleLiveClick);
            }

            if (mobileBtn) {
                mobileBtn.addEventListener('click', handleLiveClick);
            }
        });
    </script>
</nav>

