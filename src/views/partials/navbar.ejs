<!-- ---------------- NAVBAR ---------------- -->
<nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-20 items-center">
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center justify-between gap-2 cursor-pointer">
                    <div
                        class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-blue-500/20">
                        T
                    </div>
                    <span class="text-2xl font-bold text-slate-800 tracking-tight">The Saran Trader</span>
                </a>
            </div>
            <!-- ---------------- DESKTOP MENU ---------------- -->
            <div class="hidden md:flex space-x-8 items-center">
                <a href="/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Home</a>
                <a href="/features"
                    class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Features</a>
                <a href="/courses"
                    class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Courses</a>
                <a href="/community"
                    class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Community</a>
                <% if ((typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) || (typeof user !=='undefined'
                    && user && user.role==='admin' )) { %>
                    <a href="/chat"
                        class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Chat</a>
                    <% } %>
                        <a href="/testimonials"
                            class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Testimonials</a>
            </div>
            <!-- ---------------- CTA BUTTON ---------------- -->
            <div class="hidden md:flex items-center gap-3">
                <% if (typeof user !=='undefined' && user) { %>
                    <% if (user.username==='admin' ) { %>
                        <a href="/admin/dashboard"
                            class="px-5 py-2.5 rounded-full bg-slate-800 text-white text-sm font-bold hover:bg-slate-900 transition-all flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved"></i> Admin Panel
                        </a>
                        <% } else { %>
                            <!-- Join Live Button (Active if ANY course is live) -->
                            <% let isAnyCourseLive=false; if (typeof liveSessions !=='undefined' ) {
                                isAnyCourseLive=Object.values(liveSessions).some(s=> s.isLive);
                                } else if (typeof isLive !== 'undefined') {
                                isAnyCourseLive = isLive; // Fallback for old simple boolean if needed
                                }
                                %>

                                <div id="join-live-btn" class="join-live-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all flex items-center gap-2 cursor-default
                                <%= isAnyCourseLive 
                                    ? 'bg-green-500 text-white shadow-lg shadow-green-500/25' 
                                    : 'bg-slate-100 text-slate-400' %>">

                                    <span
                                        class="live-dot w-2 h-2 rounded-full <%= isAnyCourseLive ? 'bg-white live-pulse' : 'bg-slate-400' %>"></span>
                                    <span class="live-text">
                                        <%= isAnyCourseLive ? 'Live Now' : 'Live Offline' %>
                                    </span>
                                </div>
                                <% } %>
                                    <!-- User Avatar + Dropdown -->
                                    <a href="<%= user.username === 'admin' ? '/admin/dashboard' : '/dashboard' %>"
                                        class="w-10 h-10 rounded-full <%= user.username === 'admin' ? 'bg-slate-800 text-white' : 'bg-blue-100 text-blue-600' %> font-bold flex items-center justify-center text-sm hover:opacity-80 transition-opacity"
                                        title="Dashboard">
                                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                                    </a>
                                    <!-- ---------------- LOGOUT BUTTON (DESKTOP) ---------------- -->
                                    <button type="submit" form="logout-form"
                                        class="text-sm font-medium text-slate-500 hover:text-red-500 transition-colors bg-transparent border-none cursor-pointer">
                                        Logout
                                    </button>
                                    <% } else { %>
                                        <a href="/login"
                                            class="px-6 py-2.5 rounded-full bg-blue-600 text-white text-sm font-semibold shadow-lg shadow-blue-500/20 hover:bg-blue-700 hover:shadow-blue-500/30 transition-all transform hover:-translate-y-0.5">
                                            Get Started
                                        </a>
                                        <% } %>
            </div>
            <!-- ---------------- MOBILE MENU BUTTON ---------------- -->
            <div class="md:hidden flex items-center">
                <button id="mobile-menu-btn" class="text-slate-600 hover:text-blue-600 focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- ---------------- MOBILE MENU ---------------- -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <a href="/"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Home</a>
            <a href="/features"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Features</a>
            <a href="/courses"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Courses</a>
            <a href="/community"
                class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Community</a>
            <% if ((typeof hasPurchasedCourses !=='undefined' && hasPurchasedCourses) || (typeof user !=='undefined' &&
                user && user.role==='admin' )) { %>
                <a href="/chat"
                    class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Chat</a>
                <% } %>
                    <a href="/testimonials"
                        class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50">Testimonials</a>
                    <% if (typeof user !=='undefined' && user) { %>
                        <!-- Dynamic Mobile Live Check -->
                        <% let isAnyCourseLiveMobile=false; if (typeof liveSessions !=='undefined' ) {
                            isAnyCourseLiveMobile=Object.values(liveSessions).some(s=> s.isLive);
                            } else if (typeof isLive !== 'undefined') {
                            isAnyCourseLiveMobile = isLive;
                            }
                            %>
                            <div id="mobile-join-live-btn"
                                class="join-live-btn block px-3 py-2 rounded-md text-base font-medium transition-colors cursor-default
                            <%= isAnyCourseLiveMobile ? 'text-green-600 bg-green-50' : 'text-slate-400 bg-slate-100' %>">
                                <span class="<%= isAnyCourseLiveMobile ? 'animate-pulse' : '' %>">🔴</span>
                                <%= isAnyCourseLiveMobile ? 'Live Now' : 'Live Offline' %>
                            </div>
                            <a href="<%= user.role === 'admin' ? '/admin/dashboard' : '/dashboard' %>"
                                class="block px-3 py-2 rounded-md text-base font-medium text-blue-600 hover:bg-blue-50">📊
                                <%= user.role==='admin' ? 'Admin Dashboard' : 'Dashboard' %>
                            </a>
                            <button type="submit" form="logout-form"
                                class="w-full text-left block px-3 py-2 rounded-md text-base font-medium text-red-500 hover:bg-red-50 bg-transparent border-none cursor-pointer">
                                🚪 Logout
                            </button>
                            <% } else { %>
                                <a href="/login"
                                    class="block px-3 py-2 rounded-md text-base font-medium text-white bg-blue-600 hover:bg-blue-700">Get
                                    Started</a>
                                <% } %>
        </div>
    </div>
    </div>

    <!-- ---------------- LOGOUT FORM ---------------- -->
    <form id="logout-form" action="/auth/logout" method="POST" style="display: none;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    </form>

    <!-- AUTH DATA EMBED (JSON-IN-HTML Strategy) -->
    <script id="server-side-auth-user" type="application/json">
        <%- JSON.stringify(locals.user || null) %>
    </script>
    <script id="server-side-purchased-courses" type="application/json">
        <%- JSON.stringify(locals.purchasedCourseIds || []) %>
    </script>
    <script id="server-side-pending-courses" type="application/json">
        <%- JSON.stringify(locals.pendingCourseIds || []) %>
    </script>

    <script src="/javascripts/auth-init.js"></script>
</nav>